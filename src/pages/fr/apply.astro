---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { currentDogs } from "../../data/current-dogs";

const dogNames = currentDogs.map((d) => d.name);

// Build photo data for each dog
const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/current-dogs/**/*.{jpeg,jpg,png}",
  { eager: true }
);

const dogPhotoData = currentDogs.map((dog) => {
  const prefix = `../../assets/current-dogs/${dog.slug}/`;
  const photos = Object.entries(allPhotos)
    .filter(([path]) => path.startsWith(prefix))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
  return { name: dog.name, slug: dog.slug, shortLine: dog.shortLine, photos };
});
---

<Layout title="Demande d'adoption | My Paws Bosnia" description="Remplissez notre formulaire d'adoption. Nous examinons chaque demande et répondons généralement sous quelques jours." lang="fr">
  <section class="bg-light-bg py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Faire une demande d'adoption</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">Choisissez votre chien et parlez-nous un peu de vous. Nous examinons chaque demande et répondons généralement sous quelques jours.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <form id="adopt-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="82e1cf41-2872-4b2a-92e3-8d373b609503" />
      <input type="hidden" name="subject" value="New Adoption Application - My Paws Bosnia" />
      <input type="hidden" name="from_name" value="My Paws Bosnia Adoption Form" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
      <input type="hidden" id="whatsapp_link" name="WhatsApp Link (click to chat)" value="" />

      <!-- STEP 1: Choose your dog -->
      <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100 mb-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">Quel chien vous interesse ?</h2>
        </div>

        <!-- Dog selection grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3" id="dog-selector">
          {dogPhotoData.map((dog) => (
            <button
              type="button"
              class="dog-select-btn group relative rounded-xl overflow-hidden border-2 border-gray-100 hover:border-teal transition-all text-left"
              data-dog={dog.name}
              data-slug={dog.slug}
            >
              {dog.photos[0] && (
                <Image
                  src={dog.photos[0]}
                  alt={dog.name}
                  width={300}
                  class="w-full aspect-square object-cover object-top"
                />
              )}
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-3">
                <span class="text-white font-semibold text-sm">{dog.name}</span>
              </div>
            </button>
          ))}
          <button
            type="button"
            class="dog-select-btn flex items-center justify-center rounded-xl border-2 border-gray-100 hover:border-teal transition-all aspect-square bg-light-bg"
            data-dog="Not sure yet"
            data-slug=""
          >
            <div class="text-center p-3">
              <div class="text-3xl mb-2">🐾</div>
              <span class="text-sm text-body font-medium">Pas encore certain</span>
            </div>
          </button>
        </div>

        <!-- Collapsed state (shown after selection) -->
        <div id="dog-selected-bar" class="hidden flex items-center justify-between bg-light-bg rounded-xl p-4">
          <div class="flex items-center gap-3">
            <img id="selected-dog-thumb" src="" alt="" class="w-12 h-12 rounded-full object-cover" />
            <div>
              <p class="font-semibold text-slate-dark" id="selected-dog-name-text"></p>
              <p class="text-xs text-body">Choisi pour l'adoption</p>
            </div>
          </div>
          <button type="button" id="change-dog-bar-btn" class="text-sm text-teal font-medium hover:underline">Modifier</button>
        </div>

        <input type="hidden" id="dog_interest" name="dog_interest" value="" required />
        <p id="dog-select-error" class="text-red-500 text-sm mt-2 hidden">Veuillez choisir un chien pour continuer.</p>
      </div>

      <!-- Photo data for JS -->
      {dogPhotoData.map((dog) => (
        <template data-dog-photos={dog.name}>
          {dog.photos.map((photo, i) => (
            <img src={photo.src} data-width={photo.width} data-height={photo.height} alt={`${dog.name} photo ${i + 1}`} />
          ))}
        </template>
      ))}
      <script id="dog-info" type="application/json" set:html={JSON.stringify(
        dogPhotoData.map(d => ({ name: d.name, slug: d.slug, shortLine: d.shortLine, photoCount: d.photos.length }))
      )} />

      <!-- TWO-COLUMN LAYOUT: Dog on left, form on right (hidden until dog selected) -->
      <div id="form-fields" class="hidden">
        <div class="flex flex-col lg:flex-row gap-8">

          <!-- LEFT: Dog showcase (sticky on desktop) -->
          <div id="dog-showcase" class="lg:w-5/12">
            <div class="lg:sticky lg:top-24">
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <!-- Photo carousel -->
                <div class="relative">
                  <div class="aspect-square relative overflow-hidden" id="showcase-carousel">
                    <div class="flex h-full transition-transform duration-300 ease-in-out" id="showcase-track">
                      <!-- Photos injected by JS -->
                    </div>
                    <button type="button" id="showcase-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8249;</button>
                    <button type="button" id="showcase-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8250;</button>
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="showcase-dots"></div>
                  </div>
                </div>
                <!-- Dog info -->
                <div class="p-5">
                  <h3 id="showcase-name" class="text-2xl font-bold text-slate-dark"></h3>
                  <p id="showcase-line" class="text-body mt-2 text-sm"></p>
                  <div class="mt-3 flex items-center gap-4">
                    <a id="showcase-profile-link" href="#" class="text-teal font-medium hover:underline text-sm">Voir le profil complet &rarr;</a>
                    <button type="button" id="change-dog-btn" class="text-sm text-body hover:text-teal transition-colors underline">Changer de chien</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT: Form fields -->
          <div class="lg:w-7/12 space-y-8">

        <!-- About You -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">A propos de vous</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-body mb-2">Nom complet *</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-body mb-2">Adresse e-mail *</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-body mb-2">Numero de telephone (avec indicatif pays) *</label>
              <input type="tel" id="phone" name="phone" required placeholder="+33 6 12 34 56 78" pattern="[\+\d\s\-\(\)]{7,20}" inputmode="tel" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="country" class="block text-sm font-medium text-body mb-2">Pays *</label>
                <select id="country" name="country" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                  <option value="">Choisir...</option>
                  <option value="United Kingdom">Royaume-Uni</option>
                  <option value="Germany">Allemagne</option>
                  <option value="Switzerland">Suisse</option>
                  <option value="Netherlands">Pays-Bas</option>
                  <option value="Belgium">Belgique</option>
                  <option value="France">France</option>
                  <option value="Austria">Autriche</option>
                  <option value="Ireland">Irlande</option>
                  <option value="Denmark">Danemark</option>
                  <option value="Sweden">Suede</option>
                  <option value="Norway">Norvege</option>
                  <option value="Italy">Italie</option>
                  <option value="Spain">Espagne</option>
                  <option value="Other">Autre</option>
                </select>
              </div>
              <div>
                <label for="city" class="block text-sm font-medium text-body mb-2">Ville *</label>
                <input type="text" id="city" name="city" required list="city-list" autocomplete="address-level2" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
                <datalist id="city-list">
                  <option value="London" /><option value="Manchester" /><option value="Birmingham" /><option value="Leeds" /><option value="Liverpool" /><option value="Bristol" /><option value="Edinburgh" /><option value="Glasgow" /><option value="Cardiff" /><option value="Belfast" />
                  <option value="Berlin" /><option value="Munich" /><option value="Hamburg" /><option value="Frankfurt" /><option value="Cologne" /><option value="Stuttgart" /><option value="Düsseldorf" /><option value="Leipzig" /><option value="Dortmund" /><option value="Dresden" />
                  <option value="Zurich" /><option value="Geneva" /><option value="Basel" /><option value="Bern" /><option value="Lausanne" />
                  <option value="Amsterdam" /><option value="Rotterdam" /><option value="The Hague" /><option value="Utrecht" /><option value="Eindhoven" />
                  <option value="Brussels" /><option value="Antwerp" /><option value="Ghent" /><option value="Bruges" /><option value="Liège" />
                  <option value="Paris" /><option value="Lyon" /><option value="Marseille" /><option value="Toulouse" /><option value="Nice" /><option value="Strasbourg" /><option value="Bordeaux" />
                  <option value="Vienna" /><option value="Graz" /><option value="Salzburg" /><option value="Innsbruck" />
                  <option value="Dublin" /><option value="Cork" /><option value="Galway" />
                  <option value="Copenhagen" /><option value="Stockholm" /><option value="Oslo" /><option value="Milan" /><option value="Rome" /><option value="Madrid" /><option value="Barcelona" />
                </datalist>
              </div>
            </div>
          </div>
        </div>

        <!-- Your Home -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Votre logement</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="home_type" class="block text-sm font-medium text-body mb-2">Vivez-vous dans une maison ou un appartement ? *</label>
              <select id="home_type" name="home_type" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="House">Maison</option>
                <option value="Apartment">Appartement</option>
                <option value="Farm / Rural property">Ferme / Propriete rurale</option>
                <option value="Other">Autre</option>
              </select>
            </div>
            <div>
              <label for="garden" class="block text-sm font-medium text-body mb-2">Avez-vous un jardin ou une cour ? *</label>
              <select id="garden" name="garden" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Yes">Oui</option>
                <option value="No">Non</option>
              </select>
            </div>
            <div id="fence-row" class="hidden">
              <label for="fence_height" class="block text-sm font-medium text-body mb-2">Quelle est la hauteur approximative de la cloture ?</label>
              <select id="fence_height" name="fence_height" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Under 1 metre">Moins d'1 metre</option>
                <option value="1 - 1.5 metres">1 - 1,5 metres</option>
                <option value="1.5 - 2 metres">1,5 - 2 metres</option>
                <option value="Over 2 metres">Plus de 2 metres</option>
                <option value="Not sure">Pas certain</option>
              </select>
              <p class="text-xs text-body mt-1">Une estimation approximative suffit. Nous pourrons verifier lors de la visite a domicile.</p>
            </div>
            <div>
              <label for="own_rent" class="block text-sm font-medium text-body mb-2">Etes-vous proprietaire ou locataire ? *</label>
              <select id="own_rent" name="own_rent" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Own">Proprietaire</option>
                <option value="Rent - landlord allows dogs">Locataire - le proprietaire autorise les chiens</option>
                <option value="Rent - need to check with landlord">Locataire - a verifier avec le proprietaire</option>
              </select>
            </div>
            <div>
              <p class="text-base font-medium text-slate-dark mb-2">Qui vit dans votre foyer ? *</p>
              <div class="flex flex-wrap gap-2 mb-3" id="household-bubbles">
                <button type="button" data-person="Partner / Spouse" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Conjoint</button>
                <button type="button" data-person="Children" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Enfants</button>
                <button type="button" data-person="Flatmates" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Colocataires</button>
                <button type="button" data-person="Grandparents" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Grands-parents</button>
                <button type="button" data-person="Other" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Autre</button>
              </div>
              <div id="household-counts" class="space-y-3"></div>
              <input type="hidden" id="household_types" name="household" value="Just me" />
              <div id="household-children-ages" class="hidden mt-3">
                <label for="children_ages" class="block text-sm font-medium text-body mb-2">Ages des enfants</label>
                <input type="text" id="children_ages" name="children_ages" placeholder="ex. 4, 7, 12" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <div class="mt-3">
                <label for="household_extra" class="block text-sm font-medium text-body mb-2">Details supplementaires ?</label>
                <input type="text" id="household_extra" name="household_extra" placeholder="ex. mon conjoint travaille a domicile" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <p class="text-xs text-body mt-1">Selectionnez toutes les options qui s'appliquent. Si vous vivez seul, ne selectionnez rien.</p>
            </div>
          </div>
        </div>

        <!-- Pets & Experience -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Animaux & experience</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="dog_experience" class="block text-sm font-medium text-body mb-2">Avez-vous deja eu un chien ? *</label>
              <select id="dog_experience" name="dog_experience" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Yes">Oui</option>
                <option value="No, first time">Non, ce serait mon premier chien</option>
              </select>
              <p class="text-xs text-body mt-1">Les nouveaux proprietaires sont les bienvenus. Nous sommes la pour vous aider.</p>
            </div>
            <div id="rescue-row" class="hidden">
              <label for="was_rescue" class="block text-sm font-medium text-body mb-2">Votre chien venait-il d'un refuge ?</label>
              <select id="was_rescue" name="was_rescue" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Yes">Oui</option>
                <option value="No">Non</option>
              </select>
            </div>
            <div>
              <label for="daily_routine" class="block text-sm font-medium text-body mb-2">A quoi ressemble une journee type pour vous ? *</label>
              <select id="daily_routine" name="daily_routine" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Work from home">Je travaille a domicile</option>
                <option value="Work outside (full-time)">Je travaille a l'exterieur (temps plein)</option>
                <option value="Work outside (part-time)">Je travaille a l'exterieur (temps partiel)</option>
                <option value="Retired">Je suis a la retraite</option>
                <option value="Student">Je suis etudiant(e)</option>
                <option value="Stay-at-home parent">Je suis parent au foyer</option>
                <option value="Other">Autre</option>
              </select>
            </div>
            <div>
              <label for="has_pets" class="block text-sm font-medium text-body mb-2">Avez-vous des animaux actuellement ? *</label>
              <select id="has_pets" name="has_pets" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="Yes">Oui</option>
                <option value="No">Non</option>
              </select>
            </div>
            <div id="pets-detail" class="hidden space-y-4">
              <div>
                <p class="text-base font-medium text-slate-dark mb-2">Quels animaux avez-vous ?</p>
                <div class="flex flex-wrap gap-2" id="pet-bubbles">
                  <button type="button" data-pet="Dogs" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Chiens</button>
                  <button type="button" data-pet="Cats" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Chats</button>
                  <button type="button" data-pet="Rabbits" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Lapins</button>
                  <button type="button" data-pet="Birds" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Oiseaux</button>
                  <button type="button" data-pet="Fish" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Poissons</button>
                  <button type="button" data-pet="Other" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Autre</button>
                </div>
                <input type="hidden" id="pet_types" name="pet_types" />
              </div>
              <div id="pet-counts" class="space-y-3"></div>
              <div>
                <label for="pets_extra" class="block text-sm font-medium text-body mb-2">Details supplementaires ? (ages, races, etc.)</label>
                <input type="text" id="pets_extra" name="pets_extra" placeholder="ex. Labrador, 5 ans, tres sociable" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
            </div>
          </div>
        </div>

        <!-- Final details -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Quelques details supplementaires</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="hours_alone" class="block text-sm font-medium text-body mb-2">Combien d'heures par jour le chien sera-t-il seul ? *</label>
              <select id="hours_alone" name="hours_alone" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Choisir...</option>
                <option value="0-2 hours">0-2 heures</option>
                <option value="2-4 hours">2-4 heures</option>
                <option value="4-6 hours">4-6 heures</option>
                <option value="6-8 hours">6-8 heures</option>
                <option value="8+ hours">8+ heures</option>
