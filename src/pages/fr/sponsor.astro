---
import Layout from "../../layouts/Layout.astro";
import DogCard from "../../components/DogCard.astro";
import { currentDogs } from "../../data/current-dogs";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

const lang: Lang = 'fr';
const t = useTranslations(lang);
---

<Layout title={t('sponsor.pageTitle')} description={t('sponsor.pageDescription')} lang={lang}>
  <section class="bg-amber-50 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-amber-700 mb-3">{t('sponsor.fromPrice')}</p>
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">{t('sponsor.heading')}</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">{t('sponsor.subtitle')}</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="text-center"><div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3"><span class="text-xl">💛</span></div><p class="text-sm text-body">{t('sponsor.benefit1')}</p></div>
      <div class="text-center"><div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3"><span class="text-xl">📸</span></div><p class="text-sm text-body">{t('sponsor.benefit2')}</p></div>
      <div class="text-center"><div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-3"><span class="text-xl">🐾</span></div><p class="text-sm text-body">{t('sponsor.benefit3')}</p></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <h2 class="text-2xl font-bold text-slate-dark text-center mb-8">{t('sponsor.chooseDog')}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentDogs.map((dog) => (
        <div class="flex flex-col">
          <div class="pointer-events-none"><DogCard slug={dog.slug} name={dog.name} shortLine={dog.fr?.shortLine ?? dog.shortLine} sex={dog.sex} age={dog.age} size={dog.size} linkPrefix="/fr/adopt" lang={lang} /></div>
          <button type="button" class="sponsor-select-btn mx-5 -mt-2 mb-4 px-6 py-3 bg-amber-500 text-white font-bold rounded-full hover:bg-amber-600 transition-colors text-sm shadow-lg relative z-10" data-dog-name={dog.name} data-dog-slug={dog.slug}>{t('sponsor.sponsorBtn').replace('{name}', dog.name)}</button>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12" id="sponsor-form-section">
    <div id="sponsor-form-container" class="hidden"><div id="sponsor-selected-dog"></div></div>
    <div id="sponsor-prompt" class="text-center py-8"><p class="text-lg text-body">{t('sponsor.chooseDog')}</p></div>
  </section>
</Layout>

<script>
  const formSection = document.getElementById('sponsor-form-section')!;
  const formContainer = document.getElementById('sponsor-form-container')!;
  const selectedDogEl = document.getElementById('sponsor-selected-dog')!;
  const prompt = document.getElementById('sponsor-prompt')!;
  const paypalUrl = "https://www.paypal.com/myaccount/transfer/homepage/pay";

  document.querySelectorAll('.sponsor-select-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const dogName = el.dataset.dogName || '';
      const dogSlug = el.dataset.dogSlug || '';
      const prices = { month: '17\u00a0\u20ac', quarter: '51\u00a0\u20ac', year: '204\u00a0\u20ac' };

      prompt.classList.add('hidden');
      formContainer.classList.remove('hidden');

      selectedDogEl.innerHTML = `
        <div class="rounded-2xl overflow-hidden border border-amber-200">
          <div class="bg-amber-50 px-8 py-6 text-center">
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-700 mb-1">Sponsoriser ${dogName}</p>
            <p class="text-3xl font-bold text-slate-800">${prices.month}<span class="text-lg font-normal text-gray-600">/mois</span></p>
          </div>
          <div class="bg-white px-8 py-6">
            <div class="grid grid-cols-3 gap-3 mb-6">
              <div class="rounded-xl p-4 text-center border-2 border-teal bg-teal/5"><p class="text-2xl font-bold" style="color:#2A9D8F">${prices.month}</p><p class="text-xs text-gray-600 mt-1">1 mois</p></div>
              <div class="rounded-xl p-4 text-center border-2 border-gray-200"><p class="text-2xl font-bold" style="color:#2A9D8F">${prices.quarter}</p><p class="text-xs text-gray-600 mt-1">3 mois</p></div>
              <div class="rounded-xl p-4 text-center border-2 border-gray-200"><p class="text-2xl font-bold" style="color:#2A9D8F">${prices.year}</p><p class="text-xs text-gray-600 mt-1">1 an</p></div>
            </div>
            <div class="text-center mb-6">
              <a href="${paypalUrl}" target="_blank" rel="noopener noreferrer" class="inline-block w-full sm:w-auto px-10 py-3.5 bg-amber-500 text-white font-bold rounded-full hover:bg-amber-600 transition-colors text-base">Faire un don via PayPal</a>
              <p class="text-xs text-gray-600 mt-2">donate2mypaws@gmail.com</p>
            </div>
            <div class="border-t border-gray-100 pt-5">
              <p class="text-sm font-semibold text-gray-800 mb-3 text-center">D\u00e9j\u00e0 donn\u00e9 ? Dites-le nous !</p>
              <form id="sponsor-form" data-dog-name="${dogName}" data-dog-slug="${dogSlug}" data-lang="fr">
                <div class="max-w-md mx-auto">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
                    <input type="text" name="firstName" placeholder="Pr\u00e9nom" required class="px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal" />
                    <input type="email" name="email" placeholder="Votre e-mail" required class="px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal" />
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <select name="tier" class="px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal text-gray-600">
                      <option value="">J'ai donn\u00e9</option>
                      <option value="month">${prices.month} \u2014 1 mois</option>
                      <option value="quarter">${prices.quarter} \u2014 3 mois</option>
                      <option value="year">${prices.year} \u2014 1 an</option>
                      <option value="other">Autre montant</option>
                    </select>
                    <button type="submit" class="px-4 py-2.5 text-white font-semibold rounded-lg hover:opacity-90 transition-colors text-sm" style="background:#2A9D8F">Nous pr\u00e9venir</button>
                  </div>
                  <p id="sponsor-msg" class="text-sm text-center mt-3 hidden"></p>
                </div>
              </form>
            </div>
          </div>
        </div>`;

      formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const form = document.getElementById('sponsor-form') as HTMLFormElement;
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          const msg = document.getElementById('sponsor-msg')!;
          const data = new FormData(form);
          submitBtn.disabled = true; submitBtn.style.opacity = '0.5';
          try {
            const res = await fetch('/api/sponsor', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ firstName: data.get('firstName'), email: data.get('email'), tier: data.get('tier'), dogName: form.dataset.dogName, dogSlug: form.dataset.dogSlug, lang: form.dataset.lang }) });
            if (res.ok) { msg.textContent = 'Merci ! Nous vous contacterons pour vous remercier personnellement.'; msg.className = 'text-sm text-center mt-3 font-medium'; msg.style.color = '#2A9D8F'; form.reset(); }
            else { msg.textContent = 'Une erreur est survenue. Veuillez r\u00e9essayer.'; msg.className = 'text-sm text-center mt-3 text-red-500'; }
          } catch { msg.textContent = 'Une erreur est survenue. Veuillez r\u00e9essayer.'; msg.className = 'text-sm text-center mt-3 text-red-500'; }
          submitBtn.disabled = false; submitBtn.style.opacity = '1';
        });
      }
    });
  });
</script>
