---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import PhotoLightbox from "../../../components/PhotoLightbox.astro";
import { currentDogs } from "../../../data/current-dogs";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/utils";
import type { GetStaticPaths } from "astro";

const lang: Lang = 'fr';
const t = useTranslations(lang);

export const getStaticPaths: GetStaticPaths = () => {
  return currentDogs.map((dog) => ({ params: { slug: dog.slug }, props: { dog } }));
};

const { dog } = Astro.props;
const description = dog.fr?.description ?? dog.description;
const shortLine = dog.fr?.shortLine ?? dog.shortLine;
const traits = dog.fr?.traits ?? dog.traits;

const allPhotos = import.meta.glob<{ default: ImageMetadata }>("../../../assets/current-dogs/**/*.{jpeg,jpg,png}", { eager: true });
const prefix = `../../../assets/current-dogs/${dog.slug}/`;
const dogPhotos = Object.entries(allPhotos).filter(([path]) => path.startsWith(prefix)).sort(([a], [b]) => a.localeCompare(b)).map(([, mod]) => mod.default);
const leadPhoto = dogPhotos[0] ?? null;
const extraPhotos = dogPhotos.slice(1);
---

<Layout
  title={`Adopter ${dog.name} | Chien sauv\u00e9 de Bosnie | My Paws Bosnia`}
  description={`${shortLine} ${dog.name} est un chien sauv\u00e9 en Bosnie, pr\u00eat \u00e0 l\u2019adoption et au transport vers des familles en Europe.`}
  ogImage={`/og/${dog.slug}.jpg`}
  lang={lang}
  jsonLd={{
    "@context": "https://schema.org", "@type": "Product",
    name: `Adopter ${dog.name} — Chien sauv\u00e9`, description,
    image: leadPhoto ? new URL(leadPhoto.src, Astro.site ?? "https://mypawsbosnia.org").href : undefined,
    brand: { "@type": "Organization", name: "My Paws Bosnia" },
    offers: { "@type": "Offer", availability: "https://schema.org/InStock", price: "0", priceCurrency: "EUR", description: "Adoption — contactez-nous sur Facebook" },
  }}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <a href="/fr/adopt" class="inline-flex items-center text-teal font-medium hover:underline mb-6">&larr; {t('adoptSlug.backToAll')}</a>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-8">
      {leadPhoto ? (
        <button type="button" class="cursor-pointer border-0 p-0 bg-transparent" data-lightbox-trigger="0">
          <Image src={leadPhoto} alt={`${dog.name}, chien sauv\u00e9 \u00e0 adopter depuis la Bosnie`} width={500} class="w-full rounded-2xl hover:opacity-90 transition-opacity" />
        </button>
      ) : (<div class="aspect-square bg-gray-100 rounded-2xl flex items-center justify-center text-8xl">🐕</div>)}
      <div>
        <h1 class="text-4xl font-bold text-slate-dark">{dog.name}</h1>
        <div class="flex flex-wrap gap-3 mt-4">
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center"><p class="text-xs text-body uppercase tracking-wide">{t('adoptSlug.age')}</p><p class="text-base font-semibold text-slate-dark mt-1">{dog.ageYears ? `${dog.ageYears} ${t('adoptSlug.years')}` : dog.age}</p></div>
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center"><p class="text-xs text-body uppercase tracking-wide">{t('adoptSlug.size')}</p><p class="text-base font-semibold text-slate-dark mt-1 capitalize">{dog.size}</p></div>
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center"><p class="text-xs text-body uppercase tracking-wide">{t('adoptSlug.sex')}</p><p class="text-base font-semibold text-slate-dark mt-1 capitalize">{dog.sex}</p></div>
        </div>
        <div class="mt-6">
          <p class="text-body leading-relaxed">{description}</p>
          {traits && traits.length > 0 && (
            <ul class="mt-4 space-y-2">{traits.map((tr) => (<li class="flex items-start gap-2 text-body"><span class="text-teal mt-0.5">&#10003;</span><span>{tr}</span></li>))}</ul>
          )}
        </div>
      </div>
    </div>

    {extraPhotos.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold text-slate-dark mb-4">{t('adoptSlug.morePhotos')}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {extraPhotos.map((photo, i) => (<button type="button" class="cursor-pointer border-0 p-0 bg-transparent" data-lightbox-trigger={i + 1}><Image src={photo} alt={`${dog.name} photo ${i + 2}`} width={400} height={400} class="w-full aspect-square object-cover rounded-xl hover:opacity-90 transition-opacity" /></button>))}
        </div>
      </div>
    )}

    <PhotoLightbox photos={dogPhotos} name={dog.name} lang={lang} />

    <div class="mt-12 bg-light-bg rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-slate-dark mb-2">{t('adoptSlug.feesTitle')}</h2>
      <p class="text-body mb-6">{t('adoptSlug.feesIntro')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 text-center"><p class="text-sm text-body">{t('adoptSlug.uk')}</p><p class="text-xl font-bold text-slate-dark">~£500</p></div>
        <div class="bg-white rounded-xl p-4 text-center"><p class="text-sm text-body">{t('adoptSlug.europe')}</p><p class="text-xl font-bold text-slate-dark">€300–400</p></div>
        <div class="bg-white rounded-xl p-4 text-center"><p class="text-sm text-body">{t('adoptSlug.switzerland')}</p><p class="text-xl font-bold text-slate-dark">CHF 500–550</p></div>
      </div>
      <p class="text-sm text-body mb-4">{t('adoptSlug.brucellosis')}</p>
      <p class="text-sm text-body">{t('adoptSlug.feesNote')}</p>
    </div>

    <div class="mt-12 bg-teal/5 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-slate-dark mb-3">{t('adoptSlug.interestedIn').replace('{name}', dog.name)}</h2>
      <p class="text-body mb-6">{t('adoptSlug.interestedText')}</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">{t('adoptSlug.messageFb')}</a>
        <a href="https://wa.me/38765628636" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-green-500 text-white font-semibold rounded-full hover:bg-green-600 transition-colors">{t('adoptSlug.whatsapp')}</a>
        <a href={`mailto:donate2mypaws@gmail.com?subject=Demande d'adoption pour ${dog.name}`} class="inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors">{t('adoptSlug.emailUs')}</a>
      </div>
    </div>

    <div class="mt-6 text-center">
      <button type="button" id="share-btn" class="inline-flex items-center gap-2 px-6 py-3 text-teal font-semibold border-2 border-teal rounded-full hover:bg-teal hover:text-white transition-colors text-sm" data-dog-name={dog.name} data-share-label={t('adoptSlug.share').replace('{name}', dog.name)}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg>
        {t('adoptSlug.share').replace('{name}', dog.name)}
      </button>
    </div>
  </section>
</Layout>

<script>
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      const url = window.location.href;
      const name = (shareBtn as HTMLElement).dataset.dogName || '';
      const label = (shareBtn as HTMLElement).dataset.shareLabel || '';
      if (navigator.share) {
        try {
          await navigator.share({ title: `Adopter ${name} | My Paws Bosnia`, url });
        } catch {}
      } else {
        await navigator.clipboard.writeText(url);
        shareBtn.textContent = 'Lien copi\u00e9 !';
        setTimeout(() => { shareBtn.textContent = label; }, 2000);
      }
    });
  }
</script>
