---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

const lang: Lang = 'nl';
const t = useTranslations(lang);
---

<Layout title={t('contact.title')} description={t('contact.description')} lang={lang}>
  <section class="bg-light-bg py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">{t('contact.heading')}</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">{t('contact.subtitle')}</p>
    </div>
  </section>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-light-bg rounded-2xl p-8">
        <div class="text-3xl mb-4">📘</div>
        <h2 class="text-lg font-semibold text-slate-dark mb-2">{t('contact.fbTitle')}</h2>
        <p class="text-body text-sm mb-4">{t('contact.fbText')}</p>
        <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-2.5 bg-teal text-white font-semibold rounded-full text-sm hover:bg-teal/90 transition-colors">{t('contact.fbButton')}</a>
      </div>
      <div class="bg-light-bg rounded-2xl p-8">
        <div class="text-3xl mb-4">📍</div>
        <h2 class="text-lg font-semibold text-slate-dark mb-2">{t('contact.locationTitle')}</h2>
        <p class="text-body">{t('footer.locationText')}</p>
      </div>
    </div>
  </section>
</Layout>
