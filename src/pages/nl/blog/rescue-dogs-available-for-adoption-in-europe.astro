---
import Layout from "../../../layouts/Layout.astro";
import { currentDogs } from "../../../data/current-dogs";
import { successStories } from "../../../data/success-stories";

const title = "Reddingshonden beschikbaar voor adoptie in Europa | My Paws Bosnia";
const description = "Reddingshonden beschikbaar voor adoptie in heel Europa, het VK en Zwitserland. Volledig medisch verzorgd, gevaccineerd en met EU-dierenpaspoort. Bekijk de honden en adopteer vandaag.";

const dogCount = currentDogs.length;
const adoptedCount = successStories.length;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Reddingshonden beschikbaar voor adoptie in Europa",
  description,
  author: { "@type": "Organization", name: "My Paws Bosnia" },
  publisher: { "@type": "Organization", name: "My Paws Bosnia" },
  mainEntityOfPage: "https://mypawsbosnia.org/nl/blog/rescue-dogs-available-for-adoption-in-europe",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Naar welke landen kunnen deze reddingshonden geadopteerd worden?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Onze honden kunnen naar elk EU-land, het VK en Zwitserland reizen. We hebben honden geplaatst in Engeland, België, Oostenrijk, Duitsland, Nederland en Frankrijk."
      }
    },
    {
      "@type": "Question",
      name: "Zijn deze honden veilig bij kinderen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "De meeste van onze honden zijn goed met kinderen. Het profiel van elke hond bevat specifieke informatie over hun temperament bij kinderen. We matchen honden altijd met gezinnen op basis van de thuissituatie."
      }
    },
    {
      "@type": "Question",
      name: "Welke rassen zijn beschikbaar?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Onze honden zijn kruisingen. Veelvoorkomende mixen zijn Labrador, Herder, Spaniel-Setter, Retriever-Spitz en Terriërkruisingen. Kruisingen hebben doorgaans minder erfelijke gezondheidsproblemen en een langere levensduur dan rashonden."
      }
    },
    {
      "@type": "Question",
      name: "Hoe weet ik dat deze honden gezond zijn?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Elke hond wordt onderzocht door een dierenarts, gevaccineerd (inclusief rabiës), gecastreerd of gesteriliseerd, ontwormd, behandeld tegen parasieten en gechipt voor de reis. Bloedonderzoek op brucellose en andere aandoeningen is op verzoek beschikbaar."
      }
    },
  ],
};
---

<Layout title={title} description={description} lang="nl" jsonLd={[articleSchema, faqSchema]}>
  <!-- Hero -->
  <section class="bg-light-bg py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-teal uppercase tracking-wide mb-3">Adopteer een reddingshond</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-dark leading-tight">Reddingshonden beschikbaar voor adoptie in Europa</h1>
      <p class="text-lg text-body mt-4 leading-relaxed">
        {dogCount} reddingshonden in ons asiel in Bosnië zijn klaar om te reizen naar gezinnen in heel Europa, het VK en Zwitserland. Elke hond is volledig medisch verzorgd, gevaccineerd en heeft een dierenpaspoort.
      </p>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- De situatie -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">De situatie van reddingshonden in Bosnië</h2>
      <p class="text-body leading-relaxed mb-4">
        Bosnië heeft tienduizenden zwerfhonden. Er is geen nationaal castratie- of sterilisatieprogramma, en openbare asiels zijn ernstig ondergefinancierd. Honden in gemeentelijke asiels worden geconfronteerd met overbevolking, ziektes en in veel gevallen euthanasie.
      </p>
      <p class="text-body leading-relaxed">
        My Paws Bosnia (Moje Sape) is een privé reddingsasiel in Brcko, gerund door Vesna en haar familie sinds 2019. We redden honden van straat en uit openbare asiels, bieden volledige dierenartsenzorg en vinden ze een permanent thuis in heel Europa. We hebben tot nu toe {adoptedCount} honden bij gezinnen geplaatst, en {dogCount} wachten er momenteel nog.
      </p>
    </section>

    <!-- Waarom deze honden geweldige huisdieren zijn -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Waarom deze honden geweldige huisdieren zijn</h2>
      <div class="space-y-4">
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Gesocialiseerd en mensvriendelijk</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Onze honden leven samen in het asiel met dagelijks menselijk contact. Ze zijn gewend aan mensen, andere honden en in veel gevallen aan kinderen en katten. Het zijn geen verwilderde dieren.
          </p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Volledig medisch verzorgd voor de reis</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Elke hond wordt gecastreerd/gesteriliseerd, gevaccineerd (inclusief rabiës), ontwormd, behandeld tegen parasieten, gechipt en voorzien van een dierenpaspoort. Bloedonderzoek op brucellose is op verzoek beschikbaar.
          </p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Temperament beoordeeld</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Vesna kent elke hond persoonlijk. Ze kan je precies vertellen hoe ze zich gedragen bij kinderen, katten, andere honden en vreemden. We matchen honden met gezinnen op basis van dagelijkse observatie, niet op giswerk.
          </p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Kruisingen met minder gezondheidsproblemen</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Onze honden zijn kruisingen. Veelvoorkomende mixen zijn Labrador, Herder, Spaniel-Setter, Retriever-Spitz en Terriërkruisingen. Kruisingen hebben doorgaans minder erfelijke gezondheidsproblemen en een langere levensduur dan rashonden.
          </p>
        </div>
      </div>
    </section>

    <!-- Waar ze naartoe kunnen reizen -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Waar onze honden naartoe kunnen reizen</h2>
      <p class="text-body leading-relaxed mb-4">
        Wij regelen gelicentieerd dierentransport van Bosnië naar je voordeur. Onze honden zijn geadopteerd naar:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Verenigd Koninkrijk</p>
          <p class="text-xs text-body mt-1">~&pound;500 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Duitsland</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Nederland</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">België</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Oostenrijk</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Zwitserland</p>
          <p class="text-xs text-body mt-1">CHF&nbsp;500&ndash;550 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Frankrijk</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center col-span-2 sm:col-span-2">
          <p class="font-semibold text-slate-dark text-sm">Elk ander EU-land</p>
          <p class="text-xs text-body mt-1">Neem contact met ons op voor een offerte</p>
        </div>
      </div>
      <p class="text-sm text-body mt-4">Er zijn geen adoptiekosten. Je betaalt alleen de transportkosten.</p>
    </section>

    <!-- Nu beschikbare honden -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Honden die nu beschikbaar zijn</h2>
      <p class="text-body leading-relaxed mb-6">
        Elke hond hieronder verblijft in ons asiel in Brcko, Bosnië. Ze zijn medisch verzorgd, gezond en klaar om te reizen.
      </p>
      <div class="space-y-4">
        {currentDogs.map((dog) => (
          <a href={`/nl/adopt/${dog.slug}`} class="block bg-white border border-gray-100 rounded-xl p-5 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-semibold text-slate-dark text-lg">{dog.name}</h3>
                <p class="text-body mt-1 leading-relaxed">{dog.shortLine}</p>
                <div class="flex flex-wrap gap-2 mt-3">
                  <span class="inline-block bg-teal/10 text-teal text-xs font-medium px-3 py-1 rounded-full">
                    {dog.sex === 'male' ? 'Reu' : 'Teef'}
                  </span>
                  <span class="inline-block bg-teal/10 text-teal text-xs font-medium px-3 py-1 rounded-full">
                    {dog.age === 'puppy' ? 'Puppy' : dog.age === 'young' ? 'Jong' : dog.age === 'adult' ? 'Volwassen' : 'Senior'}
                  </span>
                  <span class="inline-block bg-teal/10 text-teal text-xs font-medium px-3 py-1 rounded-full">
                    {dog.size === 'small' ? 'Klein' : dog.size === 'medium' ? 'Middelgroot' : 'Groot'}
                  </span>
                </div>
              </div>
              <span class="text-teal text-sm font-medium whitespace-nowrap">Profiel bekijken &rarr;</span>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/nl/adopt" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">
          Alle {dogCount} honden bekijken
        </a>
      </div>
    </section>

    <!-- Recente adopties -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Recente succesvolle adopties</h2>
      <p class="text-body leading-relaxed mb-6">
        Deze honden zaten in hetzelfde asiel. Ze hebben hetzelfde proces doorlopen en zijn nu gelukkig bij hun gezinnen.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {successStories.map((story) => (
          <a href={`/nl/success-stories/${story.slug}`} class="block bg-light-bg rounded-xl p-5 hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-slate-dark">{story.name}</h3>
            {story.adoptedTo && <p class="text-xs text-teal font-medium mt-1">Geadopteerd naar {story.adoptedTo}</p>}
            <p class="text-sm text-body mt-2">{story.shortLine}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Hoe het adoptieproces werkt -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Hoe adoptie werkt</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">1</p>
          <h3 class="font-semibold text-slate-dark mt-1">Stuur ons een bericht</h3>
          <p class="text-sm text-body mt-1">Stuur ons een bericht via Facebook of WhatsApp. Vertel ons welke hond je interesse heeft en over je woning.</p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">2</p>
          <h3 class="font-semibold text-slate-dark mt-1">Huiscontrole</h3>
          <p class="text-sm text-body mt-1">We doen een snelle, vriendelijke huiscontrole. In het VK is dit meestal een videogesprek. In Duitsland en Oostenrijk is het zeer waarschijnlijk persoonlijk.</p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">3</p>
          <h3 class="font-semibold text-slate-dark mt-1">Dierenarts en paspoort</h3>
          <p class="text-sm text-body mt-1">We voltooien alle vaccinaties, castratie, ontworming en reiken het dierenpaspoort uit.</p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">4</p>
          <h3 class="font-semibold text-slate-dark mt-1">Transport naar jou</h3>
          <p class="text-sm text-body mt-1">Een gelicentieerde transporteur brengt je hond rechtstreeks naar je huis. Het hele proces duurt 4 tot 8 weken.</p>
        </div>
      </div>
      <p class="text-sm text-body mt-4">
        Voor de volledige stap-voor-stap handleiding, lees onze <a href="/nl/blog/how-to-adopt-a-dog-from-bosnia" class="text-teal font-medium hover:underline">adoptiegids</a>.
      </p>
    </section>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-6">Veelgestelde vragen</h2>
      <div class="space-y-4">
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Naar welke landen kunnen deze reddingshonden geadopteerd worden?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Onze honden kunnen naar elk EU-land, het VK en Zwitserland reizen. We hebben honden geplaatst in Engeland, België, Oostenrijk, Duitsland, Nederland en Frankrijk.
          </div>
        </details>
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Zijn deze honden veilig bij kinderen?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            De meeste van onze honden zijn goed met kinderen. Het profiel van elke hond bevat specifieke informatie over hun temperament bij kinderen. We matchen honden altijd met gezinnen op basis van de thuissituatie.
          </div>
        </details>
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Welke rassen zijn beschikbaar?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Onze honden zijn kruisingen. Veelvoorkomende mixen zijn Labrador, Herder, Spaniel-Setter, Retriever-Spitz en Terriërkruisingen. Kruisingen hebben doorgaans minder erfelijke gezondheidsproblemen en een langere levensduur dan rashonden.
          </div>
        </details>
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Hoe weet ik dat deze honden gezond zijn?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Elke hond wordt onderzocht door een dierenarts, gevaccineerd (inclusief rabiës), gecastreerd of gesteriliseerd, ontwormd, behandeld tegen parasieten, gechipt en voorzien van een dierenpaspoort voor de reis. Bloedonderzoek op brucellose en andere aandoeningen is op verzoek beschikbaar.
          </div>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-light-bg rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-slate-dark mb-3">Start het adoptieproces</h2>
      <p class="text-body mb-6">Stuur ons een bericht en vertel ons welke hond je interesse heeft. We begeleiden je bij elke stap.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">
          Stuur ons een bericht op Facebook
        </a>
        <a href="/nl/adopt" class="inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors">
          Alle honden bekijken
        </a>
      </div>
    </section>

  </article>
</Layout>
