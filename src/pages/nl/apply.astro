---
import Layout from "../../layouts/Layout.astro";
import { currentDogs } from "../../data/current-dogs";

const dogNames = currentDogs.map((d) => d.name);
const dogSlugs = currentDogs.map((d) => ({ name: d.name, slug: d.slug }));
---

<Layout title="Adoptieaanvraag | My Paws Bosnia" description="Vul ons adoptieformulier in. We beoordelen elke aanvraag en reageren meestal binnen enkele dagen." lang="nl">
  <section class="bg-light-bg py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Adoptieaanvraag</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">Vertel ons iets over jezelf en de hond waarin je geïnteresseerd bent. We beoordelen elke aanvraag en reageren meestal binnen enkele dagen.</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <form id="adopt-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-8">
      <input type="hidden" name="access_key" value="82e1cf41-2872-4b2a-92e3-8d373b609503" />
      <input type="hidden" name="subject" value="New Adoption Application - My Paws Bosnia" />
      <input type="hidden" name="from_name" value="My Paws Bosnia Adoption Form" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
      <input type="hidden" id="whatsapp_link" name="WhatsApp Link (click to chat)" value="" />

      <!-- About You -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">Over jou</h2>
        </div>
        <div class="space-y-4">
          <div>
            <label for="name" class="block text-base font-medium text-slate-dark mb-1">Volledige naam *</label>
            <input type="text" id="name" name="name" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
          </div>
          <div>
            <label for="email" class="block text-base font-medium text-slate-dark mb-1">E-mailadres *</label>
            <input type="email" id="email" name="email" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
          </div>
          <div>
            <label for="phone" class="block text-base font-medium text-slate-dark mb-1">Telefoonnummer (met landcode) *</label>
            <input type="tel" id="phone" name="phone" required placeholder="+31 6 12345678" pattern="[\+\d\s\-\(\)]{7,20}" inputmode="tel" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="country" class="block text-base font-medium text-slate-dark mb-1">Land *</label>
              <select id="country" name="country" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Selecteer...</option>
                <option value="United Kingdom">Verenigd Koninkrijk</option>
                <option value="Germany">Duitsland</option>
                <option value="Switzerland">Zwitserland</option>
                <option value="Netherlands">Nederland</option>
                <option value="Belgium">België</option>
                <option value="France">Frankrijk</option>
                <option value="Austria">Oostenrijk</option>
                <option value="Ireland">Ierland</option>
                <option value="Denmark">Denemarken</option>
                <option value="Sweden">Zweden</option>
                <option value="Norway">Noorwegen</option>
                <option value="Italy">Italië</option>
                <option value="Spain">Spanje</option>
                <option value="Other">Anders</option>
              </select>
            </div>
            <div>
              <label for="city" class="block text-base font-medium text-slate-dark mb-1">Stad *</label>
              <input type="text" id="city" name="city" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
          </div>
        </div>
      </div>

      <!-- Your Home -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">Je woning</h2>
        </div>
        <div class="space-y-4">
          <div>
            <label for="home_type" class="block text-base font-medium text-slate-dark mb-1">Woon je in een huis of appartement? *</label>
            <select id="home_type" name="home_type" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="House">Huis</option>
              <option value="Apartment">Appartement</option>
              <option value="Farm / Rural property">Boerderij / Landelijk</option>
              <option value="Other">Anders</option>
            </select>
          </div>
          <div>
            <label for="garden" class="block text-base font-medium text-slate-dark mb-1">Heb je een tuin? *</label>
            <select id="garden" name="garden" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="Yes">Ja</option>
              <option value="No">Nee</option>
            </select>
          </div>
          <div id="fence-row" class="hidden">
            <label for="fence_height" class="block text-base font-medium text-slate-dark mb-1">Hoe hoog is de omheining ongeveer?</label>
            <select id="fence_height" name="fence_height" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="Under 1 metre">Minder dan 1 meter</option>
              <option value="1 - 1.5 metres">1 - 1,5 meter</option>
              <option value="1.5 - 2 metres">1,5 - 2 meter</option>
              <option value="Over 2 metres">Meer dan 2 meter</option>
              <option value="Not sure">Niet zeker</option>
            </select>
            <p class="text-xs text-body mt-1">Een ruwe schatting is prima. We kunnen het controleren tijdens het huisbezoek.</p>
          </div>
          <div>
            <label for="own_rent" class="block text-base font-medium text-slate-dark mb-1">Ben je eigenaar of huur je? *</label>
            <select id="own_rent" name="own_rent" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="Own">Eigen woning</option>
              <option value="Rent - landlord allows dogs">Huur - verhuurder staat honden toe</option>
              <option value="Rent - need to check with landlord">Huur - moet nog navragen bij verhuurder</option>
            </select>
            <p class="text-xs text-body mt-1">Veel verhuurders staan honden toe. Als je het niet zeker weet, helpen we graag.</p>
          </div>
          <div>
            <p class="text-sm font-medium text-slate-dark mb-2">Wie woont er in je huis? *</p>
            <div class="flex flex-wrap gap-2 mb-3" id="household-bubbles">
              <button type="button" data-person="Partner / Spouse" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Partner</button>
              <button type="button" data-person="Children" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Kinderen</button>
              <button type="button" data-person="Flatmates" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Huisgenoten</button>
              <button type="button" data-person="Grandparents" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Grootouders</button>
              <button type="button" data-person="Other" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Anders</button>
            </div>
            <div id="household-counts" class="space-y-3"></div>
            <input type="hidden" id="household_types" name="household" value="Just me" />
            <div id="household-children-ages" class="hidden mt-3">
              <label for="children_ages" class="block text-base font-medium text-slate-dark mb-1">Leeftijden van de kinderen</label>
              <input type="text" id="children_ages" name="children_ages" placeholder="bijv. 4, 7, 12" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div class="mt-3">
              <label for="household_extra" class="block text-base font-medium text-slate-dark mb-1">Extra details?</label>
              <input type="text" id="household_extra" name="household_extra" placeholder="bijv. mijn partner werkt vanuit huis" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <p class="text-xs text-body mt-1">Selecteer alles wat van toepassing is. Als je alleen woont, laat ze dan ongeselecteerd.</p>
          </div>
        </div>
      </div>

      <!-- Pets & Experience -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">Huisdieren & ervaring</h2>
        </div>
        <div class="space-y-4">
          <div>
            <label for="dog_experience" class="block text-base font-medium text-slate-dark mb-1">Heb je eerder een hond gehad? *</label>
            <select id="dog_experience" name="dog_experience" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="Yes">Ja</option>
              <option value="No, first time">Nee, dit zou mijn eerste hond zijn</option>
            </select>
            <p class="text-xs text-body mt-1">Eerste eigenaren zijn welkom. We helpen je graag op weg.</p>
          </div>
          <div>
            <label for="has_pets" class="block text-base font-medium text-slate-dark mb-1">Heb je momenteel huisdieren? *</label>
            <select id="has_pets" name="has_pets" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="Yes">Ja</option>
              <option value="No">Nee</option>
            </select>
          </div>
          <div id="pets-detail" class="hidden space-y-4">
            <div>
              <p class="text-sm font-medium text-slate-dark mb-2">Welke huisdieren heb je?</p>
              <div class="flex flex-wrap gap-2" id="pet-bubbles">
                <button type="button" data-pet="Dogs" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Honden</button>
                <button type="button" data-pet="Cats" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Katten</button>
                <button type="button" data-pet="Rabbits" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Konijnen</button>
                <button type="button" data-pet="Birds" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Vogels</button>
                <button type="button" data-pet="Fish" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Vissen</button>
                <button type="button" data-pet="Other" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Anders</button>
              </div>
              <input type="hidden" id="pet_types" name="pet_types" />
            </div>
            <div id="pet-counts" class="space-y-3"></div>
            <div>
              <label for="pets_extra" class="block text-base font-medium text-slate-dark mb-1">Extra details? (leeftijden, rassen, etc.)</label>
              <input type="text" id="pets_extra" name="pets_extra" placeholder="bijv. Labrador, 5 jaar oud, erg vriendelijk" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
          </div>
        </div>
      </div>

      <!-- About the Adoption -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">Over de adoptie</h2>
        </div>
        <div class="space-y-4">
          <div>
            <label for="dog_interest" class="block text-base font-medium text-slate-dark mb-1">In welke hond ben je geïnteresseerd? *</label>
            <select id="dog_interest" name="dog_interest" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer een hond...</option>
              {dogNames.map((name) => (
                <option value={name}>{name}</option>
              ))}
              <option value="Not sure yet">Nog niet zeker</option>
            </select>
          </div>
          <div>
            <label for="hours_alone" class="block text-base font-medium text-slate-dark mb-1">Hoeveel uur per dag zal de hond alleen zijn? *</label>
            <select id="hours_alone" name="hours_alone" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="0-2 hours">0-2 uur</option>
              <option value="2-4 hours">2-4 uur</option>
              <option value="4-6 hours">4-6 uur</option>
              <option value="6-8 hours">6-8 uur</option>
              <option value="8+ hours">8+ uur</option>
            </select>
          </div>
          <div>
            <label for="sleep" class="block text-base font-medium text-slate-dark mb-1">Waar zal de hond slapen?</label>
            <input type="text" id="sleep" name="sleep" placeholder="bijv. in de woonkamer, in onze slaapkamer" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
          </div>
          <div>
            <label for="home_check" class="block text-base font-medium text-slate-dark mb-1">Ben je bereid een huiscontrole te doen (virtueel of persoonlijk)? *</label>
            <select id="home_check" name="home_check" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
              <option value="">Selecteer...</option>
              <option value="Yes">Ja</option>
              <option value="No">Nee</option>
            </select>
            <p class="text-xs text-body mt-1">Dit kan via een videogesprek. Het is een kort, vriendelijk gesprek om te zorgen dat de hond goed bij je past.</p>
          </div>
          <div>
            <label for="questions" class="block text-base font-medium text-slate-dark mb-1">Heb je vragen over de hond?</label>
            <textarea id="questions" name="questions" rows="3" placeholder="bijv. Hoe gaat de hond om met katten? Heeft de hond gezondheidsproblemen? Wat voor voer eten ze?" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent resize-y"></textarea>
            <p class="text-xs text-body mt-1">We beantwoorden graag alles. Geen enkele vraag is te klein.</p>
          </div>
          <div>
            <label for="message" class="block text-base font-medium text-slate-dark mb-1">Wil je ons nog iets laten weten?</label>
            <textarea id="message" name="message" rows="3" placeholder="Vertel ons over jezelf, je levensstijl, of waarom je geïnteresseerd bent in deze hond..." class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent resize-y"></textarea>
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="text-center pt-2">
        <button type="submit" id="submit-btn" class="inline-block px-10 py-3.5 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors text-base shadow-md hover:shadow-lg">Aanvraag versturen</button>
        <p class="text-sm text-body mt-4">We hebben al meer dan 20 honden een liefdevol thuis bezorgd in Europa en het Verenigd Koninkrijk.</p>
        <p class="text-xs text-body mt-1">We beoordelen elke aanvraag en nemen binnen enkele dagen contact met je op.</p>
      </div>
    </form>

    <!-- Success message (hidden by default) -->
    <div id="success-msg" class="hidden py-16">
      <div class="bg-white rounded-2xl p-8 md:p-12 shadow-sm border border-gray-100 text-center">
        <div class="text-5xl mb-4">🐾</div>
        <h2 class="text-2xl font-bold text-slate-dark mb-2">Bedankt voor je aanvraag!</h2>
        <p class="text-lg text-body mb-6" id="success-dog-text">We zijn zo blij dat je geïnteresseerd bent om een reddingshond een liefdevol thuis te geven.</p>

        <!-- Dog photo (shown if a specific dog was selected) -->
        <div id="success-dog-photo" class="hidden mb-6">
          <img id="success-dog-img" src="" alt="" class="w-48 h-48 object-cover rounded-2xl mx-auto shadow-md" />
        </div>

        <div class="bg-light-bg rounded-xl p-6 mb-8 text-left max-w-md mx-auto">
          <h3 class="font-semibold text-slate-dark mb-3 text-center">Wat gebeurt er nu?</h3>
          <ol class="space-y-3 text-sm text-body">
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">1</span>
              <span>We bekijken je aanvraag en <strong>nemen binnen 24 uur contact met je op via WhatsApp</strong>.</span>
            </li>
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">2</span>
              <span>We plannen een <strong>huiscontrole</strong> in: een kort, vriendelijk videogesprek of persoonlijk bezoek om te zorgen dat het een goede match is.</span>
            </li>
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">3</span>
              <span>Na goedkeuring regelen we <strong>gelicenseerd transport</strong> rechtstreeks naar je deur.</span>
            </li>
          </ol>
        </div>

        <p class="text-body mb-6">Kun je niet wachten? Je kunt ons ook direct bereiken:</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://wa.me/38765628636" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-green-500 text-white font-semibold rounded-full hover:bg-green-600 transition-colors">Stuur ons een WhatsApp-bericht</a>
          <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">Stuur ons een Facebook-bericht</a>
        </div>
        <div class="mt-8">
          <a href="/adopt" class="text-teal font-medium hover:underline">&larr; Terug naar alle honden</a>
        </div>
      </div>
    </div>

    <!-- Dog slug/photo data for success screen -->
    <script id="dog-data" type="application/json" set:html={JSON.stringify(
      currentDogs.map(d => ({ name: d.name, slug: d.slug }))
    )} />
  </section>
</Layout>

<script>
  // Show/hide fence height based on garden answer
  const gardenSelect = document.getElementById('garden') as HTMLSelectElement;
  const fenceRow = document.getElementById('fence-row');
  if (gardenSelect && fenceRow) {
    gardenSelect.addEventListener('change', () => {
      fenceRow.classList.toggle('hidden', gardenSelect.value !== 'Yes');
    });
  }

  // Show/hide pet details based on has_pets answer
  const hasPetsSelect = document.getElementById('has_pets') as HTMLSelectElement;
  const petsDetail = document.getElementById('pets-detail');
  if (hasPetsSelect && petsDetail) {
    hasPetsSelect.addEventListener('change', () => {
      petsDetail.classList.toggle('hidden', hasPetsSelect.value !== 'Yes');
    });
  }

  // Pet type bubbles
  const selectedPets = new Set<string>();
  const petBubbles = document.querySelectorAll<HTMLButtonElement>('.pet-bubble');
  const petTypesInput = document.getElementById('pet_types') as HTMLInputElement;
  const petCountsDiv = document.getElementById('pet-counts');

  function updatePetCounts() {
    if (!petCountsDiv) return;
    petCountsDiv.innerHTML = '';
    selectedPets.forEach((pet) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3';
      row.innerHTML = `
        <label class="text-sm text-slate-dark w-20">${pet}</label>
        <div class="flex items-center gap-2">
          <button type="button" class="pet-minus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-pet="${pet}">-</button>
          <span class="pet-count text-sm font-semibold text-slate-dark w-6 text-center" data-pet="${pet}">1</span>
          <button type="button" class="pet-plus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-pet="${pet}">+</button>
        </div>
        <input type="hidden" name="pet_count_${pet.toLowerCase()}" value="1" class="pet-count-input" data-pet="${pet}" />
      `;
      petCountsDiv.appendChild(row);
    });

    // Attach +/- listeners
    petCountsDiv.querySelectorAll('.pet-plus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pet = (btn as HTMLElement).dataset.pet!;
        const countEl = petCountsDiv!.querySelector(`.pet-count[data-pet="${pet}"]`) as HTMLElement;
        const inputEl = petCountsDiv!.querySelector(`.pet-count-input[data-pet="${pet}"]`) as HTMLInputElement;
        const val = Math.min(parseInt(countEl.textContent || '1') + 1, 20);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });
    petCountsDiv.querySelectorAll('.pet-minus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pet = (btn as HTMLElement).dataset.pet!;
        const countEl = petCountsDiv!.querySelector(`.pet-count[data-pet="${pet}"]`) as HTMLElement;
        const inputEl = petCountsDiv!.querySelector(`.pet-count-input[data-pet="${pet}"]`) as HTMLInputElement;
        const val = Math.max(parseInt(countEl.textContent || '1') - 1, 1);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });

    if (petTypesInput) petTypesInput.value = Array.from(selectedPets).join(', ');
  }

  // Household bubbles
  const selectedHousehold = new Set<string>();
  const householdBubbles = document.querySelectorAll<HTMLButtonElement>('.household-bubble');
  const householdTypesInput = document.getElementById('household_types') as HTMLInputElement;
  const householdCountsDiv = document.getElementById('household-counts');
  const childrenAgesDiv = document.getElementById('household-children-ages');

  function updateHouseholdCounts() {
    if (!householdCountsDiv) return;
    householdCountsDiv.innerHTML = '';
    selectedHousehold.forEach((person) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3';
      row.innerHTML = `
        <label class="text-sm text-slate-dark w-32">${person}</label>
        <div class="flex items-center gap-2">
          <button type="button" class="hh-minus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-person="${person}">-</button>
          <span class="hh-count text-sm font-semibold text-slate-dark w-6 text-center" data-person="${person}">1</span>
          <button type="button" class="hh-plus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-person="${person}">+</button>
        </div>
        <input type="hidden" name="household_count_${person.toLowerCase().replace(/[\s\/]/g, '_')}" value="1" class="hh-count-input" data-person="${person}" />
      `;
      householdCountsDiv.appendChild(row);
    });

    householdCountsDiv.querySelectorAll('.hh-plus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const person = (btn as HTMLElement).dataset.person!;
        const countEl = householdCountsDiv!.querySelector(`.hh-count[data-person="${person}"]`) as HTMLElement;
        const inputEl = householdCountsDiv!.querySelector(`.hh-count-input[data-person="${person}"]`) as HTMLInputElement;
        const val = Math.min(parseInt(countEl.textContent || '1') + 1, 20);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });
    householdCountsDiv.querySelectorAll('.hh-minus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const person = (btn as HTMLElement).dataset.person!;
        const countEl = householdCountsDiv!.querySelector(`.hh-count[data-person="${person}"]`) as HTMLElement;
        const inputEl = householdCountsDiv!.querySelector(`.hh-count-input[data-person="${person}"]`) as HTMLInputElement;
        const val = Math.max(parseInt(countEl.textContent || '1') - 1, 1);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });

    if (householdTypesInput) {
      householdTypesInput.value = selectedHousehold.size > 0 ? Array.from(selectedHousehold).join(', ') : 'Just me';
    }
    if (childrenAgesDiv) {
      childrenAgesDiv.classList.toggle('hidden', !selectedHousehold.has('Children'));
    }
  }

  householdBubbles.forEach((bubble) => {
    bubble.addEventListener('click', () => {
      const person = bubble.dataset.person!;
      if (selectedHousehold.has(person)) {
        selectedHousehold.delete(person);
        bubble.classList.remove('bg-teal', 'text-white', 'border-teal');
        bubble.classList.add('text-body', 'border-gray-200');
      } else {
        selectedHousehold.add(person);
        bubble.classList.add('bg-teal', 'text-white', 'border-teal');
        bubble.classList.remove('text-body', 'border-gray-200');
      }
      updateHouseholdCounts();
    });
  });

  petBubbles.forEach((bubble) => {
    bubble.addEventListener('click', () => {
      const pet = bubble.dataset.pet!;
      if (selectedPets.has(pet)) {
        selectedPets.delete(pet);
        bubble.classList.remove('bg-teal', 'text-white', 'border-teal');
        bubble.classList.add('text-body', 'border-gray-200');
      } else {
        selectedPets.add(pet);
        bubble.classList.add('bg-teal', 'text-white', 'border-teal');
        bubble.classList.remove('text-body', 'border-gray-200');
      }
      updatePetCounts();
    });
  });

  // Handle form submission
  const form = document.getElementById('adopt-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form && successMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      // Build WhatsApp click-to-chat link from phone number
      const phoneInput = (document.getElementById('phone') as HTMLInputElement)?.value || '';
      const cleanPhone = phoneInput.replace(/[\s\-\(\)]/g, '').replace(/^\+/, '');
      const applicantName = (document.getElementById('name') as HTMLInputElement)?.value || '';
      const selectedDogName = (document.getElementById('dog_interest') as HTMLSelectElement)?.value || '';
      const waMessage = encodeURIComponent(`Hi ${applicantName}! This is My Paws Bosnia. We received your adoption application${selectedDogName && selectedDogName !== 'Not sure yet' ? ` for ${selectedDogName}` : ''}. We'd love to chat with you about the next steps!`);
      const waLink = document.getElementById('whatsapp_link') as HTMLInputElement;
      if (waLink && cleanPhone) {
        waLink.value = `https://wa.me/${cleanPhone}?text=${waMessage}`;
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });

        if (res.ok) {
          // Show dog-specific success message
          const selectedDog = (document.getElementById('dog_interest') as HTMLSelectElement)?.value;
          if (selectedDog && selectedDog !== 'Not sure yet') {
            const successText = document.getElementById('success-dog-text');
            if (successText) {
              successText.textContent = `We're so excited that you're interested in ${selectedDog}! Here's what happens next.`;
            }
            // Try to show dog photo
            const dogDataEl = document.getElementById('dog-data');
            if (dogDataEl) {
              const dogs = JSON.parse(dogDataEl.textContent || '[]');
              const match = dogs.find((d: any) => d.name === selectedDog);
              if (match) {
                const photoContainer = document.getElementById('success-dog-photo');
                const photoImg = document.getElementById('success-dog-img') as HTMLImageElement;
                if (photoContainer && photoImg) {
                  // Use the first photo from the dog's asset folder via the adopt page
                  photoContainer.classList.remove('hidden');
                  photoImg.alt = `${selectedDog}, a rescue dog at My Paws Bosnia`;
                  // Link to dog's profile
                  const link = document.createElement('a');
                  link.href = `/adopt/${match.slug}`;
                  photoContainer.appendChild(link);
                }
              }
            }
          }
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          throw new Error('Failed');
        }
      } catch {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Application';
        alert('Something went wrong. Please try again or contact us directly on Facebook or WhatsApp.');
      }
    });
  }

  // Pre-select dog from URL param (e.g. /apply?dog=Luna)
  const params = new URLSearchParams(window.location.search);
  const dogParam = params.get('dog');
  if (dogParam) {
    const dogSelect = document.getElementById('dog_interest') as HTMLSelectElement;
    if (dogSelect) {
      for (const opt of dogSelect.options) {
        if (opt.value.toLowerCase() === dogParam.toLowerCase()) {
          opt.selected = true;
          break;
        }
      }
    }
  }
</script>
