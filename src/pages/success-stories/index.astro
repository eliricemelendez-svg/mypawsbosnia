---
import Layout from "../../layouts/Layout.astro";
import DogCard from "../../components/DogCard.astro";
import { successStories } from "../../data/success-stories";
---

<Layout title="Adoption Success Stories | Rescue Dogs Find Homes | My Paws Bosnia" description="Read real adoption success stories from My Paws Bosnia. Rescue dogs from Bosnia finding their forever homes with families across Europe.">
  <!-- Header -->
  <section class="bg-light-bg py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Success stories</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">
        These dogs waited patiently for someone to choose them. Now they have families
        of their own. Every adoption reminds us why we do this.
      </p>
    </div>
  </section>

  <!-- Stories grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {successStories.map((dog) => (
        <DogCard
          slug={dog.slug}
          name={dog.name}
          shortLine={dog.shortLine}
          sex={dog.sex}
          age={dog.age}
          size={dog.size}
          linkPrefix="/success-stories"
          adoptedTo={dog.adoptedDate}
        />
      ))}
    </div>

    {successStories.length === 0 && (
      <div class="text-center py-16">
        <p class="text-6xl mb-4">🐾</p>
        <p class="text-body">Stories coming soon.</p>
      </div>
    )}
  </section>
</Layout>
