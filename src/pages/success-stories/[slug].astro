---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PhotoLightbox from "../../components/PhotoLightbox.astro";
import { successStories } from "../../data/success-stories";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return successStories.map((dog) => ({
    params: { slug: dog.slug },
    props: { dog },
  }));
};

const { dog } = Astro.props;

// Load all photos for this dog
const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/success-stories/**/*.{jpeg,jpg,png}",
  { eager: true }
);

const prefix = `../../assets/success-stories/${dog.slug}/`;
const dogPhotos = Object.entries(allPhotos)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const leadPhoto = dogPhotos[0] ?? null;
const extraPhotos = dogPhotos.slice(1);
---

<Layout
  title={`${dog.name}'s Adoption Story | Rescue Dog Success | My Paws Bosnia`}
  description={`${dog.shortLine} Read how ${dog.name} went from a shelter in Bosnia to a loving home in Europe.`}
  ogImage={leadPhoto?.src}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${dog.name}'s Adoption Story`,
    description: dog.story,
    image: leadPhoto ? new URL(leadPhoto.src, Astro.site ?? "https://mypawsbosnia.org").href : undefined,
    author: { "@type": "Organization", name: "My Paws Bosnia" },
    publisher: { "@type": "Organization", name: "My Paws Bosnia" },
  }}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <a href="/success-stories" class="inline-flex items-center text-teal font-medium hover:underline mb-6">
      &larr; Back to success stories
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-8">
      {leadPhoto ? (
        <button type="button" class="cursor-pointer border-0 p-0 bg-transparent" data-lightbox-trigger="0">
          <Image
            src={leadPhoto}
            alt={`${dog.name}, a rescue dog from Bosnia who found a forever home`}
            width={500}
            class="w-full rounded-2xl hover:opacity-90 transition-opacity"
          />
        </button>
      ) : (
        <div class="aspect-square bg-gray-100 rounded-2xl flex items-center justify-center text-8xl">
          🐕
        </div>
      )}

      <div>
        <h1 class="text-4xl font-bold text-slate-dark">{dog.name}</h1>

        <!-- Adopted badge -->
        <div class="mt-3">
          <span class="inline-flex items-center gap-1.5 bg-green-100 text-green-700 text-sm font-semibold px-4 py-2 rounded-full">
            Adopted &mdash; {dog.adoptedDate}
          </span>
        </div>

        <!-- Vital stats -->
        <div class="flex flex-wrap gap-3 mt-4">
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center">
            <p class="text-xs text-body uppercase tracking-wide">Age</p>
            <p class="text-base font-semibold text-slate-dark mt-1">
              {dog.ageYears ? `${dog.ageYears} years` : dog.age}
            </p>
          </div>
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center">
            <p class="text-xs text-body uppercase tracking-wide">Size</p>
            <p class="text-base font-semibold text-slate-dark mt-1 capitalize">{dog.size}</p>
          </div>
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center">
            <p class="text-xs text-body uppercase tracking-wide">Sex</p>
            <p class="text-base font-semibold text-slate-dark mt-1 capitalize">{dog.sex}</p>
          </div>
        </div>

        {dog.adoptedTo && (
          <div class="bg-light-bg rounded-xl px-5 py-3 mt-3">
            <p class="text-xs text-body uppercase tracking-wide">New home</p>
            <p class="text-base font-semibold text-slate-dark mt-1">{dog.adoptedTo}</p>
          </div>
        )}

        <!-- Story -->
        <div class="mt-6">
          <p class="text-body leading-relaxed">{dog.story}</p>

          {dog.traits && dog.traits.length > 0 && (
            <ul class="mt-4 space-y-2">
              {dog.traits.map((trait) => (
                <li class="flex items-start gap-2 text-body">
                  <span class="text-teal mt-0.5">&#10003;</span>
                  <span>{trait}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>

    <!-- More photos -->
    {extraPhotos.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold text-slate-dark mb-4">More photos</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {extraPhotos.map((photo, i) => (
            <button type="button" class="cursor-pointer border-0 p-0 bg-transparent" data-lightbox-trigger={i + 1}>
              <Image
                src={photo}
                alt={`${dog.name} photo ${i + 2}`}
                width={400}
                height={400}
                class="w-full aspect-square object-cover rounded-xl hover:opacity-90 transition-opacity"
              />
            </button>
          ))}
        </div>
      </div>
    )}

    <PhotoLightbox photos={dogPhotos} name={dog.name} />

    <!-- Happy ending CTA -->
    <div class="mt-12 bg-teal/5 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-slate-dark mb-3">Want to give another dog a happy ending?</h2>
      <p class="text-body mb-6">
        There are still 60 dogs waiting at the shelter. You could be someone's happy ending too.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/adopt"
          class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors"
        >
          Meet our dogs
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61590021437450"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors"
        >
          Message us on Facebook
        </a>
      </div>
    </div>
  </section>
</Layout>
