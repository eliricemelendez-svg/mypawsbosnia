---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact My Paws Bosnia | Adopt a Dog from Bosnia" description="Get in touch with My Paws Bosnia for dog adoptions, sponsorships, and volunteering. Message us on Facebook or email us about rescue dogs available in Europe.">
  <!-- Header -->
  <section class="bg-light-bg py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Contact</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">
        The best way to reach us is through our Facebook page.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Facebook -->
      <div class="bg-light-bg rounded-2xl p-8">
        <div class="text-3xl mb-4">📘</div>
        <h2 class="text-lg font-semibold text-slate-dark mb-2">Facebook</h2>
        <p class="text-body text-sm mb-4">
          Message us directly or follow for daily updates on the dogs.
        </p>
        <a
          href="https://www.facebook.com/profile.php?id=61590021437450"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-2.5 bg-teal text-white font-semibold rounded-full text-sm hover:bg-teal/90 transition-colors"
        >
          Visit our Facebook page
        </a>
      </div>

      <!-- Location -->
      <div class="bg-light-bg rounded-2xl p-8">
        <div class="text-3xl mb-4">📍</div>
        <h2 class="text-lg font-semibold text-slate-dark mb-2">Location</h2>
        <p class="text-body">Brcko, Bosnia &amp; Herzegovina</p>
      </div>
    </div>
  </section>
</Layout>
