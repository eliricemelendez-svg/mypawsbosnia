---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import DonateBlock from "../components/DonateBlock.astro";
import vesnaWithDog from "../assets/vesna/706517929_122100551391334047_1761713277840422103_n.jpg";
import vetBillPhoto from "../assets/vet/hires-vet-bill.jpg";
import passportDog from "../assets/past-rescues/hires-passport-1.jpg";

// Load ALL photos for maximum impact
const foodImports = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/food/*.{jpeg,jpg,png}", { eager: true }
);
const shelterImports = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/shelter/*.{jpeg,jpg,png}", { eager: true }
);
const vetImports = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/vet/*.{jpeg,jpg,png}", { eager: true }
);
const vesnaImports = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/vesna/*.{jpeg,jpg,png}", { eager: true }
);

const allPhotos = [
  ...Object.values(vesnaImports).map((m) => m.default),
  ...Object.values(foodImports).map((m) => m.default),
  ...Object.values(shelterImports).map((m) => m.default),
  ...Object.values(vetImports).map((m) => m.default),
];
---

<Layout title="Donations - My Paws Bosnia" description="Support the dogs with a donation via PayPal.">
  <!-- Header — short, emotional -->
  <section class="bg-light-bg py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Every euro keeps them alive.</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">
        No government funding. No corporate sponsors. Just one family and 60 dogs.
      </p>
    </div>
  </section>

  <!-- PayPal — first thing you see -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <DonateBlock />
  </section>

  <!-- What donations look like — real photos -->
  <section class="bg-light-bg py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-dark text-center mb-3">This is what your donations pay for</h2>
      <p class="text-body text-center mb-10">Real photos from the shelter. Food deliveries, vet visits, daily life with 60 dogs.</p>

      <!-- Trust proof: three key photos -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={vesnaWithDog} alt="Vesna with a shelter dog" width={400} class="w-full aspect-[4/3] object-cover" />
          <div class="p-4">
            <p class="text-sm font-semibold text-slate-dark">Vesna and her daughters</p>
            <p class="text-xs text-body mt-1">Running the shelter every day in Brcko, Bosnia.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={vetBillPhoto} alt="Veterinary bill" width={400} class="w-full aspect-[4/3] object-cover object-top" />
          <div class="p-4">
            <p class="text-sm font-semibold text-slate-dark">Real vet bills</p>
            <!-- TODO: confirm cost details with Vesna -->
            <p class="text-xs text-body mt-1">118 KM (~€60) for one vet visit with treatment.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={passportDog} alt="Dog with pet passport" width={400} class="w-full aspect-[4/3] object-cover" />
          <div class="p-4">
            <p class="text-sm font-semibold text-slate-dark">Ready to travel</p>
            <p class="text-xs text-body mt-1">Dogs get passports and travel to families in Europe.</p>
          </div>
        </div>
      </div>

      <!-- Photo collage — volume shows the scale -->
      <div class="grid grid-cols-4 md:grid-cols-8 gap-1.5">
        {allPhotos.map((photo, i) => (
          <Image
            src={photo}
            alt={`Life at the shelter ${i + 1}`}
            width={120}
            height={120}
            class="w-full aspect-square object-cover rounded-md"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Impact tiers -->
  <!-- TODO: confirm all amounts with Vesna -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-slate-dark text-center mb-8">What your donation does</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-light-bg rounded-2xl p-6 text-center">
        <p class="text-3xl font-bold text-teal">€60</p>
        <p class="text-sm text-body mt-2">One vet visit with treatment</p>
      </div>
      <div class="bg-light-bg rounded-2xl p-6 text-center">
        <p class="text-3xl font-bold text-teal">€25</p>
        <p class="text-sm text-body mt-2">Feeds a dog for a week</p>
      </div>
      <div class="bg-light-bg rounded-2xl p-6 text-center">
        <p class="text-3xl font-bold text-teal">€10</p>
        <p class="text-sm text-body mt-2">Basic medications</p>
      </div>
      <div class="bg-light-bg rounded-2xl p-6 text-center">
        <p class="text-3xl font-bold text-teal">€5</p>
        <p class="text-sm text-body mt-2">Every bit helps</p>
      </div>
    </div>
  </section>

  <!-- Second donate CTA -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <DonateBlock />
  </section>

  <!-- Sponsor -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="bg-slate-dark rounded-2xl p-8 md:p-12 text-center text-white">
      <h2 class="text-2xl font-bold mb-3">Sponsor a dog</h2>
      <p class="text-white/80 mb-2">
        30 of our 60 dogs still do not have a sponsor.
      </p>
      <p class="text-white/80">
        A monthly contribution of any amount helps cover a dog's food and basic vet care.
      </p>
      <a
        href="https://www.facebook.com/profile.php?id=61590021437450"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-6 px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors"
      >
        Contact us on Facebook
      </a>
    </div>
  </section>
</Layout>
