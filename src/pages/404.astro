---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

const lang: Lang = 'en';
const t = useTranslations(lang);
---

<Layout title={t('404.title')} description={t('404.heading')} lang={lang}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-8xl mb-6">🐾</p>
    <h1 class="text-3xl font-bold text-slate-dark mb-4">{t('404.heading')}</h1>
    <p class="text-body text-lg mb-8">{t('404.text')}</p>
    <a
      href="/adopt"
      class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors"
    >
      {t('404.backToAdopt')}
    </a>
  </section>
</Layout>
