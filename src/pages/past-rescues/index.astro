---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

// Load all past rescue photos
const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/past-rescues/*.{jpeg,jpg,png}",
  { eager: true }
);

const photos = Object.entries(allPhotos)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<Layout title="Past Rescues - My Paws Bosnia" description="Dogs we have rescued and rehomed across Europe since 2019.">
  <!-- Header -->
  <section class="bg-light-bg py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Past rescues</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">
        Since 2019, we have been helping dogs find homes. These dogs have been rescued
        from the streets of Bosnia and placed with families across Europe, including
        Switzerland, Germany, and the United Kingdom.
      </p>
    </div>
  </section>

  <!-- Photo gallery -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {photos.length > 0 ? (
      <div class="grid grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2">
        {photos.map((photo, i) => (
          <Image
            src={photo}
            alt={`Rescued dog ${i + 1}`}
            width={200}
            height={200}
            class="w-full aspect-square object-cover rounded-lg"
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-6xl mb-4">📸</p>
        <p class="text-body">Photos coming soon.</p>
      </div>
    )}
  </section>
</Layout>
