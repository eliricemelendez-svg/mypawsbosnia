---
import { currentDogs } from "../../data/current-dogs";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return currentDogs.map((dog) => ({
    params: { dog: dog.slug },
  }));
};

const { dog } = Astro.params;
const matched = currentDogs.find((d) => d.slug === dog);
const dogName = matched?.name ?? dog;
const redirectUrl = `/apply?dog=${encodeURIComponent(dogName)}`;
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
  <title>Apply to Adopt {dogName}</title>
  <script define:vars={{ redirectUrl }}>
    window.location.replace(redirectUrl);
  </script>
</head>
<body>
  <p>Redirecting to application...</p>
</body>
</html>
