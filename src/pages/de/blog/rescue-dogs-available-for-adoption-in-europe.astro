---
import Layout from "../../../layouts/Layout.astro";
import { currentDogs } from "../../../data/current-dogs";
import { successStories } from "../../../data/success-stories";

const title = "Rettungshunde zur Adoption in Europa verfügbar | My Paws Bosnia";
const description = "Rettungshunde zur Adoption in ganz Europa, Großbritannien und der Schweiz. Vollständig tierärztlich versorgt, geimpft und mit EU-Heimtierausweis. Hunde ansehen und noch heute adoptieren.";

const dogCount = currentDogs.length;
const adoptedCount = successStories.length;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Rettungshunde zur Adoption in Europa verfügbar",
  description,
  author: { "@type": "Organization", name: "My Paws Bosnia" },
  publisher: { "@type": "Organization", name: "My Paws Bosnia" },
  mainEntityOfPage: "https://mypawsbosnia.org/de/blog/rescue-dogs-available-for-adoption-in-europe",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Wohin können diese Rettungshunde adoptiert werden?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Unsere Hunde können in jedes EU-Land, nach Großbritannien und in die Schweiz reisen. Wir haben Hunde nach England, Belgien, Österreich, Deutschland, in die Niederlande und nach Frankreich vermittelt."
      }
    },
    {
      "@type": "Question",
      name: "Sind diese Hunde kinderfreundlich?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Die meisten unserer Hunde verstehen sich gut mit Kindern. Das Profil jedes Hundes enthält spezifische Informationen über sein Verhalten gegenüber Kindern. Wir vermitteln Hunde immer basierend auf der häuslichen Umgebung an passende Familien."
      }
    },
    {
      "@type": "Question",
      name: "Welche Rassen sind verfügbar?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Unsere Hunde sind Mischlinge. Häufige Mischungen sind Labrador, Schäferhund, Spaniel-Setter, Retriever-Spitz und Terrier-Kreuzungen. Mischlinge haben in der Regel weniger erblich bedingte Gesundheitsprobleme und eine höhere Lebenserwartung als Rassehunde."
      }
    },
    {
      "@type": "Question",
      name: "Woher weiß ich, dass diese Hunde gesund sind?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Jeder Hund wird von einem Tierarzt untersucht, geimpft (einschließlich Tollwut), kastriert oder sterilisiert, entwurmt, gegen Parasiten behandelt und gechipt, bevor er reist. Blutuntersuchungen auf Brucellose und andere Erkrankungen sind auf Anfrage möglich."
      }
    },
  ],
};
---

<Layout title={title} description={description} lang="de" jsonLd={[articleSchema, faqSchema]}>
  <!-- Hero -->
  <section class="bg-light-bg py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-teal uppercase tracking-wide mb-3">Einen Rettungshund adoptieren</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-dark leading-tight">Rettungshunde zur Adoption in Europa verfügbar</h1>
      <p class="text-lg text-body mt-4 leading-relaxed">
        {dogCount} Rettungshunde in unserem Tierheim in Bosnien sind bereit, zu Familien in ganz Europa, Großbritannien und der Schweiz zu reisen. Jeder Hund ist vollständig tierärztlich versorgt, geimpft und hat einen Heimtierausweis.
      </p>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Die Situation -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Die Situation der Rettungshunde in Bosnien</h2>
      <p class="text-body leading-relaxed mb-4">
        Bosnien hat Zehntausende streunende Hunde. Es gibt kein nationales Kastrationsprogramm, und öffentliche Tierheime sind stark unterfinanziert. Hunde in städtischen Tierheimen leiden unter Überfüllung, Krankheiten und in vielen Fällen Einschläferung.
      </p>
      <p class="text-body leading-relaxed">
        My Paws Bosnia (Moje Sape) ist ein privates Rettungstierheim in Brcko, das von Vesna und ihrer Familie seit 2019 betrieben wird. Wir retten Hunde von der Straße und aus öffentlichen Tierheimen, sorgen für vollständige tierärztliche Versorgung und finden ihnen dauerhafte Zuhause in ganz Europa. Bisher haben wir {adoptedCount} Hunde in Familien vermittelt, und {dogCount} weitere warten aktuell.
      </p>
    </section>

    <!-- Warum diese Hunde großartige Haustiere sind -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Warum diese Hunde großartige Haustiere sind</h2>
      <div class="space-y-4">
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Sozialisiert und menschenfreundlich</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Unsere Hunde leben gemeinsam im Tierheim mit täglichem Menschenkontakt. Sie sind an Menschen, andere Hunde und in vielen Fällen auch an Kinder und Katzen gewöhnt. Es sind keine verwilderten Tiere.
          </p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Vollständig tierärztlich versorgt vor der Reise</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Jeder Hund wird kastriert/sterilisiert, geimpft (einschließlich Tollwut), entwurmt, gegen Parasiten behandelt, gechipt und erhält einen Heimtierausweis. Blutuntersuchungen auf Brucellose sind auf Anfrage möglich.
          </p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Temperament bewertet</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Vesna kennt jeden Hund persönlich. Sie kann dir genau sagen, wie er sich gegenüber Kindern, Katzen, anderen Hunden und Fremden verhält. Wir vermitteln Hunde an Familien basierend auf täglicher Beobachtung, nicht auf Vermutungen.
          </p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <h3 class="font-semibold text-slate-dark">Mischlinge mit weniger Gesundheitsproblemen</h3>
          <p class="text-body mt-1 text-sm leading-relaxed">
            Unsere Hunde sind Mischlinge. Häufige Mischungen sind Labrador, Schäferhund, Spaniel-Setter, Retriever-Spitz und Terrier-Kreuzungen. Mischlinge haben in der Regel weniger erblich bedingte Gesundheitsprobleme und eine höhere Lebenserwartung als Rassehunde.
          </p>
        </div>
      </div>
    </section>

    <!-- Wohin sie reisen können -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Wohin unsere Hunde reisen können</h2>
      <p class="text-body leading-relaxed mb-4">
        Wir organisieren lizenzierten Tiertransport von Bosnien direkt zu dir nach Hause. Unsere Hunde wurden adoptiert nach:
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Großbritannien</p>
          <p class="text-xs text-body mt-1">~&pound;500 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Deutschland</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Niederlande</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Belgien</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Österreich</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Schweiz</p>
          <p class="text-xs text-body mt-1">CHF&nbsp;500&ndash;550 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center">
          <p class="font-semibold text-slate-dark text-sm">Frankreich</p>
          <p class="text-xs text-body mt-1">&euro;300&ndash;400 Transport</p>
        </div>
        <div class="bg-light-bg rounded-lg px-4 py-3 text-center col-span-2 sm:col-span-2">
          <p class="font-semibold text-slate-dark text-sm">Jedes andere EU-Land</p>
          <p class="text-xs text-body mt-1">Kontaktiere uns für ein Angebot</p>
        </div>
      </div>
      <p class="text-sm text-body mt-4">Es gibt keine Adoptionsgebühr. Du zahlst nur die Transportkosten.</p>
    </section>

    <!-- Aktuell verfügbare Hunde -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Aktuell verfügbare Hunde</h2>
      <p class="text-body leading-relaxed mb-6">
        Jeder der folgenden Hunde befindet sich in unserem Tierheim in Brcko, Bosnien. Sie sind tierärztlich versorgt, gesund und reisebereit.
      </p>
      <div class="space-y-4">
        {currentDogs.map((dog) => (
          <a href={`/de/adopt/${dog.slug}`} class="block bg-white border border-gray-100 rounded-xl p-5 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-semibold text-slate-dark text-lg">{dog.name}</h3>
                <p class="text-body mt-1 leading-relaxed">{dog.shortLine}</p>
                <div class="flex flex-wrap gap-2 mt-3">
                  <span class="inline-block bg-teal/10 text-teal text-xs font-medium px-3 py-1 rounded-full">
                    {dog.sex === 'male' ? 'Rüde' : 'Hündin'}
                  </span>
                  <span class="inline-block bg-teal/10 text-teal text-xs font-medium px-3 py-1 rounded-full">
                    {dog.age === 'puppy' ? 'Welpe' : dog.age === 'young' ? 'Jung' : dog.age === 'adult' ? 'Erwachsen' : 'Senior'}
                  </span>
                  <span class="inline-block bg-teal/10 text-teal text-xs font-medium px-3 py-1 rounded-full">
                    {dog.size === 'small' ? 'Klein' : dog.size === 'medium' ? 'Mittel' : 'Groß'}
                  </span>
                </div>
              </div>
              <span class="text-teal text-sm font-medium whitespace-nowrap">Profil ansehen &rarr;</span>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/de/adopt" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">
          Alle {dogCount} Hunde ansehen
        </a>
      </div>
    </section>

    <!-- Erfolgreiche Adoptionen -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">Kürzlich erfolgreiche Adoptionen</h2>
      <p class="text-body leading-relaxed mb-6">
        Diese Hunde waren im selben Tierheim. Sie haben denselben Prozess durchlaufen und sind jetzt bei ihren Familien angekommen.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {successStories.map((story) => (
          <a href={`/de/success-stories/${story.slug}`} class="block bg-light-bg rounded-xl p-5 hover:shadow-md transition-shadow">
            <h3 class="font-semibold text-slate-dark">{story.name}</h3>
            {story.adoptedTo && <p class="text-xs text-teal font-medium mt-1">Adoptiert nach {story.adoptedTo}</p>}
            <p class="text-sm text-body mt-2">{story.shortLine}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- So funktioniert die Adoption -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-4">So funktioniert die Adoption</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">1</p>
          <h3 class="font-semibold text-slate-dark mt-1">Schreib uns</h3>
          <p class="text-sm text-body mt-1">Sende uns eine Nachricht auf Facebook oder WhatsApp. Sag uns, welcher Hund dich interessiert und erzähle uns von deinem Zuhause.</p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">2</p>
          <h3 class="font-semibold text-slate-dark mt-1">Hausprüfung</h3>
          <p class="text-sm text-body mt-1">Wir führen eine unkomplizierte Hausprüfung durch. In Großbritannien ist das normalerweise ein Videogespräch. In Deutschland und Österreich wird es sehr wahrscheinlich ein persönlicher Besuch sein.</p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">3</p>
          <h3 class="font-semibold text-slate-dark mt-1">Tierarzt und Ausweis</h3>
          <p class="text-sm text-body mt-1">Wir erledigen alle Impfungen, Kastration, Entwurmung und stellen den Heimtierausweis aus.</p>
        </div>
        <div class="bg-light-bg rounded-xl p-5">
          <p class="text-teal font-bold text-lg">4</p>
          <h3 class="font-semibold text-slate-dark mt-1">Transport zu dir</h3>
          <p class="text-sm text-body mt-1">Ein lizenzierter Transporter bringt deinen Hund direkt zu dir nach Hause. Der gesamte Prozess dauert 4 bis 8 Wochen.</p>
        </div>
      </div>
      <p class="text-sm text-body mt-4">
        Die vollständige Schritt-für-Schritt-Anleitung findest du in unserem <a href="/de/blog/how-to-adopt-a-dog-from-bosnia" class="text-teal font-medium hover:underline">Adoptionsleitfaden</a>.
      </p>
    </section>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-dark mb-6">Häufig gestellte Fragen</h2>
      <div class="space-y-4">
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Wohin können diese Rettungshunde adoptiert werden?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Unsere Hunde können in jedes EU-Land, nach Großbritannien und in die Schweiz reisen. Wir haben Hunde nach England, Belgien, Österreich, Deutschland, in die Niederlande und nach Frankreich vermittelt.
          </div>
        </details>
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Sind diese Hunde kinderfreundlich?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Die meisten unserer Hunde verstehen sich gut mit Kindern. Das Profil jedes Hundes enthält spezifische Informationen über sein Verhalten gegenüber Kindern. Wir vermitteln Hunde immer basierend auf der häuslichen Umgebung an passende Familien.
          </div>
        </details>
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Welche Rassen sind verfügbar?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Unsere Hunde sind Mischlinge. Häufige Mischungen sind Labrador, Schäferhund, Spaniel-Setter, Retriever-Spitz und Terrier-Kreuzungen. Mischlinge haben in der Regel weniger erblich bedingte Gesundheitsprobleme und eine höhere Lebenserwartung als Rassehunde.
          </div>
        </details>
        <details class="group border border-gray-100 rounded-xl">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-slate-dark">
            Woher weiß ich, dass diese Hunde gesund sind?
            <span class="text-teal text-xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-4 text-body leading-relaxed">
            Jeder Hund wird von einem Tierarzt untersucht, geimpft (einschließlich Tollwut), kastriert oder sterilisiert, entwurmt, gegen Parasiten behandelt, gechipt und erhält einen Heimtierausweis vor der Reise. Blutuntersuchungen auf Brucellose und andere Erkrankungen sind auf Anfrage möglich.
          </div>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-light-bg rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-slate-dark mb-3">Starte den Adoptionsprozess</h2>
      <p class="text-body mb-6">Schreib uns und sag uns, welcher Hund dich interessiert. Wir begleiten dich bei jedem Schritt.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">
          Schreib uns auf Facebook
        </a>
        <a href="/de/adopt" class="inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors">
          Alle Hunde ansehen
        </a>
      </div>
    </section>

  </article>
</Layout>
