---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

const lang: Lang = 'de';
const t = useTranslations(lang);

const foodImports = import.meta.glob<{ default: ImageMetadata }>("../../assets/food/*.{jpeg,jpg,png}", { eager: true });
const vetImports = import.meta.glob<{ default: ImageMetadata }>("../../assets/vet/*.{jpeg,jpg,png}", { eager: true });
const shelterImports = import.meta.glob<{ default: ImageMetadata }>("../../assets/shelter/*.{jpeg,jpg,png}", { eager: true });

const foodPhotos = Object.values(foodImports).map((m) => m.default);
const vetPhotos = Object.values(vetImports).map((m) => m.default);
const shelterPhotos = Object.values(shelterImports).map((m) => m.default);
---

<Layout title={t('impact.title')} description={t('impact.description')} lang={lang}>
  <section class="bg-light-bg py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">{t('impact.heading')}</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">{t('impact.subtitle')}</p>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-bold text-slate-dark mb-2">{t('impact.foodTitle')}</h2>
    <p class="text-body mb-8">{t('impact.foodText')}</p>
    {foodPhotos.length > 0 ? (<div class="grid grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2">{foodPhotos.map((photo) => (<Image src={photo} alt="Futterlieferung f\u00fcr das Tierheim in Bosnien" width={200} height={200} class="w-full aspect-square object-cover rounded-lg" />))}</div>) : (<div class="text-center py-12 bg-light-bg rounded-2xl"><p class="text-4xl mb-2">📸</p><p class="text-body">{t('impact.photosComing')}</p></div>)}
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-100">
    <h2 class="text-2xl font-bold text-slate-dark mb-2">{t('impact.vetTitle')}</h2>
    <p class="text-body mb-8">{t('impact.vetText')}</p>
    {vetPhotos.length > 0 ? (<div class="grid grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2">{vetPhotos.map((photo) => (<Image src={photo} alt="Tierarztversorgung f\u00fcr Rettungshunde" width={200} height={200} class="w-full aspect-square object-cover rounded-lg" />))}</div>) : (<div class="text-center py-12 bg-light-bg rounded-2xl"><p class="text-4xl mb-2">📸</p><p class="text-body">{t('impact.photosComing')}</p></div>)}
  </section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-gray-100">
    <h2 class="text-2xl font-bold text-slate-dark mb-2">{t('impact.shelterTitle')}</h2>
    <p class="text-body mb-8">{t('impact.shelterText')}</p>
    {shelterPhotos.length > 0 ? (<div class="grid grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2">{shelterPhotos.map((photo) => (<Image src={photo} alt="Tierheim in Br\u010dko, Bosnien" width={200} height={200} class="w-full aspect-square object-cover rounded-lg" />))}</div>) : (<div class="text-center py-12 bg-light-bg rounded-2xl"><p class="text-4xl mb-2">📸</p><p class="text-body">{t('impact.photosComing')}</p></div>)}
  </section>
</Layout>
