---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { currentDogs } from "../../data/current-dogs";

const dogNames = currentDogs.map((d) => d.name);

// Build photo data for each dog
const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/current-dogs/**/*.{jpeg,jpg,png}",
  { eager: true }
);

const dogPhotoData = currentDogs.map((dog) => {
  const prefix = `../../assets/current-dogs/${dog.slug}/`;
  const photos = Object.entries(allPhotos)
    .filter(([path]) => path.startsWith(prefix))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
  return { name: dog.name, slug: dog.slug, shortLine: dog.shortLine, photos };
});
---

<Layout title="Adoptionsantrag | My Paws Bosnia" description="Fülle unser Adoptionsformular aus. Wir prüfen jeden Antrag und antworten in der Regel innerhalb weniger Tage." lang="de">
  <section class="bg-light-bg py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">Adoptionsantrag stellen</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">Wähle deinen Hund aus und erzähle uns ein bisschen über dich. Wir prüfen jeden Antrag und melden uns in der Regel innerhalb weniger Tage.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <form id="adopt-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="82e1cf41-2872-4b2a-92e3-8d373b609503" />
      <input type="hidden" name="subject" value="New Adoption Application - My Paws Bosnia" />
      <input type="hidden" name="from_name" value="My Paws Bosnia Adoption Form" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
      <input type="hidden" id="whatsapp_link" name="WhatsApp Link (click to chat)" value="" />

      <!-- STEP 1: Choose your dog -->
      <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100 mb-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">Für welchen Hund interessierst du dich?</h2>
        </div>

        <!-- Dog selection grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3" id="dog-selector">
          {dogPhotoData.map((dog) => (
            <button
              type="button"
              class="dog-select-btn group relative rounded-xl overflow-hidden border-2 border-gray-100 hover:border-teal transition-all text-left"
              data-dog={dog.name}
              data-slug={dog.slug}
            >
              {dog.photos[0] && (
                <Image
                  src={dog.photos[0]}
                  alt={dog.name}
                  width={300}
                  class="w-full aspect-square object-cover object-top"
                />
              )}
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-3">
                <span class="text-white font-semibold text-sm">{dog.name}</span>
              </div>
            </button>
          ))}
          <button
            type="button"
            class="dog-select-btn flex items-center justify-center rounded-xl border-2 border-gray-100 hover:border-teal transition-all aspect-square bg-light-bg"
            data-dog="Not sure yet"
            data-slug=""
          >
            <div class="text-center p-3">
              <div class="text-3xl mb-2">🐾</div>
              <span class="text-sm text-body font-medium">Noch nicht sicher</span>
            </div>
          </button>
        </div>

        <!-- Collapsed state (shown after selection) -->
        <div id="dog-selected-bar" class="hidden flex items-center justify-between bg-light-bg rounded-xl p-4">
          <div class="flex items-center gap-3">
            <img id="selected-dog-thumb" src="" alt="" class="w-12 h-12 rounded-full object-cover" />
            <div>
              <p class="font-semibold text-slate-dark" id="selected-dog-name-text"></p>
              <p class="text-xs text-body">Für Adoption ausgewählt</p>
            </div>
          </div>
          <button type="button" id="change-dog-bar-btn" class="text-sm text-teal font-medium hover:underline">Ändern</button>
        </div>

        <input type="hidden" id="dog_interest" name="dog_interest" value="" required />
        <p id="dog-select-error" class="text-red-500 text-sm mt-2 hidden">Bitte wähle einen Hund aus, um fortzufahren.</p>
      </div>

      <!-- Photo data for JS -->
      {dogPhotoData.map((dog) => (
        <template data-dog-photos={dog.name}>
          {dog.photos.map((photo, i) => (
            <img src={photo.src} data-width={photo.width} data-height={photo.height} alt={`${dog.name} photo ${i + 1}`} />
          ))}
        </template>
      ))}
      <script id="dog-info" type="application/json" set:html={JSON.stringify(
        dogPhotoData.map(d => ({ name: d.name, slug: d.slug, shortLine: d.shortLine, photoCount: d.photos.length }))
      )} />

      <!-- TWO-COLUMN LAYOUT: Dog on left, form on right (hidden until dog selected) -->
      <div id="form-fields" class="hidden">
        <div class="flex flex-col lg:flex-row gap-8">

          <!-- LEFT: Dog showcase (sticky on desktop) -->
          <div id="dog-showcase" class="lg:w-5/12">
            <div class="lg:sticky lg:top-24">
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <!-- Photo carousel -->
                <div class="relative">
                  <div class="aspect-square relative overflow-hidden" id="showcase-carousel">
                    <div class="flex h-full transition-transform duration-300 ease-in-out" id="showcase-track">
                      <!-- Photos injected by JS -->
                    </div>
                    <button type="button" id="showcase-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8249;</button>
                    <button type="button" id="showcase-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8250;</button>
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="showcase-dots"></div>
                  </div>
                </div>
                <!-- Dog info -->
                <div class="p-5">
                  <h3 id="showcase-name" class="text-2xl font-bold text-slate-dark"></h3>
                  <p id="showcase-line" class="text-body mt-2 text-sm"></p>
                  <div class="mt-3 flex items-center gap-4">
                    <a id="showcase-profile-link" href="#" class="text-teal font-medium hover:underline text-sm">Vollständiges Profil ansehen &rarr;</a>
                    <button type="button" id="change-dog-btn" class="text-sm text-body hover:text-teal transition-colors underline">Hund ändern</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT: Form fields -->
          <div class="lg:w-7/12 space-y-8">

        <!-- About You -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Über dich</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-body mb-2">Vollständiger Name *</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-body mb-2">E-Mail-Adresse *</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-body mb-2">Telefonnummer (mit Landesvorwahl) *</label>
              <input type="tel" id="phone" name="phone" required placeholder="+49 170 1234567" pattern="[\+\d\s\-\(\)]{7,20}" inputmode="tel" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="country" class="block text-sm font-medium text-body mb-2">Land *</label>
                <select id="country" name="country" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                  <option value="">Auswählen...</option>
                  <option value="United Kingdom">Vereinigtes Königreich</option>
                  <option value="Germany">Deutschland</option>
                  <option value="Switzerland">Schweiz</option>
                  <option value="Netherlands">Niederlande</option>
                  <option value="Belgium">Belgien</option>
                  <option value="France">Frankreich</option>
                  <option value="Austria">Österreich</option>
                  <option value="Ireland">Irland</option>
                  <option value="Denmark">Dänemark</option>
                  <option value="Sweden">Schweden</option>
                  <option value="Norway">Norwegen</option>
                  <option value="Italy">Italien</option>
                  <option value="Spain">Spanien</option>
                  <option value="Other">Anderes</option>
                </select>
              </div>
              <div>
                <label for="city" class="block text-sm font-medium text-body mb-2">Stadt *</label>
                <input type="text" id="city" name="city" required list="city-list" autocomplete="address-level2" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
                <datalist id="city-list">
                  <option value="London" /><option value="Manchester" /><option value="Birmingham" /><option value="Leeds" /><option value="Liverpool" /><option value="Bristol" /><option value="Edinburgh" /><option value="Glasgow" /><option value="Cardiff" /><option value="Belfast" />
                  <option value="Berlin" /><option value="Munich" /><option value="Hamburg" /><option value="Frankfurt" /><option value="Cologne" /><option value="Stuttgart" /><option value="Düsseldorf" /><option value="Leipzig" /><option value="Dortmund" /><option value="Dresden" />
                  <option value="Zurich" /><option value="Geneva" /><option value="Basel" /><option value="Bern" /><option value="Lausanne" />
                  <option value="Amsterdam" /><option value="Rotterdam" /><option value="The Hague" /><option value="Utrecht" /><option value="Eindhoven" />
                  <option value="Brussels" /><option value="Antwerp" /><option value="Ghent" /><option value="Bruges" /><option value="Liège" />
                  <option value="Paris" /><option value="Lyon" /><option value="Marseille" /><option value="Toulouse" /><option value="Nice" /><option value="Strasbourg" /><option value="Bordeaux" />
                  <option value="Vienna" /><option value="Graz" /><option value="Salzburg" /><option value="Innsbruck" />
                  <option value="Dublin" /><option value="Cork" /><option value="Galway" />
                  <option value="Copenhagen" /><option value="Stockholm" /><option value="Oslo" /><option value="Milan" /><option value="Rome" /><option value="Madrid" /><option value="Barcelona" />
                </datalist>
              </div>
            </div>
          </div>
        </div>

        <!-- Your Home -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Dein Zuhause</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="home_type" class="block text-sm font-medium text-body mb-2">Wohnst du in einem Haus oder einer Wohnung? *</label>
              <select id="home_type" name="home_type" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="House">Haus</option>
                <option value="Apartment">Wohnung</option>
                <option value="Farm / Rural property">Bauernhof / Ländliches Grundstück</option>
                <option value="Other">Anderes</option>
              </select>
            </div>
            <div>
              <label for="garden" class="block text-sm font-medium text-body mb-2">Hast du einen Garten oder Hof? *</label>
              <select id="garden" name="garden" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Yes">Ja</option>
                <option value="No">Nein</option>
              </select>
            </div>
            <div id="fence-row" class="hidden">
              <label for="fence_height" class="block text-sm font-medium text-body mb-2">Wie hoch ist der Zaun ungefähr?</label>
              <select id="fence_height" name="fence_height" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Under 1 metre">Unter 1 Meter</option>
                <option value="1 - 1.5 metres">1 - 1,5 Meter</option>
                <option value="1.5 - 2 metres">1,5 - 2 Meter</option>
                <option value="Over 2 metres">Über 2 Meter</option>
                <option value="Not sure">Nicht sicher</option>
              </select>
              <p class="text-xs text-body mt-1">Eine grobe Schätzung reicht. Wir können das beim Hausbesuch überprüfen.</p>
            </div>
            <div>
              <label for="own_rent" class="block text-sm font-medium text-body mb-2">Bist du Eigentümer oder Mieter? *</label>
              <select id="own_rent" name="own_rent" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Own">Eigentum</option>
                <option value="Rent - landlord allows dogs">Miete - Vermieter erlaubt Hunde</option>
                <option value="Rent - need to check with landlord">Miete - muss mit Vermieter klären</option>
              </select>
            </div>
            <div>
              <p class="text-base font-medium text-slate-dark mb-2">Wer lebt in deinem Haushalt? *</p>
              <div class="flex flex-wrap gap-2 mb-3" id="household-bubbles">
                <button type="button" data-person="Partner / Spouse" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Partner/in</button>
                <button type="button" data-person="Children" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Kinder</button>
                <button type="button" data-person="Flatmates" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Mitbewohner</button>
                <button type="button" data-person="Grandparents" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Großeltern</button>
                <button type="button" data-person="Other" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Andere</button>
              </div>
              <div id="household-counts" class="space-y-3"></div>
              <input type="hidden" id="household_types" name="household" value="Just me" />
              <div id="household-children-ages" class="hidden mt-3">
                <label for="children_ages" class="block text-sm font-medium text-body mb-2">Alter der Kinder</label>
                <input type="text" id="children_ages" name="children_ages" placeholder="z.B. 4, 7, 12" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <div class="mt-3">
                <label for="household_extra" class="block text-sm font-medium text-body mb-2">Weitere Details?</label>
                <input type="text" id="household_extra" name="household_extra" placeholder="z.B. mein Partner arbeitet von zu Hause" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <p class="text-xs text-body mt-1">Wähle alle zutreffenden aus. Wenn du allein lebst, lass sie einfach nicht ausgewählt.</p>
            </div>
          </div>
        </div>

        <!-- Pets & Experience -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Haustiere & Erfahrung</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="dog_experience" class="block text-sm font-medium text-body mb-2">Hattest du schon mal einen Hund? *</label>
              <select id="dog_experience" name="dog_experience" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Yes">Ja</option>
                <option value="No, first time">Nein, das wäre mein erster Hund</option>
              </select>
              <p class="text-xs text-body mt-1">Erstmalige Hundebesitzer sind willkommen. Wir helfen dir gerne.</p>
            </div>
            <div id="rescue-row" class="hidden">
              <label for="was_rescue" class="block text-sm font-medium text-body mb-2">War dein Hund aus dem Tierschutz?</label>
              <select id="was_rescue" name="was_rescue" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Yes">Ja</option>
                <option value="No">Nein</option>
              </select>
            </div>
            <div>
              <label for="daily_routine" class="block text-sm font-medium text-body mb-2">Wie sieht ein typischer Tag bei dir aus? *</label>
              <select id="daily_routine" name="daily_routine" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Work from home">Ich arbeite von zu Hause</option>
                <option value="Work outside (full-time)">Ich arbeite außer Haus (Vollzeit)</option>
                <option value="Work outside (part-time)">Ich arbeite außer Haus (Teilzeit)</option>
                <option value="Retired">Ich bin im Ruhestand</option>
                <option value="Student">Ich bin Student/Studentin</option>
                <option value="Stay-at-home parent">Ich bin zu Hause bei den Kindern</option>
                <option value="Other">Sonstiges</option>
              </select>
            </div>
            <div>
              <label for="has_pets" class="block text-sm font-medium text-body mb-2">Hast du derzeit Haustiere? *</label>
              <select id="has_pets" name="has_pets" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Yes">Ja</option>
                <option value="No">Nein</option>
              </select>
            </div>
            <div id="pets-detail" class="hidden space-y-4">
              <div>
                <p class="text-base font-medium text-slate-dark mb-2">Welche Haustiere hast du?</p>
                <div class="flex flex-wrap gap-2" id="pet-bubbles">
                  <button type="button" data-pet="Dogs" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Hunde</button>
                  <button type="button" data-pet="Cats" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Katzen</button>
                  <button type="button" data-pet="Rabbits" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Kaninchen</button>
                  <button type="button" data-pet="Birds" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Vögel</button>
                  <button type="button" data-pet="Fish" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Fische</button>
                  <button type="button" data-pet="Other" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">Andere</button>
                </div>
                <input type="hidden" id="pet_types" name="pet_types" />
              </div>
              <div id="pet-counts" class="space-y-3"></div>
              <div>
                <label for="pets_extra" class="block text-sm font-medium text-body mb-2">Weitere Details? (Alter, Rassen usw.)</label>
                <input type="text" id="pets_extra" name="pets_extra" placeholder="z.B. Labrador, 5 Jahre alt, sehr freundlich" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
            </div>
          </div>
        </div>

        <!-- Final details -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">Noch ein paar Details</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="hours_alone" class="block text-sm font-medium text-body mb-2">Wie viele Stunden am Tag wird der Hund allein sein? *</label>
              <select id="hours_alone" name="hours_alone" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="0-2 hours">0-2 Stunden</option>
                <option value="2-4 hours">2-4 Stunden</option>
                <option value="4-6 hours">4-6 Stunden</option>
                <option value="6-8 hours">6-8 Stunden</option>
                <option value="8+ hours">8+ Stunden</option>
              </select>
            </div>
            <div>
              <label for="sleep" class="block text-sm font-medium text-body mb-2">Wo wird der Hund schlafen?</label>
              <input type="text" id="sleep" name="sleep" placeholder="z.B. im Wohnzimmer, in unserem Schlafzimmer" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="home_check" class="block text-sm font-medium text-body mb-2">Bist du bereit für einen Hausbesuch? *</label>
              <select id="home_check" name="home_check" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">Auswählen...</option>
                <option value="Yes">Ja</option>
                <option value="No">Nein</option>
              </select>
              <p class="text-xs text-body mt-1">In Deutschland und Österreich findet der Hausbesuch in der Regel persönlich statt. In Großbritannien ist es meistens ein Videoanruf. So oder so ist es ein kurzes, freundliches Gespräch.</p>
            </div>
            <div>
              <label for="questions" class="block text-sm font-medium text-body mb-2">Hast du Fragen zum Hund?</label>
              <textarea id="questions" name="questions" rows="3" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent resize-y"></textarea>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-body mb-2">Möchtest du uns noch etwas mitteilen?</label>
              <textarea id="message" name="message" rows="3" placeholder="Erzähle uns von dir, deinem Lebensstil oder warum du dich für diesen Hund interessierst..." class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent resize-y"></textarea>
            </div>
          </div>
        </div>

        <!-- Success stories -->
        <div class="bg-light-bg rounded-2xl p-6 text-center">
          <p class="text-body mb-2">Im Laufe der Jahre haben wir Hunden wie Bridgette, Nero, Flint und vielen anderen geholfen, liebevolle Familien in ganz Europa zu finden.</p>
          <a href="/de/success-stories" class="text-teal font-medium hover:underline">Ihre Geschichten ansehen &rarr;</a>
        </div>

        <!-- Submit -->
        <div class="text-center pt-2">
          <button type="submit" id="submit-btn" class="inline-block px-10 py-3.5 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors text-base shadow-md hover:shadow-lg">Antrag absenden</button>
          <p class="text-xs text-body mt-3">Wir prüfen jeden Antrag und melden uns innerhalb weniger Tage.</p>
        </div>

        <!-- FAQ -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <h2 class="text-xl font-semibold text-slate-dark mb-4">Häufig gestellte Fragen</h2>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">Was passiert, nachdem ich mich beworben habe?</summary>
            <p class="pb-4 text-body text-sm">Wir prüfen deinen Antrag und kontaktieren dich innerhalb von 24 Stunden per WhatsApp. Danach vereinbaren wir einen Hausbesuch und besprechen die nächsten Schritte.</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">Was ist der Hausbesuch?</summary>
            <p class="pb-4 text-body text-sm">In Deutschland und Österreich findet der Hausbesuch in der Regel persönlich statt. In Großbritannien ist es meistens ein Videoanruf. Keine Sorge, es ist ein kurzes, freundliches Gespräch.</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">Wie lange dauert der Transport?</summary>
            <p class="pb-4 text-body text-sm">Es dauert in der Regel etwa einen Monat, um den Transport zu organisieren und den Hund reisefertig zu machen. Dies kann je nach Jahreszeit und Auslastung variieren.</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">Was ist beim Hund inbegriffen?</summary>
            <p class="pb-4 text-body text-sm">Jeder Hund kommt geimpft, gechipt, entwurmt und mit einem Heimtierausweis. Ältere Hunde werden in der Regel vor der Reise kastriert. Welpen sind aufgrund ihres Alters möglicherweise noch nicht kastriert.</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">Gibt es eine Adoptionsgebühr?</summary>
            <p class="pb-4 text-body text-sm">Es gibt keine Adoptionsgebühr. Du übernimmst nur die Transportkosten: ca. &pound;500 nach Großbritannien, &euro;300-400 innerhalb Europas oder CHF 500-550 in die Schweiz.</p>
          </details>
          <details>
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">Kann ich adoptieren, wenn ich noch nie einen Hund hatte?</summary>
            <p class="pb-4 text-body text-sm">Auf jeden Fall! Erstmalige Hundebesitzer sind willkommen. Wir unterstützen dich während des gesamten Prozesses und helfen dir, dich auf dein neues Familienmitglied vorzubereiten.</p>
          </details>
        </div>

          </div><!-- end right column -->
        </div><!-- end flex row -->
      </div><!-- end form-fields -->
    </form>

    <!-- Success message -->
    <div id="success-msg" class="hidden py-16">
      <div class="bg-white rounded-2xl p-8 md:p-12 shadow-sm border border-gray-100 text-center">
        <div class="text-5xl mb-4">🐾</div>
        <h2 class="text-2xl font-bold text-slate-dark mb-2">Vielen Dank für deinen Antrag!</h2>
        <p class="text-lg text-body mb-6" id="success-dog-text">Wir freuen uns sehr, dass du einem Rettungshund ein liebevolles Zuhause geben möchtest.</p>

        <!-- Dog photos on success screen -->
        <div id="success-photos" class="hidden mb-8">
          <div class="relative rounded-2xl overflow-hidden max-w-md mx-auto">
            <div class="aspect-square relative overflow-hidden" id="success-carousel">
              <div class="flex h-full transition-transform duration-300 ease-in-out" id="success-track"></div>
              <button type="button" id="success-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8249;</button>
              <button type="button" id="success-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8250;</button>
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="success-dots"></div>
            </div>
          </div>
        </div>

        <div class="bg-light-bg rounded-xl p-6 mb-8 text-left max-w-md mx-auto">
          <h3 class="font-semibold text-slate-dark mb-3 text-center">Wie geht es weiter?</h3>
          <ol class="space-y-3 text-sm text-body">
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">1</span>
              <span>Wir prüfen deinen Antrag und <strong>kontaktieren dich innerhalb von 24 Stunden per WhatsApp</strong>.</span>
            </li>
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">2</span>
              <span>Wir vereinbaren einen <strong>Hausbesuch</strong> — in Deutschland und Österreich in der Regel persönlich, in Großbritannien per Videoanruf.</span>
            </li>
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">3</span>
              <span>Nach der Genehmigung organisieren wir einen <strong>genehmigten Transport</strong> direkt zu dir nach Hause.</span>
            </li>
          </ol>
        </div>

        <p class="text-body mb-6">Kannst du nicht warten? Du kannst uns auch direkt erreichen:</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://wa.me/38765628636" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-green-500 text-white font-semibold rounded-full hover:bg-green-600 transition-colors">Nachricht auf WhatsApp</a>
          <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">Nachricht auf Facebook</a>
        </div>
        <div class="mt-8">
          <a href="/de/adopt" class="text-teal font-medium hover:underline">&larr; Zurück zu allen Hunden</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Dog selection
  const dogBtns = document.querySelectorAll<HTMLButtonElement>('.dog-select-btn');
  const dogInput = document.getElementById('dog_interest') as HTMLInputElement;
  const dogShowcase = document.getElementById('dog-showcase');
  const dogSelector = document.getElementById('dog-selector');
  const dogSelectedBar = document.getElementById('dog-selected-bar');
  const selectedDogThumb = document.getElementById('selected-dog-thumb') as HTMLImageElement;
  const selectedDogNameText = document.getElementById('selected-dog-name-text');
  const changeDogBarBtn = document.getElementById('change-dog-bar-btn');
  const formFields = document.getElementById('form-fields');
  const showcaseTrack = document.getElementById('showcase-track');
  const showcaseDots = document.getElementById('showcase-dots');
  const showcaseName = document.getElementById('showcase-name');
  const showcaseLine = document.getElementById('showcase-line');
  const showcaseLink = document.getElementById('showcase-profile-link') as HTMLAnchorElement;
  const changeDogBtn = document.getElementById('change-dog-btn');
  const dogError = document.getElementById('dog-select-error');
  const dogInfoEl = document.getElementById('dog-info');
  const dogInfo = dogInfoEl ? JSON.parse(dogInfoEl.textContent || '[]') : [];

  let showcaseCurrent = 0;
  let showcaseCount = 0;

  function showcaseGoTo(i: number) {
    showcaseCurrent = (i + showcaseCount) % showcaseCount;
    if (showcaseTrack) showcaseTrack.style.transform = `translateX(-${showcaseCurrent * 100}%)`;
    showcaseDots?.querySelectorAll('span').forEach((d, idx) => {
      d.className = `block w-2.5 h-2.5 rounded-full ${idx === showcaseCurrent ? 'bg-white' : 'bg-white/50'} transition-colors`;
    });
  }

  document.getElementById('showcase-prev')?.addEventListener('click', () => showcaseGoTo(showcaseCurrent - 1));
  document.getElementById('showcase-next')?.addEventListener('click', () => showcaseGoTo(showcaseCurrent + 1));

  // Touch swipe on showcase
  let sStartX = 0;
  document.getElementById('showcase-carousel')?.addEventListener('touchstart', (e) => { sStartX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
  document.getElementById('showcase-carousel')?.addEventListener('touchend', (e) => {
    const diff = sStartX - (e as TouchEvent).changedTouches[0].clientX;
    if (Math.abs(diff) > 50) showcaseGoTo(showcaseCurrent + (diff > 0 ? 1 : -1));
  });

  function selectDog(name: string, slug: string) {
    dogInput.value = name;
    dogError?.classList.add('hidden');

    // Collapse the grid, show the selected bar
    dogSelector?.classList.add('hidden');

    // Get the first photo for the thumb
    const thumbTemplate = document.querySelector(`template[data-dog-photos="${name}"]`);
    const firstImg = thumbTemplate?.content.querySelector('img');

    if (selectedDogThumb && firstImg && name !== 'Not sure yet') {
      selectedDogThumb.src = firstImg.src;
      selectedDogThumb.alt = name;
      selectedDogThumb.classList.remove('hidden');
    } else if (selectedDogThumb) {
      selectedDogThumb.classList.add('hidden');
    }
    if (selectedDogNameText) selectedDogNameText.textContent = name;
    dogSelectedBar?.classList.remove('hidden');

    if (name === 'Not sure yet') {
      dogShowcase?.classList.add('hidden');
      formFields?.classList.remove('hidden');
      formFields?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }

    // Load photos into carousel
    const template = document.querySelector(`template[data-dog-photos="${name}"]`);
    const info = dogInfo.find((d: any) => d.name === name);

    if (showcaseTrack && template) {
      showcaseTrack.innerHTML = '';
      const imgs = template.content.querySelectorAll('img');
      showcaseCount = imgs.length;
      showcaseCurrent = 0;

      imgs.forEach((img) => {
        const slide = document.createElement('div');
        slide.className = 'w-full h-full flex-shrink-0';
        const newImg = document.createElement('img');
        newImg.src = img.src;
        newImg.alt = img.alt;
        newImg.className = 'w-full h-full object-cover object-top';
        slide.appendChild(newImg);
        showcaseTrack.appendChild(slide);
      });

      showcaseTrack.style.transform = 'translateX(0)';

      // Build dots
      if (showcaseDots) {
        showcaseDots.innerHTML = '';
        for (let i = 0; i < showcaseCount; i++) {
          const dot = document.createElement('span');
          dot.className = `block w-2.5 h-2.5 rounded-full ${i === 0 ? 'bg-white' : 'bg-white/50'} transition-colors`;
          showcaseDots.appendChild(dot);
        }
      }
    }

    if (showcaseName) showcaseName.textContent = name;
    if (showcaseLine && info) showcaseLine.textContent = info.shortLine;
    if (showcaseLink && info) showcaseLink.href = `/de/adopt/${info.slug}`;

    dogShowcase?.classList.remove('hidden');
    formFields?.classList.remove('hidden');

    dogShowcase?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  dogBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectDog(btn.dataset.dog!, btn.dataset.slug!);
    });
  });

  function resetDogSelection() {
    dogShowcase?.classList.add('hidden');
    formFields?.classList.add('hidden');
    dogSelectedBar?.classList.add('hidden');
    dogSelector?.classList.remove('hidden');
    dogInput.value = '';
    dogBtns.forEach((btn) => {
      btn.classList.remove('border-teal', 'ring-2', 'ring-teal');
      btn.classList.add('border-gray-100');
    });
    dogSelector?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  changeDogBtn?.addEventListener('click', resetDogSelection);
  changeDogBarBtn?.addEventListener('click', resetDogSelection);

  // Pre-select from URL param
  const dogParam = new URLSearchParams(window.location.search).get('dog');
  if (dogParam) {
    const lc = dogParam.toLowerCase();
    const match = dogInfo.find((d: any) => d.name.toLowerCase() === lc || d.slug.toLowerCase() === lc);
    if (match) {
      selectDog(match.name, match.slug);
    }
  }

  // Show/hide fence height based on garden answer
  const gardenSelect = document.getElementById('garden') as HTMLSelectElement;
  const fenceRow = document.getElementById('fence-row');
  if (gardenSelect && fenceRow) {
    gardenSelect.addEventListener('change', () => {
      const isYes = gardenSelect.value === 'Yes';
      fenceRow.classList.toggle('hidden', !isYes);
      if (!isYes) (document.getElementById('fence_height') as HTMLSelectElement).value = '';
    });
  }

  // Show/hide rescue question based on dog experience
  const dogExpSelect = document.getElementById('dog_experience') as HTMLSelectElement;
  const rescueRow = document.getElementById('rescue-row');
  if (dogExpSelect && rescueRow) {
    dogExpSelect.addEventListener('change', () => {
      const isYes = dogExpSelect.value === 'Yes';
      rescueRow.classList.toggle('hidden', !isYes);
      if (!isYes) (document.getElementById('was_rescue') as HTMLSelectElement).value = '';
    });
  }

  // Show/hide pet details based on has_pets answer
  const hasPetsSelect = document.getElementById('has_pets') as HTMLSelectElement;
  const petsDetail = document.getElementById('pets-detail');
  if (hasPetsSelect && petsDetail) {
    hasPetsSelect.addEventListener('change', () => {
      const isYes = hasPetsSelect.value === 'Yes';
      petsDetail.classList.toggle('hidden', !isYes);
      if (!isYes) {
        selectedPets.clear();
        petBubbles.forEach((b) => { b.classList.remove('bg-teal', 'text-white', 'border-teal'); b.classList.add('text-body', 'border-gray-200'); });
        if (petCountsDiv) petCountsDiv.innerHTML = '';
        if (petTypesInput) petTypesInput.value = '';
      }
    });
  }

  // Pet type bubbles
  const selectedPets = new Set<string>();
  const petBubbles = document.querySelectorAll<HTMLButtonElement>('.pet-bubble');
  const petTypesInput = document.getElementById('pet_types') as HTMLInputElement;
  const petCountsDiv = document.getElementById('pet-counts');

  function updatePetCounts() {
    if (!petCountsDiv) return;
    petCountsDiv.innerHTML = '';
    selectedPets.forEach((pet) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3';
      row.innerHTML = `
        <label class="text-sm text-slate-dark w-20">${pet}</label>
        <div class="flex items-center gap-2">
          <button type="button" class="pet-minus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-pet="${pet}">-</button>
          <span class="pet-count text-sm font-semibold text-slate-dark w-6 text-center" data-pet="${pet}">1</span>
          <button type="button" class="pet-plus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-pet="${pet}">+</button>
        </div>
        <input type="hidden" name="pet_count_${pet.toLowerCase()}" value="1" class="pet-count-input" data-pet="${pet}" />
      `;
      petCountsDiv.appendChild(row);
    });
    petCountsDiv.querySelectorAll('.pet-plus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pet = (btn as HTMLElement).dataset.pet!;
        const countEl = petCountsDiv!.querySelector(`.pet-count[data-pet="${pet}"]`) as HTMLElement;
        const inputEl = petCountsDiv!.querySelector(`.pet-count-input[data-pet="${pet}"]`) as HTMLInputElement;
        const val = Math.min(parseInt(countEl.textContent || '1') + 1, 20);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });
    petCountsDiv.querySelectorAll('.pet-minus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pet = (btn as HTMLElement).dataset.pet!;
        const countEl = petCountsDiv!.querySelector(`.pet-count[data-pet="${pet}"]`) as HTMLElement;
        const inputEl = petCountsDiv!.querySelector(`.pet-count-input[data-pet="${pet}"]`) as HTMLInputElement;
        const val = Math.max(parseInt(countEl.textContent || '1') - 1, 1);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });
    if (petTypesInput) petTypesInput.value = Array.from(selectedPets).join(', ');
  }

  // Household bubbles
  const selectedHousehold = new Set<string>();
  const householdBubbles = document.querySelectorAll<HTMLButtonElement>('.household-bubble');
  const householdTypesInput = document.getElementById('household_types') as HTMLInputElement;
  const householdCountsDiv = document.getElementById('household-counts');
  const childrenAgesDiv = document.getElementById('household-children-ages');

  function updateHouseholdCounts() {
    if (!householdCountsDiv) return;
    householdCountsDiv.innerHTML = '';
    selectedHousehold.forEach((person) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3';
      row.innerHTML = `
        <label class="text-sm text-slate-dark w-32">${person}</label>
        <div class="flex items-center gap-2">
          <button type="button" class="hh-minus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-person="${person}">-</button>
          <span class="hh-count text-sm font-semibold text-slate-dark w-6 text-center" data-person="${person}">1</span>
          <button type="button" class="hh-plus w-8 h-8 rounded-full border border-gray-200 text-slate-dark hover:border-teal hover:text-teal flex items-center justify-center text-lg font-bold" data-person="${person}">+</button>
        </div>
        <input type="hidden" name="household_count_${person.toLowerCase().replace(/[\s\/]/g, '_')}" value="1" class="hh-count-input" data-person="${person}" />
      `;
      householdCountsDiv.appendChild(row);
    });
    householdCountsDiv.querySelectorAll('.hh-plus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const person = (btn as HTMLElement).dataset.person!;
        const countEl = householdCountsDiv!.querySelector(`.hh-count[data-person="${person}"]`) as HTMLElement;
        const inputEl = householdCountsDiv!.querySelector(`.hh-count-input[data-person="${person}"]`) as HTMLInputElement;
        const val = Math.min(parseInt(countEl.textContent || '1') + 1, 20);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });
    householdCountsDiv.querySelectorAll('.hh-minus').forEach((btn) => {
      btn.addEventListener('click', () => {
        const person = (btn as HTMLElement).dataset.person!;
        const countEl = householdCountsDiv!.querySelector(`.hh-count[data-person="${person}"]`) as HTMLElement;
        const inputEl = householdCountsDiv!.querySelector(`.hh-count-input[data-person="${person}"]`) as HTMLInputElement;
        const val = Math.max(parseInt(countEl.textContent || '1') - 1, 1);
        countEl.textContent = String(val);
        inputEl.value = String(val);
      });
    });
    if (householdTypesInput) {
      householdTypesInput.value = selectedHousehold.size > 0 ? Array.from(selectedHousehold).join(', ') : 'Just me';
    }
    if (childrenAgesDiv) {
      childrenAgesDiv.classList.toggle('hidden', !selectedHousehold.has('Children'));
    }
  }

  householdBubbles.forEach((bubble) => {
    bubble.addEventListener('click', () => {
      const person = bubble.dataset.person!;
      if (selectedHousehold.has(person)) {
        selectedHousehold.delete(person);
        bubble.classList.remove('bg-teal', 'text-white', 'border-teal');
        bubble.classList.add('text-body', 'border-gray-200');
      } else {
        selectedHousehold.add(person);
        bubble.classList.add('bg-teal', 'text-white', 'border-teal');
        bubble.classList.remove('text-body', 'border-gray-200');
      }
      updateHouseholdCounts();
    });
  });

  petBubbles.forEach((bubble) => {
    bubble.addEventListener('click', () => {
      const pet = bubble.dataset.pet!;
      if (selectedPets.has(pet)) {
        selectedPets.delete(pet);
        bubble.classList.remove('bg-teal', 'text-white', 'border-teal');
        bubble.classList.add('text-body', 'border-gray-200');
      } else {
        selectedPets.add(pet);
        bubble.classList.add('bg-teal', 'text-white', 'border-teal');
        bubble.classList.remove('text-body', 'border-gray-200');
      }
      updatePetCounts();
    });
  });

  // Handle form submission
  const form = document.getElementById('adopt-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form && successMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validate dog selection
      if (!dogInput.value) {
        dogError?.classList.remove('hidden');
        dogSelector?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Wird gesendet...';

      // Build WhatsApp click-to-chat link
      const phoneInput = (document.getElementById('phone') as HTMLInputElement)?.value || '';
      const cleanPhone = phoneInput.replace(/[\s\-\(\)]/g, '').replace(/^\+/, '');
      const applicantName = (document.getElementById('name') as HTMLInputElement)?.value || '';
      const selectedDogName = dogInput.value;
      const waMessage = encodeURIComponent(`Hi ${applicantName}! This is My Paws Bosnia. We received your adoption application${selectedDogName && selectedDogName !== 'Not sure yet' ? ` for ${selectedDogName}` : ''}. We'd love to chat with you about the next steps!`);
      const waLink = document.getElementById('whatsapp_link') as HTMLInputElement;
      if (waLink && cleanPhone) {
        waLink.value = `https://wa.me/${cleanPhone}?text=${waMessage}`;
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });

        if (res.ok) {
          // Send confirmation email (fire and forget — don't block the success screen)
          const emailData = {
            name: applicantName,
            email: (document.getElementById('email') as HTMLInputElement)?.value || '',
            dogName: selectedDogName,
            dogSlug: dogInfo.find((d: any) => d.name === selectedDogName)?.slug || '',
            country: (document.getElementById('country') as HTMLSelectElement)?.value || '',
            lang: document.documentElement.lang || 'en',
          };
          fetch('/api/confirm-application', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(emailData),
          }).catch(() => {}); // silent fail — Web3Forms already has the data

          if (selectedDogName && selectedDogName !== 'Not sure yet') {
            const successText = document.getElementById('success-dog-text');
            if (successText) {
              successText.textContent = `Wir freuen uns sehr, dass du dich für ${selectedDogName} interessierst! So geht es weiter.`;
            }
            // Show dog photos on success screen
            const successPhotos = document.getElementById('success-photos');
            const successTrack = document.getElementById('success-track');
            const successDotsEl = document.getElementById('success-dots');
            const tmpl = document.querySelector(`template[data-dog-photos="${selectedDogName}"]`);
            if (successPhotos && successTrack && successDotsEl && tmpl) {
              successTrack.innerHTML = '';
              successDotsEl.innerHTML = '';
              const imgs = tmpl.content.querySelectorAll('img');
              let sCurrent = 0;
              const sCount = imgs.length;
              imgs.forEach((img) => {
                const slide = document.createElement('div');
                slide.className = 'w-full h-full flex-shrink-0';
                const newImg = document.createElement('img');
                newImg.src = img.src;
                newImg.alt = img.alt;
                newImg.className = 'w-full h-full object-cover object-top';
                slide.appendChild(newImg);
                successTrack.appendChild(slide);
              });
              for (let i = 0; i < sCount; i++) {
                const dot = document.createElement('span');
                dot.className = `block w-2.5 h-2.5 rounded-full ${i === 0 ? 'bg-white' : 'bg-white/50'} transition-colors`;
                successDotsEl.appendChild(dot);
              }
              function sGoTo(i: number) {
                sCurrent = (i + sCount) % sCount;
                successTrack!.style.transform = `translateX(-${sCurrent * 100}%)`;
                successDotsEl!.querySelectorAll('span').forEach((d, idx) => {
                  d.className = `block w-2.5 h-2.5 rounded-full ${idx === sCurrent ? 'bg-white' : 'bg-white/50'} transition-colors`;
                });
              }
              document.getElementById('success-prev')?.addEventListener('click', () => sGoTo(sCurrent - 1));
              document.getElementById('success-next')?.addEventListener('click', () => sGoTo(sCurrent + 1));
              successPhotos.classList.remove('hidden');
            }
          }
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          throw new Error('Failed');
        }
      } catch {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Antrag absenden';
        alert('Etwas ist schiefgelaufen. Bitte versuche es erneut oder kontaktiere uns direkt auf Facebook oder WhatsApp.');
      }
    });
  }
</script>
