---
import SuccessStoryPage from "../../../components/pages/SuccessStoryPage.astro";
import { successStories } from "../../../data/success-stories";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return successStories.map((dog) => ({
    params: { slug: dog.slug },
    props: { dog },
  }));
};

const { dog } = Astro.props;
---
<SuccessStoryPage lang="de" dog={dog} />
