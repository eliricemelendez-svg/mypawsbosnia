---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";

const lang: Lang = 'de';
const t = useTranslations(lang);

import aboutHero from "../../assets/shelter/hires-three-pups.jpg";

const vesnaPhotos = import.meta.glob<{ default: ImageMetadata }>("../../assets/vesna/*.{jpeg,jpg,png}", { eager: true });
const vesnaList = Object.values(vesnaPhotos).map((m) => m.default);

const shelterPhotos = import.meta.glob<{ default: ImageMetadata }>("../../assets/shelter/*.{jpeg,jpg,png}", { eager: true });
const shelterList = Object.values(shelterPhotos).map((m) => m.default).slice(0, 4);
---

<Layout title={t('about.title')} description={t('about.description')} lang={lang}>
  <section class="relative overflow-hidden">
    <Image src={aboutHero} alt="Drei gerettete Hunde im Tierheim in Bosnien" width={1400} height={600} class="w-full h-[400px] md:h-[500px] object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-dark/70 to-transparent"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 text-white">
        <h1 class="text-4xl md:text-5xl font-bold drop-shadow-lg">{t('about.heroTitle')}</h1>
        <p class="mt-3 text-lg text-white/90 drop-shadow">{t('about.heroSubtitle')}</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-3xl font-bold text-slate-dark mb-6">{t('about.vesnaTitle')}</h2>
        <div class="text-body space-y-5 leading-relaxed">
          <p>{t('about.vesnaP1')}</p>
          <p>{t('about.vesnaP2')}</p>
          <p>{t('about.vesnaP3')}</p>
          <p>{t('about.vesnaP4')}</p>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-2">
        {vesnaList.map((photo) => (<Image src={photo} alt="Vesna k\u00fcmmert sich um Rettungshunde im Tierheim" width={150} height={150} class="w-full aspect-square object-cover rounded-lg" />))}
      </div>
    </div>
  </section>

  <section class="bg-light-bg py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-dark text-center mb-12">{t('about.howTitle')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-teal/10 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">🔍</div>
          <h3 class="font-semibold text-slate-dark text-lg">{t('about.rescueTitle')}</h3>
          <p class="text-body mt-2 text-sm">{t('about.rescueText')}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-teal/10 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">🏥</div>
          <h3 class="font-semibold text-slate-dark text-lg">{t('about.vetTitle')}</h3>
          <p class="text-body mt-2 text-sm">{t('about.vetText')}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-teal/10 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">🏠</div>
          <h3 class="font-semibold text-slate-dark text-lg">{t('about.shelterTitle')}</h3>
          <p class="text-body mt-2 text-sm">{t('about.shelterText')}</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-teal/10 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">✈️</div>
          <h3 class="font-semibold text-slate-dark text-lg">{t('about.homesTitle')}</h3>
          <p class="text-body mt-2 text-sm">{t('about.homesText')}</p>
        </div>
      </div>
      {shelterList.length > 0 && (
        <div class="grid grid-cols-4 md:grid-cols-6 gap-2 mt-12">
          {shelterList.map((photo) => (<Image src={photo} alt="Hunderettungs-Tierheim in Br\u010dko, Bosnien" width={150} height={150} class="w-full aspect-square object-cover rounded-lg" />))}
        </div>
      )}
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-2xl font-bold text-slate-dark mb-4">{t('about.ctaTitle')}</h2>
    <p class="text-body mb-8">{t('about.ctaText')}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/de/adopt" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">{t('about.meetDogs')}</a>
      <a href="/de/donate" class="inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors">{t('nav.donate')}</a>
    </div>
  </section>
</Layout>
