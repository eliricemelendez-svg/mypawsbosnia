---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import DogCard from "../components/DogCard.astro";
import { currentDogs } from "../data/current-dogs";

const featured = currentDogs.slice(0, 3);

// Hero: specific dogs for the slideshow
import flintImg from "../assets/current-dogs/flint/flint-1.jpeg";
import barneyImg from "../assets/current-dogs/barney/barney-1.jpeg";
import pjuskeImg from "../assets/current-dogs/pjuske/pjuske-3.jpeg";

const heroSlides = [
  { img: flintImg, name: "Flint", line: "He donated blood to save another dog's life. He's been waiting for a home since he was a puppy.", alt: "Flint, a rescued dog at My Paws Bosnia" },
  { img: barneyImg, name: "Barney", line: "Two years old, full of energy, and ready to travel to his new family.", alt: "Barney, a rescued dog at My Paws Bosnia" },
  { img: pjuskeImg, name: "Pjuske", line: "Three shelters. Three years. Still waiting for someone to take her home.", alt: "Pjuske, a rescued dog at My Paws Bosnia" },
];

// Vesna + shelter photos for trust section
import vesnaWithDog from "../assets/vesna/706517929_122100551391334047_1761713277840422103_n.jpg";
import vetBill from "../assets/vet/hires-vet-bill.jpg";
import passportDog from "../assets/past-rescues/hires-passport-1.jpg";

// Past rescue photos for collage
const pastPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/past-rescues/*.{jpeg,jpg,png}",
  { eager: true }
);
const pastList = Object.values(pastPhotos).map((m) => m.default);
---

<Layout title="My Paws Bosnia - Rescuing Dogs in Bosnia">
  <!-- Hero: specific dog stories -->
  <section class="bg-light-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-xl md:text-2xl font-bold text-teal mb-3">Meet <span id="hero-dog-name">{heroSlides[0].name}</span></p>
          <h1 id="hero-dog-line" class="text-2xl md:text-3xl font-semibold text-slate-dark leading-tight">
            {heroSlides[0].line}
          </h1>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a
              href="/adopt"
              class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors text-center"
            >
              Meet our dogs
            </a>
            <button
              class="donate-urgent inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors text-center"
            >
              Give €25 to feed a dog
            </button>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl" id="hero-slideshow">
          {heroSlides.map((slide, i) => (
            <Image
              src={slide.img}
              alt={slide.alt}
              width={300}
              class:list={[
                "hero-slide w-full max-w-[280px] mx-auto rounded-2xl transition-opacity duration-700",
                i === 0 ? "opacity-100" : "opacity-0 absolute inset-0",
              ]}
              data-name={slide.name}
              data-line={slide.line}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Dogs -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-slate-dark">Dogs looking for homes</h2>
      <p class="text-body mt-2">60 dogs in our care. Here are three who need you most.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((dog) => (
        <DogCard
          slug={dog.slug}
          name={dog.name}
          shortLine={dog.shortLine}
          sex={dog.sex}
          age={dog.age}
          size={dog.size}
          linkPrefix="/adopt"
        />
      ))}
    </div>
    <div class="text-center mt-8">
      <a
        href="/adopt"
        class="inline-block px-8 py-3 text-teal font-semibold border-2 border-teal rounded-full hover:bg-teal hover:text-white transition-colors"
      >
        See all dogs
      </a>
    </div>
  </section>

  <!-- Trust: real proof this is legit -->
  <section class="bg-light-bg py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-dark text-center mb-8">This is real. Here's the proof.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={vesnaWithDog} alt="Vesna with a shelter dog" width={400} class="w-full aspect-square object-cover" />
          <div class="p-4">
            <p class="text-sm text-body">Vesna runs the shelter with her two daughters in Brcko, Bosnia.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={vetBill} alt="Veterinary bill from Animal Med clinic" width={400} class="w-full aspect-square object-cover object-top" />
          <div class="p-4">
            <p class="text-sm text-body">A real vet bill from the clinic. 118 KM (~€60) for one visit.</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={passportDog} alt="A rescued dog with their pet passport" width={400} class="w-full aspect-square object-cover" />
          <div class="p-4">
            <p class="text-sm text-body">Dogs receive passports and travel to families across Europe.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Past rescues collage -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-slate-dark">Dogs we've placed in homes since 2019</h2>
    </div>
    <div class="flex gap-2 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide">
      {pastList.map((photo, i) => (
        <div class="flex-none w-28 md:w-32 snap-start">
          <Image
            src={photo}
            alt={`Rescued dog ${i + 1}`}
            width={150}
            height={150}
            class="w-full aspect-square object-cover rounded-lg"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Facebook -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="bg-light-bg rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center gap-6">
      <div class="text-5xl">📘</div>
      <div class="flex-1 text-center md:text-left">
        <h2 class="text-2xl font-bold text-slate-dark">Follow us on Facebook</h2>
        <p class="text-body mt-2">Daily updates on the dogs in our care.</p>
      </div>
      <a
        href="https://www.facebook.com/profile.php?id=61590021437450"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors"
      >
        Follow
      </a>
    </div>
  </section>
</Layout>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const nameEl = document.getElementById('hero-dog-name');
  const lineEl = document.getElementById('hero-dog-line');
  if (slides.length > 1 && nameEl && lineEl) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('opacity-100');
      slides[current].classList.add('opacity-0', 'absolute', 'inset-0');
      current = (current + 1) % slides.length;
      const slide = slides[current] as HTMLElement;
      slides[current].classList.remove('opacity-0', 'absolute', 'inset-0');
      slides[current].classList.add('opacity-100');
      nameEl.textContent = slide.dataset.name ?? '';
      lineEl.textContent = slide.dataset.line ?? '';
    }, 5000);
  }
</script>
