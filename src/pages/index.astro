---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import DogCard from "../components/DogCard.astro";
import { currentDogs } from "../data/current-dogs";
import { successStories } from "../data/success-stories";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import bridgetteImg from "../assets/success-stories/bridgette/bridgette-1.jpg";
import pjuskeImg from "../assets/success-stories/pjuske/pjuske-1.jpeg";
import neroImg from "../assets/success-stories/nero/nero-1.png";
import eliImg from "../assets/success-stories/eli/eli-1.jpg";
import flintSuccessImg from "../assets/success-stories/flint/flint-1.jpeg";

const lang: Lang = 'en';
const t = useTranslations(lang);

const featured = currentDogs;

// Hero: specific dogs for the slideshow
import barneyImg from "../assets/current-dogs/barney/barney-1.jpeg";
import leiaImg from "../assets/current-dogs/leia/leia-1.jpeg";
import klaraImg from "../assets/current-dogs/klara/klara-1.jpg";
import maxImg from "../assets/current-dogs/max/max-1.jpg";
import nadiaImg from "../assets/current-dogs/nadia/nadia-1.jpg";
import vanjaImg from "../assets/current-dogs/vanja/vanja-1.jpg";
import lunaImg from "../assets/current-dogs/luna/luna-1.jpg";
import daphneImg from "../assets/current-dogs/daphne/daphne-1.jpg";
import mausImg from "../assets/current-dogs/maus/maus-1.jpg";
import freyaImg from "../assets/current-dogs/freya/freya-1.jpg";
const heroSlides = [
  { img: barneyImg, slug: "barney", name: "Barney", line: "Two years old, full of energy, and ready to travel to his new family.", alt: "Barney, a rescued dog at My Paws Bosnia" },
  { img: leiaImg, slug: "leia", name: "Leia", line: "Abandoned but never broken. A gentle 40kg giant still full of love and trust.", alt: "Leia, a rescued dog at My Paws Bosnia" },
  { img: klaraImg, slug: "klara", name: "Klara", line: "A brave little fighter who beat illness and is ready to find her forever home.", alt: "Klara, a rescued dog at My Paws Bosnia" },
  { img: maxImg, slug: "max", name: "Max", line: "Bottle-fed since he was two days old. Gentle, playful, and ready for a family.", alt: "Max, a rescued dog at My Paws Bosnia" },
  { img: nadiaImg, slug: "nadia", name: "Nadia", line: "Bottle-fed since she was two days old. Playful, friendly, and looking for her forever home.", alt: "Nadia, a rescued dog at My Paws Bosnia" },
  { img: vanjaImg, slug: "vanja", name: "Vanja", line: "A gentle, loyal girl with a golden heart. Spayed, vaccinated, and ready for her forever family.", alt: "Vanja, a rescued dog at My Paws Bosnia" },
  { img: lunaImg, slug: "luna", name: "Luna", line: "Already over 43 cm tall and still growing. Playful, active, and looking for her family.", alt: "Luna, a rescued dog at My Paws Bosnia" },
  { img: daphneImg, slug: "daphne", name: "Daphne", line: "Rescued from a poor shelter, now full of life. Small, playful, and looking for her forever home.", alt: "Daphne, a rescued dog at My Paws Bosnia" },
  { img: mausImg, slug: "maus", name: "Maus", line: "Those eyes. Recovered from demodex as a puppy, now a slim, athletic boy ready for adventure.", alt: "Maus, a rescued dog at My Paws Bosnia" },
  { img: freyaImg, slug: "freya", name: "Freya", line: "Her whole family got adopted. She's the only one still waiting.", alt: "Freya, a rescued dog at My Paws Bosnia" },
];

// Vesna + shelter photos for trust section
import vesnaWithDog from "../assets/vesna/706517929_122100551391334047_1761713277840422103_n.jpg";
import vetReceipt from "../assets/vet/706690924_122100558429334047_4488345373460848609_n.jpg";
import passportDog from "../assets/past-rescues/hires-passport-1.jpg";

// Past rescue photos for collage
const pastPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/past-rescues/*.{jpeg,jpg,png}",
  { eager: true }
);
const pastList = Object.values(pastPhotos).map((m) => m.default);

const happyCards = [
  { img: bridgetteImg, slug: 'bridgette', name: 'Bridgette', adoptedTo: successStories.find(s => s.slug === 'bridgette')?.adoptedTo, shortLine: successStories.find(s => s.slug === 'bridgette')?.shortLine ?? '' },
  { img: pjuskeImg, slug: 'pjuske', name: 'Pjuske', adoptedTo: successStories.find(s => s.slug === 'pjuske')?.adoptedTo, shortLine: successStories.find(s => s.slug === 'pjuske')?.shortLine ?? '' },
  { img: neroImg, slug: 'nero', name: 'Nero', adoptedTo: successStories.find(s => s.slug === 'nero')?.adoptedTo, shortLine: successStories.find(s => s.slug === 'nero')?.shortLine ?? '' },
  { img: eliImg, slug: 'eli', name: 'Eli', adoptedTo: successStories.find(s => s.slug === 'eli')?.adoptedTo, shortLine: successStories.find(s => s.slug === 'eli')?.shortLine ?? '' },
  { img: flintSuccessImg, slug: 'flint', name: 'Flint', adoptedTo: successStories.find(s => s.slug === 'flint')?.adoptedTo, shortLine: successStories.find(s => s.slug === 'flint')?.shortLine ?? '' },
];
---

<Layout title={t('index.title')} description={t('index.description')} lang={lang}>
  <!-- Urgency banner -->
  <div class="bg-teal text-white text-center py-3 px-4">
    <p class="text-sm md:text-base font-semibold">{t('index.urgency')}</p>
  </div>

  <!-- Hero: specific dog stories -->
  <section class="bg-light-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-xl md:text-2xl font-bold text-teal mb-3">{t('index.heroMeet')} <span id="hero-dog-name">{heroSlides[0].name}</span></p>
          <h1 id="hero-dog-line" class="text-2xl md:text-3xl font-semibold text-slate-dark leading-tight">
            {heroSlides[0].line}
          </h1>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a
              id="hero-dog-link"
              href={`/adopt/${heroSlides[0].slug}`}
              class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors text-center"
            >
              Meet {heroSlides[0].name}
            </a>
            <button
              class="donate-urgent inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors text-center"
            >
              {t('index.heroDonate')}
            </button>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl" id="hero-slideshow">
          {heroSlides.map((slide, i) => (
            <Image
              src={slide.img}
              alt={slide.alt}
              width={300}
              class:list={[
                "hero-slide w-full max-w-[280px] mx-auto rounded-2xl transition-opacity duration-700",
                i === 0 ? "opacity-100" : "opacity-0 absolute inset-0",
              ]}
              data-name={slide.name}
              data-line={slide.line}
              data-slug={slide.slug}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Dogs -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-slate-dark">{t('index.featuredTitle')}</h2>
      <p class="text-body mt-2">{t('index.featuredSubtitle')}</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {featured.map((dog) => (
        <DogCard
          slug={dog.slug}
          name={dog.name}
          shortLine={dog.shortLine}
          sex={dog.sex}
          age={dog.age}
          size={dog.size}
          linkPrefix="/adopt"
          lang={lang}
        />
      ))}
    </div>
    <div class="text-center mt-8">
      <a
        href="/adopt"
        class="inline-block px-8 py-3 text-teal font-semibold border-2 border-teal rounded-full hover:bg-teal hover:text-white transition-colors"
      >
        {t('index.seeAllDogs')}
      </a>
    </div>
  </section>

  <!-- Trust: real proof this is legit -->
  <section class="bg-light-bg py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-dark text-center mb-8">{t('index.trustTitle')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={vesnaWithDog} alt="Vesna with a shelter dog" width={400} class="w-full aspect-square object-cover" />
          <div class="p-4">
            <p class="text-sm text-body">{t('index.trustVesna')}</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={vetReceipt} alt="Veterinary receipt from AgriPet clinic for Moje Sape" width={400} class="w-full aspect-square object-cover object-top" />
          <div class="p-4">
            <p class="text-sm text-body">{t('index.trustVet')}</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
          <Image src={passportDog} alt="A rescued dog with their pet passport" width={400} class="w-full aspect-square object-cover" />
          <div class="p-4">
            <p class="text-sm text-body">{t('index.trustPassport')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Happy Endings -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-slate-dark">{t('index.happyTitle')}</h2>
      <p class="text-body mt-2">{t('index.happySubtitle')}</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {happyCards.map((story) => (
        <a href={`/success-stories/${story.slug}`} class="group block bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden">
          <Image src={story.img} alt={`${story.name}, adopted from My Paws Bosnia`} width={400} class="w-full aspect-[4/3] object-cover object-top" />
          <div class="p-5">
            <h3 class="text-lg font-semibold text-slate-dark group-hover:text-teal transition-colors">{story.name}</h3>
            {story.adoptedTo && <p class="text-sm text-teal font-medium mt-1">{t('dog.adoptedTo')} {story.adoptedTo}</p>}
            <p class="text-sm text-body mt-1">{story.shortLine}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/success-stories" class="inline-block px-8 py-3 text-teal font-semibold border-2 border-teal rounded-full hover:bg-teal hover:text-white transition-colors">
        {t('index.seeAllStories')}
      </a>
    </div>
  </section>

  <!-- Past rescues collage -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-slate-dark">{t('index.pastTitle')}</h2>
    </div>
    <div class="flex gap-2 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide">
      {pastList.map((photo, i) => (
        <div class="flex-none w-28 md:w-32 snap-start">
          <Image
            src={photo}
            alt={`Rescue dog rehomed from Bosnia to a family in Europe`}
            width={150}
            height={150}
            class="w-full aspect-square object-cover rounded-lg"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Facebook -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="bg-light-bg rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center gap-6">
      <div class="text-5xl">📘</div>
      <div class="flex-1 text-center md:text-left">
        <h2 class="text-2xl font-bold text-slate-dark">{t('index.fbTitle')}</h2>
        <p class="text-body mt-2">{t('index.fbSubtitle')}</p>
      </div>
      <a
        href="https://www.facebook.com/profile.php?id=61590021437450"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors"
      >
        {t('index.fbFollow')}
      </a>
    </div>
  </section>
</Layout>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const nameEl = document.getElementById('hero-dog-name');
  const lineEl = document.getElementById('hero-dog-line');
  const linkEl = document.getElementById('hero-dog-link') as HTMLAnchorElement;
  if (slides.length > 1 && nameEl && lineEl) {
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('opacity-100');
      slides[current].classList.add('opacity-0', 'absolute', 'inset-0');
      current = (current + 1) % slides.length;
      const slide = slides[current] as HTMLElement;
      slides[current].classList.remove('opacity-0', 'absolute', 'inset-0');
      slides[current].classList.add('opacity-100');
      nameEl.textContent = slide.dataset.name ?? '';
      lineEl.textContent = slide.dataset.line ?? '';
      if (linkEl) {
        linkEl.href = `/adopt/${slide.dataset.slug}`;
        linkEl.textContent = `Meet ${slide.dataset.name}`;
      }
    }, 5000);
  }
</script>
