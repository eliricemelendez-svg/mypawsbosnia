---
import type { Lang } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const paypalEmail = "donate2mypaws@gmail.com";
const paypalSendLink = `https://www.paypal.com/myaccount/transfer/homepage/pay`;
---

<section class="bg-teal/5 rounded-2xl p-8 md:p-12 text-center">
  <div class="max-w-lg mx-auto">
    <div class="text-5xl mb-4">💛</div>
    <h2 class="text-2xl font-bold text-slate-dark mb-3">{t('donateBlock.title')}</h2>
    <p class="text-body mb-6">
      {t('donateBlock.subtitle')}
    </p>

    <!-- Step 1: Copy the email -->
    <div class="bg-white rounded-xl p-4 flex items-center justify-between gap-3 shadow-sm mb-4">
      <span id="paypal-email" class="text-sm md:text-base font-mono font-medium text-slate-dark">
        {paypalEmail}
      </span>
      <button
        id="copy-paypal"
        type="button"
        data-email={paypalEmail}
        data-copy-text={t('donateBlock.copy')}
        data-copied-text={t('donateBlock.copied')}
        data-failed-text={t('donateBlock.failed')}
        class="shrink-0 px-5 py-2.5 text-sm font-bold text-white bg-teal rounded-full hover:bg-teal/90 transition-colors"
      >
        {t('donateBlock.copy')}
      </button>
    </div>

    <!-- Step 2: Open PayPal -->
    <a
      href={paypalSendLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block w-full px-8 py-4 text-lg font-bold text-white bg-slate-dark rounded-full hover:bg-slate-dark/90 transition-colors"
    >
      {t('donateBlock.openPaypal')} &rarr;
    </a>

    <p class="text-xs text-body/60 mt-4">
      {t('donateBlock.steps')}
    </p>
    <p class="text-xs text-body/60 mt-1">
      {t('donateBlock.friendsFamily')}
    </p>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-paypal");
  if (btn) {
    const copyText = btn.dataset.copyText || "Copy";
    const copiedText = btn.dataset.copiedText || "Copied!";
    const failedText = btn.dataset.failedText || "Failed";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email ?? "");
        btn.textContent = copiedText;
        btn.classList.add("bg-green-500");
        btn.classList.remove("bg-teal");
        setTimeout(() => {
          btn.textContent = copyText;
          btn.classList.remove("bg-green-500");
          btn.classList.add("bg-teal");
        }, 3000);
      } catch {
        btn.textContent = failedText;
        setTimeout(() => { btn.textContent = copyText; }, 2000);
      }
    });
  }
</script>
