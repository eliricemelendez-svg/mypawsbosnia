---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PhotoLightbox from "../PhotoLightbox.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
import type { SuccessStory } from "../../data/success-stories";
import { getLocalizedStory } from "../../utils/dog-i18n";

interface Props {
  lang: Lang;
  dog: SuccessStory;
}

const { lang, dog } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === "en" ? "" : `/${lang}`;

// Localized fields
const { story, shortLine, traits, adoptedTo } = getLocalizedStory(dog, lang);

const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/success-stories/**/*.{jpeg,jpg,png}",
  { eager: true }
);
const photoPrefix = `../../assets/success-stories/${dog.slug}/`;
const dogPhotos = Object.entries(allPhotos)
  .filter(([path]) => path.startsWith(photoPrefix))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
const leadPhoto = dogPhotos[0] ?? null;
const extraPhotos = dogPhotos.slice(1);

// SEO meta per lang
const titleMap: Record<Lang, string> = {
  en: `${dog.name}'s Adoption Story | Rescue Dog Success | My Paws Bosnia`,
  de: `${dog.name}s Adoptionsgeschichte | My Paws Bosnia`,
  nl: `${dog.name}'s adoptieverhaal | My Paws Bosnia`,
  fr: `L'histoire d'adoption de ${dog.name} | My Paws Bosnia`,
};
const descMap: Record<Lang, string> = {
  en: `${shortLine} Read how ${dog.name} went from a shelter in Bosnia to a loving home in Europe.`,
  de: `${shortLine} Lies, wie ${dog.name} vom Tierheim in Bosnien in ein liebevolles Zuhause in Europa kam.`,
  nl: `${shortLine} Lees hoe ${dog.name} van een asiel in Bosnie naar een liefdevol thuis in Europa ging.`,
  fr: `${shortLine} D\u00e9couvrez comment ${dog.name} est pass\u00e9 d'un refuge en Bosnie \u00e0 un foyer aimant en Europe.`,
};
const headlineMap: Record<Lang, string> = {
  en: `${dog.name}'s Adoption Story`,
  de: `${dog.name}s Adoptionsgeschichte`,
  nl: `${dog.name}'s adoptieverhaal`,
  fr: `L'histoire d'adoption de ${dog.name}`,
};
const altMap: Record<Lang, string> = {
  en: `${dog.name}, a rescue dog from Bosnia who found a forever home`,
  de: `${dog.name}, Rettungshund aus Bosnien`,
  nl: `${dog.name}, reddingshond uit Bosnie`,
  fr: `${dog.name}, chien sauv\u00e9 de Bosnie`,
};
---

<Layout
  title={titleMap[lang]}
  description={descMap[lang]}
  ogImage={`/og/${dog.slug}.jpg`}
  lang={lang}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Article",
    headline: headlineMap[lang],
    description: story,
    image: leadPhoto ? new URL(leadPhoto.src, Astro.site ?? "https://mypawsbosnia.org").href : undefined,
    author: { "@type": "Organization", name: "My Paws Bosnia" },
    publisher: { "@type": "Organization", name: "My Paws Bosnia" },
  }}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <a href={`${prefix}/success-stories`} class="inline-flex items-center text-teal font-medium hover:underline mb-6">
      &larr; {t('successSlug.backToStories')}
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-8">
      {leadPhoto ? (
        <button type="button" class="cursor-pointer border-0 p-0 bg-transparent" data-lightbox-trigger="0">
          <Image src={leadPhoto} alt={altMap[lang]} width={500} class="w-full rounded-2xl hover:opacity-90 transition-opacity" />
        </button>
      ) : (
        <div class="aspect-square bg-gray-100 rounded-2xl flex items-center justify-center text-8xl">🐕</div>
      )}

      <div>
        <h1 class="text-4xl font-bold text-slate-dark">{dog.name}</h1>
        <div class="mt-3">
          <span class="inline-flex items-center gap-1.5 bg-green-100 text-green-700 text-sm font-semibold px-4 py-2 rounded-full">
            {t('successSlug.adopted')} &middot; {dog.adoptedDate}
          </span>
        </div>
        <div class="flex flex-wrap gap-3 mt-4">
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center">
            <p class="text-xs text-body uppercase tracking-wide">{t('adoptSlug.age')}</p>
            <p class="text-base font-semibold text-slate-dark mt-1">{dog.ageYears ? (dog.ageYears < 1 ? `${Math.round(dog.ageYears * 12)} ${t('adoptSlug.months')}` : `${dog.ageYears} ${t('adoptSlug.years')}`) : dog.age}</p>
          </div>
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center">
            <p class="text-xs text-body uppercase tracking-wide">{t('adoptSlug.size')}</p>
            <p class="text-base font-semibold text-slate-dark mt-1 capitalize">{dog.size}</p>
          </div>
          <div class="bg-light-bg rounded-xl px-5 py-3 text-center">
            <p class="text-xs text-body uppercase tracking-wide">{t('adoptSlug.sex')}</p>
            <p class="text-base font-semibold text-slate-dark mt-1 capitalize">{dog.sex}</p>
          </div>
        </div>
        {adoptedTo && (
          <div class="bg-light-bg rounded-xl px-5 py-3 mt-3">
            <p class="text-xs text-body uppercase tracking-wide">{t('successSlug.newHome')}</p>
            <p class="text-base font-semibold text-slate-dark mt-1">{adoptedTo}</p>
          </div>
        )}
        <div class="mt-6">
          <p class="text-body leading-relaxed">{story}</p>
          {traits && traits.length > 0 && (
            <ul class="mt-4 space-y-2">
              {traits.map((trait) => (
                <li class="flex items-start gap-2 text-body"><span class="text-teal mt-0.5">&#10003;</span><span>{trait}</span></li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>

    {extraPhotos.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold text-slate-dark mb-4">{t('successSlug.morePhotos')}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {extraPhotos.map((photo, i) => (
            <button type="button" class="cursor-pointer border-0 p-0 bg-transparent" data-lightbox-trigger={i + 1}>
              <Image src={photo} alt={`${dog.name} photo ${i + 2}`} width={400} height={400} class="w-full aspect-square object-cover rounded-xl hover:opacity-90 transition-opacity" />
            </button>
          ))}
        </div>
      </div>
    )}

    <PhotoLightbox photos={dogPhotos} name={dog.name} lang={lang} />

    <div class="mt-12 bg-teal/5 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-slate-dark mb-3">{t('successSlug.ctaTitle')}</h2>
      <p class="text-body mb-6">{t('successSlug.ctaText')}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${prefix}/adopt`} class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">{t('successSlug.meetDogs')}</a>
        <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 border-2 border-teal text-teal font-semibold rounded-full hover:bg-teal hover:text-white transition-colors">{t('successSlug.messageFb')}</a>
      </div>
    </div>
  </section>
</Layout>
