---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  dogName: string;
  dogSlug: string;
  lang: Lang;
}

const { dogName, dogSlug, lang } = Astro.props;
const t = useTranslations(lang);

const paypalUrl = "https://www.paypal.com/myaccount/transfer/homepage/pay";

const tiers = [
  {
    id: "month",
    label: t("sponsor.month").replace("{name}", dogName),
    price: t("sponsor.monthPrice"),
  },
  {
    id: "quarter",
    label: t("sponsor.quarter").replace("{name}", dogName),
    price: t("sponsor.quarterPrice"),
  },
  {
    id: "year",
    label: t("sponsor.year").replace("{name}", dogName),
    price: t("sponsor.yearPrice"),
  },
];
---

<!-- Sponsor toggle line -->
<div class="mt-6 pt-6 border-t border-teal/10">
  <button
    type="button"
    id="sponsor-toggle"
    class="w-full flex items-center justify-center gap-2 text-sm text-body hover:text-teal transition-colors cursor-pointer bg-transparent border-0 p-0"
  >
    <span>💛</span>
    <span>{t("sponsor.text").replace("{name}", dogName)}</span>
    <span class="font-semibold text-teal">{t("sponsor.monthPrice")}/mo →</span>
  </button>

  <!-- Expandable panel -->
  <div id="sponsor-panel" class="hidden mt-6">
    <!-- Tier cards -->
    <div class="grid grid-cols-3 gap-3 mb-5">
      {tiers.map((tier) => (
        <div class="bg-white rounded-xl p-4 text-center border border-gray-100">
          <p class="text-xl font-bold text-teal">{tier.price}</p>
          <p class="text-xs text-body mt-1">{tier.label}</p>
        </div>
      ))}
    </div>

    <!-- PayPal button -->
    <div class="text-center mb-5">
      <a
        href={paypalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-6 py-2.5 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors text-sm"
      >
        {t("sponsor.donateBtn")}
      </a>
      <p class="text-xs text-body mt-1.5">donate2mypaws@gmail.com</p>
    </div>

    <!-- Confirmation form -->
    <div class="max-w-sm mx-auto bg-white rounded-xl p-5 border border-gray-100">
      <p class="text-xs font-semibold text-slate-dark mb-3 text-center">
        {t("sponsor.formTitle")}
      </p>
      <form id="sponsor-form" data-dog-name={dogName} data-dog-slug={dogSlug} data-lang={lang}>
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="text"
            name="firstName"
            placeholder={t("sponsor.firstName")}
            required
            class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal"
          />
          <input
            type="email"
            name="email"
            placeholder={t("sponsor.email")}
            required
            class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal"
          />
        </div>
        <div class="flex gap-2 mt-2">
          <select
            name="tier"
            class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal text-body"
          >
            <option value="">{t("sponsor.tierLabel")}</option>
            <option value="month">{t("sponsor.tierMonth")}</option>
            <option value="quarter">{t("sponsor.tierQuarter")}</option>
            <option value="year">{t("sponsor.tierYear")}</option>
            <option value="other">{t("sponsor.tierOther")}</option>
          </select>
          <button
            type="submit"
            class="px-5 py-2 bg-teal text-white font-semibold rounded-lg hover:bg-teal/90 transition-colors text-sm whitespace-nowrap"
          >
            {t("sponsor.submit")}
          </button>
        </div>
        <p id="sponsor-msg" class="text-sm text-center mt-2 hidden"></p>
      </form>
    </div>
  </div>
</div>

<script>
  // Toggle expand/collapse
  const toggle = document.getElementById("sponsor-toggle");
  const panel = document.getElementById("sponsor-panel");
  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      panel.classList.toggle("hidden");
    });
  }

  // Form submission
  const form = document.getElementById("sponsor-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const msg = document.getElementById("sponsor-msg")!;
      const data = new FormData(form);

      btn.disabled = true;
      btn.style.opacity = "0.5";

      try {
        const res = await fetch("/api/sponsor", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            firstName: data.get("firstName"),
            email: data.get("email"),
            tier: data.get("tier"),
            dogName: form.dataset.dogName,
            dogSlug: form.dataset.dogSlug,
            lang: form.dataset.lang,
          }),
        });

        if (res.ok) {
          msg.textContent = msg.dataset.thanks || "Thank you!";
          msg.className = "text-sm text-center mt-2 text-teal font-medium";
          form.reset();
        } else {
          msg.textContent = msg.dataset.error || "Something went wrong.";
          msg.className = "text-sm text-center mt-2 text-red-500";
        }
      } catch {
        msg.textContent = msg.dataset.error || "Something went wrong.";
        msg.className = "text-sm text-center mt-2 text-red-500";
      }

      btn.disabled = false;
      btn.style.opacity = "1";
    });

    const msgEl = document.getElementById("sponsor-msg")!;
    const lang = form.dataset.lang || "en";
    const thanksMap: Record<string, string> = {
      en: "Thank you! We\u2019ll be in touch to say thanks properly.",
      de: "Danke! Wir melden uns, um uns pers\u00f6nlich zu bedanken.",
      nl: "Bedankt! We nemen contact op om je persoonlijk te bedanken.",
      fr: "Merci ! Nous vous contacterons pour vous remercier personnellement.",
    };
    const errorMap: Record<string, string> = {
      en: "Something went wrong. Please try again.",
      de: "Etwas ist schiefgelaufen. Bitte versuche es erneut.",
      nl: "Er is iets misgegaan. Probeer het opnieuw.",
      fr: "Une erreur est survenue. Veuillez r\u00e9essayer.",
    };
    msgEl.dataset.thanks = thanksMap[lang] || thanksMap.en;
    msgEl.dataset.error = errorMap[lang] || errorMap.en;
  }
</script>
