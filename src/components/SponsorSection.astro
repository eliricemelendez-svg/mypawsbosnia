---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  dogName: string;
  dogSlug: string;
  lang: Lang;
}

const { dogName, dogSlug, lang } = Astro.props;
const t = useTranslations(lang);

const paypalUrl = "https://www.paypal.com/myaccount/transfer/homepage/pay";

const tiers = [
  {
    id: "month",
    label: t("sponsor.month").replace("{name}", dogName),
    price: t("sponsor.monthPrice"),
  },
  {
    id: "quarter",
    label: t("sponsor.quarter").replace("{name}", dogName),
    price: t("sponsor.quarterPrice"),
  },
  {
    id: "year",
    label: t("sponsor.year").replace("{name}", dogName),
    price: t("sponsor.yearPrice"),
  },
];
---

<div class="mt-12 rounded-2xl overflow-hidden border border-amber-200">
  <!-- Header -->
  <div class="bg-amber-50 px-8 py-6 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-amber-700 mb-1">
      {t("sponsor.title").replace("{name}", dogName)}
    </p>
    <p class="text-3xl font-bold text-slate-dark">
      {t("sponsor.monthPrice")}<span class="text-lg font-normal text-body">/mo</span>
    </p>
    <p class="text-body text-sm mt-2 max-w-md mx-auto">
      {t("sponsor.text").replace("{name}", dogName)}
    </p>
  </div>

  <!-- Tiers -->
  <div class="bg-white px-8 py-6">
    <div class="grid grid-cols-3 gap-3 mb-6">
      {tiers.map((tier, i) => (
        <button
          type="button"
          class:list={[
            "sponsor-tier rounded-xl p-4 text-center border-2 transition-colors cursor-pointer",
            i === 0 ? "border-teal bg-teal/5" : "border-gray-200 hover:border-teal",
          ]}
          data-tier={tier.id}
        >
          <p class="text-2xl font-bold text-teal">{tier.price}</p>
          <p class="text-xs text-body mt-1 leading-tight">{tier.label}</p>
        </button>
      ))}
    </div>

    <!-- Sponsor button -->
    <div class="text-center mb-6">
      <a
        href={paypalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block w-full sm:w-auto px-10 py-3.5 bg-amber-500 text-white font-bold rounded-full hover:bg-amber-600 transition-colors text-base"
        id="sponsor-paypal-btn"
      >
        {t("sponsor.donateBtn")}
      </a>
      <p class="text-xs text-body mt-2">donate2mypaws@gmail.com</p>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-100 pt-5">
      <p class="text-sm font-semibold text-slate-dark mb-3 text-center">
        {t("sponsor.formTitle")}
      </p>
      <form id="sponsor-form" data-dog-name={dogName} data-dog-slug={dogSlug} data-lang={lang}>
        <div class="max-w-md mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
            <input
              type="text"
              name="firstName"
              placeholder={t("sponsor.firstName")}
              required
              class="px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal"
            />
            <input
              type="email"
              name="email"
              placeholder={t("sponsor.email")}
              required
              class="px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal"
            />
          </div>
          <div class="grid grid-cols-2 gap-2">
            <select
              name="tier"
              class="px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal/30 focus:border-teal text-body"
            >
              <option value="">{t("sponsor.tierLabel")}</option>
              <option value="month">{t("sponsor.tierMonth")}</option>
              <option value="quarter">{t("sponsor.tierQuarter")}</option>
              <option value="year">{t("sponsor.tierYear")}</option>
              <option value="other">{t("sponsor.tierOther")}</option>
            </select>
            <button
              type="submit"
              class="px-4 py-2.5 bg-teal text-white font-semibold rounded-lg hover:bg-teal/90 transition-colors text-sm"
            >
              {t("sponsor.submit")}
            </button>
          </div>
          <p id="sponsor-msg" class="text-sm text-center mt-3 hidden"></p>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Tier selection highlighting
  const tierBtns = document.querySelectorAll(".sponsor-tier");
  tierBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tierBtns.forEach((b) => {
        b.classList.remove("border-teal", "bg-teal/5");
        b.classList.add("border-gray-200");
      });
      btn.classList.remove("border-gray-200");
      btn.classList.add("border-teal", "bg-teal/5");
      // Update select to match
      const select = document.querySelector('#sponsor-form select[name="tier"]') as HTMLSelectElement;
      if (select && btn instanceof HTMLElement) {
        select.value = btn.dataset.tier || "";
      }
    });
  });

  // Form submission
  const form = document.getElementById("sponsor-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const msg = document.getElementById("sponsor-msg")!;
      const data = new FormData(form);

      btn.disabled = true;
      btn.style.opacity = "0.5";

      try {
        const res = await fetch("/api/sponsor", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            firstName: data.get("firstName"),
            email: data.get("email"),
            tier: data.get("tier"),
            dogName: form.dataset.dogName,
            dogSlug: form.dataset.dogSlug,
            lang: form.dataset.lang,
          }),
        });

        if (res.ok) {
          msg.textContent = msg.dataset.thanks || "Thank you!";
          msg.className = "text-sm text-center mt-3 text-teal font-medium";
          form.reset();
        } else {
          msg.textContent = msg.dataset.error || "Something went wrong.";
          msg.className = "text-sm text-center mt-3 text-red-500";
        }
      } catch {
        msg.textContent = msg.dataset.error || "Something went wrong.";
        msg.className = "text-sm text-center mt-3 text-red-500";
      }

      btn.disabled = false;
      btn.style.opacity = "1";
    });

    const msgEl = document.getElementById("sponsor-msg")!;
    const lang = form.dataset.lang || "en";
    const thanksMap: Record<string, string> = {
      en: "Thank you! We\u2019ll be in touch to say thanks properly.",
      de: "Danke! Wir melden uns, um uns pers\u00f6nlich zu bedanken.",
      nl: "Bedankt! We nemen contact op om je persoonlijk te bedanken.",
      fr: "Merci ! Nous vous contacterons pour vous remercier personnellement.",
    };
    const errorMap: Record<string, string> = {
      en: "Something went wrong. Please try again.",
      de: "Etwas ist schiefgelaufen. Bitte versuche es erneut.",
      nl: "Er is iets misgegaan. Probeer het opnieuw.",
      fr: "Une erreur est survenue. Veuillez r\u00e9essayer.",
    };
    msgEl.dataset.thanks = thanksMap[lang] || thanksMap.en;
    msgEl.dataset.error = errorMap[lang] || errorMap.en;
  }
</script>
