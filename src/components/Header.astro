---
import type { Lang } from "../i18n/utils";
import { useTranslations, localizedPath } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const paypalLink = "https://www.paypal.com/myaccount/transfer/homepage/pay";
const navLinks = [
  { href: localizedPath("/", lang), label: t('nav.home') },
  { href: localizedPath("/about", lang), label: t('nav.about') },
  { href: localizedPath("/adopt", lang), label: t('nav.adopt') },
  { href: localizedPath("/success-stories", lang), label: t('nav.successStories') },
  { href: localizedPath("/donate", lang), label: t('nav.donations') },
  { href: localizedPath("/contact", lang), label: t('nav.contact') },
];

// Build language switcher links: same path but different locale prefix
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(de|nl)/, '') || '/';
const langLinks = [
  { code: 'en' as Lang, label: 'EN', href: pathWithoutLang },
  { code: 'de' as Lang, label: 'DE', href: `/de${pathWithoutLang === '/' ? '' : pathWithoutLang}` },
  { code: 'nl' as Lang, label: 'NL', href: `/nl${pathWithoutLang === '/' ? '' : pathWithoutLang}` },
];
---

<header class="bg-white shadow-sm relative z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={localizedPath("/", lang)} class="flex flex-col leading-tight">
        <span class="text-lg font-bold text-slate-dark">My Paws Bosnia</span>
        <span class="text-sm font-script text-teal -mt-1">Moje Sape</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-slate-dark hover:text-teal transition-colors">
            {link.label}
          </a>
        ))}
        <button
          id="donate-btn"
          type="button"
          class="inline-flex items-center px-5 py-2 text-sm font-semibold text-white bg-teal rounded-full hover:bg-teal/90 transition-colors"
        >
          {t('nav.donate')}
        </button>

        <!-- Language toggle -->
        <div class="flex items-center gap-1 ml-2 text-xs font-medium">
          {langLinks.map((ll, i) => (
            <>
              {i > 0 && <span class="text-gray-300">|</span>}
              <a
                href={ll.href}
                class:list={[
                  "transition-colors",
                  ll.code === lang ? "text-teal font-bold" : "text-slate-dark hover:text-teal",
                ]}
              >
                {ll.label}
              </a>
            </>
          ))}
        </div>
      </nav>

      <!-- Mobile hamburger -->
      <div class="md:hidden">
        <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />
        <label for="mobile-menu-toggle" class="cursor-pointer flex flex-col gap-1.5 p-2">
          <span class="block w-6 h-0.5 bg-slate-dark transition-transform peer-checked:rotate-45 peer-checked:translate-y-2"></span>
          <span class="block w-6 h-0.5 bg-slate-dark transition-opacity peer-checked:opacity-0"></span>
          <span class="block w-6 h-0.5 bg-slate-dark transition-transform peer-checked:-rotate-45 peer-checked:-translate-y-2"></span>
        </label>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg">
    <nav class="flex flex-col px-4 py-4 gap-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium py-2 px-3 rounded-lg transition-colors text-slate-dark hover:bg-light-bg"
        >
          {link.label}
        </a>
      ))}
      <button
        class="donate-btn-mobile text-sm font-semibold py-2 px-3 rounded-full text-white bg-teal text-center"
      >
        {t('nav.donate')}
      </button>

      <!-- Mobile language toggle -->
      <div class="flex items-center gap-2 px-3 pt-2 text-sm font-medium">
        {langLinks.map((ll, i) => (
          <>
            {i > 0 && <span class="text-gray-300">|</span>}
            <a
              href={ll.href}
              class:list={[
                "transition-colors",
                ll.code === lang ? "text-teal font-bold" : "text-slate-dark hover:text-teal",
              ]}
            >
              {ll.label}
            </a>
          </>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle") as HTMLInputElement;
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("change", () => {
      menu.classList.toggle("hidden", !toggle.checked);
    });
  }

  // Donate buttons: copy email then open PayPal
  const email = "donate2mypaws@gmail.com";
  const paypalUrl = "https://www.paypal.com/myaccount/transfer/homepage/pay";

  function handleDonate() {
    navigator.clipboard.writeText(email).then(() => {
      alert("Email copied! PayPal will open now. Paste the email to send your donation.\n\nEmail: " + email);
      window.open(paypalUrl, "_blank");
    }).catch(() => {
      window.open(paypalUrl, "_blank");
    });
  }

  document.getElementById("donate-btn")?.addEventListener("click", handleDonate);
  document.querySelectorAll(".donate-btn-mobile").forEach(btn => {
    btn.addEventListener("click", handleDonate);
  });
</script>
