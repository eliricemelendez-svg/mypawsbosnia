---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { currentDogs } from "../data/current-dogs";
import { useTranslations, localizedPath } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import { getLocalizedDog } from "../utils/dog-i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const dogNames = currentDogs.map((d) => d.name);

// Build photo data for each dog
const allPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/current-dogs/**/*.{jpeg,jpg,png}",
  { eager: true }
);

const dogPhotoData = currentDogs.map((dog) => {
  const prefix = `../assets/current-dogs/${dog.slug}/`;
  const photos = Object.entries(allPhotos)
    .filter(([path]) => path.startsWith(prefix))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
  const shortLine = getLocalizedDog(dog, lang).shortLine;
  return { name: dog.name, slug: dog.slug, shortLine, photos };
});

// Strings needed by client-side JS (can't use t() there)
const jsStrings = JSON.stringify({
  sending: t('apply.sending'),
  submitBtn: t('apply.submitBtn'),
  errorAlert: t('apply.errorAlert'),
  successDog: t('apply.successDog'),
  householdDefault: t('apply.householdDefault'),
  adoptPrefix: localizedPath('/adopt/', lang),
  waMessage: t('apply.waMessage'),
  waMessageGeneric: t('apply.waMessageGeneric'),
});
---

<Layout title={t('apply.pageTitle')} description={t('apply.pageDescription')} lang={lang}>
  <section class="bg-light-bg py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-dark">{t('apply.heading')}</h1>
      <p class="mt-4 text-lg text-body max-w-2xl mx-auto">{t('apply.intro')}</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <form id="adopt-form" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="82e1cf41-2872-4b2a-92e3-8d373b609503" />
      <input type="hidden" name="subject" value="New Adoption Application - My Paws Bosnia" />
      <input type="hidden" name="from_name" value="My Paws Bosnia Adoption Form" />
      <input type="checkbox" name="botcheck" class="hidden" />
      <input type="hidden" id="whatsapp_link" name="WhatsApp Link (click to chat)" value="" />

      <!-- STEP 1: Choose your dog -->
      <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100 mb-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </div>
          <h2 class="text-xl font-semibold text-slate-dark">{t('apply.whoInterested')}</h2>
        </div>

        <!-- Dog selection grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3" id="dog-selector">
          {dogPhotoData.map((dog) => (
            <button
              type="button"
              class="dog-select-btn group relative rounded-xl overflow-hidden border-2 border-gray-100 hover:border-teal transition-all text-left"
              data-dog={dog.name}
              data-slug={dog.slug}
            >
              {dog.photos[0] && (
                <Image
                  src={dog.photos[0]}
                  alt={dog.name}
                  width={300}
                  class="w-full aspect-square object-cover object-top"
                />
              )}
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-3">
                <span class="text-white font-semibold text-sm">{dog.name}</span>
              </div>
            </button>
          ))}
          <button
            type="button"
            class="dog-select-btn flex items-center justify-center rounded-xl border-2 border-gray-100 hover:border-teal transition-all aspect-square bg-light-bg"
            data-dog="Not sure yet"
            data-slug=""
          >
            <div class="text-center p-3">
              <div class="text-3xl mb-2">🐾</div>
              <span class="text-sm text-body font-medium">{t('apply.notSureYet')}</span>
            </div>
          </button>
        </div>

        <!-- Collapsed state (shown after selection) -->
        <div id="dog-selected-bar" class="hidden flex items-center justify-between bg-light-bg rounded-xl p-4">
          <div class="flex items-center gap-3">
            <img id="selected-dog-thumb" src="" alt="" class="w-12 h-12 rounded-full object-cover" />
            <div>
              <p class="font-semibold text-slate-dark" id="selected-dog-name-text"></p>
              <p class="text-xs text-body">{t('apply.selectedForAdoption')}</p>
            </div>
          </div>
          <button type="button" id="change-dog-bar-btn" class="text-sm text-teal font-medium hover:underline">{t('apply.change')}</button>
        </div>

        <input type="hidden" id="dog_interest" name="dog_interest" value="" required />
        <input type="hidden" id="dog_slug" name="dog_slug" value="" />
        <p id="dog-select-error" class="text-red-500 text-sm mt-2 hidden">{t('apply.selectDogError')}</p>
      </div>

      <!-- Photo data for JS -->
      {dogPhotoData.map((dog) => (
        <template data-dog-photos={dog.slug}>
          {dog.photos.map((photo, i) => (
            <img src={photo.src} data-width={photo.width} data-height={photo.height} alt={`${dog.name} photo ${i + 1}`} />
          ))}
        </template>
      ))}
      <script id="dog-info" type="application/json" set:html={JSON.stringify(
        dogPhotoData.map(d => ({ name: d.name, slug: d.slug, shortLine: d.shortLine, photoCount: d.photos.length }))
      )} />
      <script id="apply-i18n" type="application/json" set:html={jsStrings} />

      <!-- TWO-COLUMN LAYOUT: Dog on left, form on right (hidden until dog selected) -->
      <div id="form-fields" class="hidden">
        <div class="flex flex-col lg:flex-row gap-8">

          <!-- LEFT: Dog showcase (sticky on desktop) -->
          <div id="dog-showcase" class="lg:w-5/12">
            <div class="lg:sticky lg:top-24">
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <!-- Photo carousel -->
                <div class="relative">
                  <div class="aspect-square relative overflow-hidden" id="showcase-carousel">
                    <div class="flex h-full transition-transform duration-300 ease-in-out" id="showcase-track">
                      <!-- Photos injected by JS -->
                    </div>
                    <button type="button" id="showcase-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8249;</button>
                    <button type="button" id="showcase-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8250;</button>
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="showcase-dots"></div>
                  </div>
                </div>
                <!-- Dog info -->
                <div class="p-5">
                  <h3 id="showcase-name" class="text-2xl font-bold text-slate-dark"></h3>
                  <p id="showcase-line" class="text-body mt-2 text-sm"></p>
                  <div class="mt-3 flex items-center gap-4">
                    <a id="showcase-profile-link" href="#" class="text-teal font-medium hover:underline text-sm">{t('apply.viewProfile')} &rarr;</a>
                    <button type="button" id="change-dog-btn" class="text-sm text-body hover:text-teal transition-colors underline">{t('apply.changeDog')}</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT: Form fields -->
          <div class="lg:w-7/12 space-y-8">

        <!-- About You -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">{t('apply.aboutYou')}</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-body mb-2">{t('apply.fullName')}</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-body mb-2">{t('apply.email')}</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="country" class="block text-sm font-medium text-body mb-2">{t('apply.country')}</label>
                <select id="country" name="country" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                  <option value="">{t('apply.selectPlaceholder')}</option>
                  <option value="United Kingdom">{t('apply.countryUK')}</option>
                  <option value="Germany">{t('apply.countryGermany')}</option>
                  <option value="Switzerland">{t('apply.countrySwitzerland')}</option>
                  <option value="Netherlands">{t('apply.countryNetherlands')}</option>
                  <option value="Belgium">{t('apply.countryBelgium')}</option>
                  <option value="France">{t('apply.countryFrance')}</option>
                  <option value="Austria">{t('apply.countryAustria')}</option>
                  <option value="Ireland">{t('apply.countryIreland')}</option>
                  <option value="Denmark">{t('apply.countryDenmark')}</option>
                  <option value="Sweden">{t('apply.countrySweden')}</option>
                  <option value="Norway">{t('apply.countryNorway')}</option>
                  <option value="Italy">{t('apply.countryItaly')}</option>
                  <option value="Spain">{t('apply.countrySpain')}</option>
                  <option value="Other">{t('apply.countryOther')}</option>
                </select>
              </div>
              <div>
                <label for="city" class="block text-sm font-medium text-body mb-2">{t('apply.city')}</label>
                <input type="text" id="city" name="city" required list="city-list" autocomplete="address-level2" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
                <datalist id="city-list">
                  <option value="London" /><option value="Manchester" /><option value="Birmingham" /><option value="Leeds" /><option value="Liverpool" /><option value="Bristol" /><option value="Edinburgh" /><option value="Glasgow" /><option value="Cardiff" /><option value="Belfast" />
                  <option value="Berlin" /><option value="Munich" /><option value="Hamburg" /><option value="Frankfurt" /><option value="Cologne" /><option value="Stuttgart" /><option value="Düsseldorf" /><option value="Leipzig" /><option value="Dortmund" /><option value="Dresden" />
                  <option value="Zurich" /><option value="Geneva" /><option value="Basel" /><option value="Bern" /><option value="Lausanne" />
                  <option value="Amsterdam" /><option value="Rotterdam" /><option value="The Hague" /><option value="Utrecht" /><option value="Eindhoven" />
                  <option value="Brussels" /><option value="Antwerp" /><option value="Ghent" /><option value="Bruges" /><option value="Liège" />
                  <option value="Paris" /><option value="Lyon" /><option value="Marseille" /><option value="Toulouse" /><option value="Nice" /><option value="Strasbourg" /><option value="Bordeaux" />
                  <option value="Vienna" /><option value="Graz" /><option value="Salzburg" /><option value="Innsbruck" />
                  <option value="Dublin" /><option value="Cork" /><option value="Galway" />
                  <option value="Copenhagen" /><option value="Stockholm" /><option value="Oslo" /><option value="Milan" /><option value="Rome" /><option value="Madrid" /><option value="Barcelona" />
                </datalist>
              </div>
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-body mb-2">{t('apply.phone')}</label>
              <div class="flex gap-2">
                <input type="text" id="dial-code" name="dial_code" readonly tabindex="-1" value="" class="w-20 rounded-xl border border-gray-200 px-3 py-3 text-base text-slate-dark bg-gray-50 text-center focus:outline-none cursor-default" />
                <input type="tel" id="phone" name="phone" required placeholder="7700 900000" pattern="[\d\s\-\(\)]{6,18}" inputmode="tel" class="flex-1 rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <p class="text-xs text-body mt-1">{t('apply.phoneHint')}</p>
            </div>
          </div>
        </div>

        <!-- Your Home -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">{t('apply.yourHome')}</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="home_type" class="block text-sm font-medium text-body mb-2">{t('apply.homeTypeLabel')}</label>
              <select id="home_type" name="home_type" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="House">{t('apply.homeHouse')}</option>
                <option value="Apartment">{t('apply.homeApartment')}</option>
                <option value="Farm / Rural property">{t('apply.homeFarm')}</option>
                <option value="Other">{t('apply.homeOther')}</option>
              </select>
            </div>
            <div>
              <label for="garden" class="block text-sm font-medium text-body mb-2">{t('apply.gardenLabel')}</label>
              <select id="garden" name="garden" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Yes">{t('apply.yes')}</option>
                <option value="No">{t('apply.no')}</option>
              </select>
            </div>
            <div id="fence-row" class="hidden">
              <label for="fence_height" class="block text-sm font-medium text-body mb-2">{t('apply.fenceLabel')}</label>
              <select id="fence_height" name="fence_height" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Under 1 metre">{t('apply.fenceUnder1')}</option>
                <option value="1 - 1.5 metres">{t('apply.fence1to15')}</option>
                <option value="1.5 - 2 metres">{t('apply.fence15to2')}</option>
                <option value="Over 2 metres">{t('apply.fenceOver2')}</option>
                <option value="Not sure">{t('apply.fenceNotSure')}</option>
              </select>
              <p class="text-xs text-body mt-1">{t('apply.fenceHint')}</p>
            </div>
            <div>
              <label for="own_rent" class="block text-sm font-medium text-body mb-2">{t('apply.ownRentLabel')}</label>
              <select id="own_rent" name="own_rent" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Own">{t('apply.ownRentOwn')}</option>
                <option value="Rent - landlord allows dogs">{t('apply.ownRentAllows')}</option>
                <option value="Rent - need to check with landlord">{t('apply.ownRentCheck')}</option>
              </select>
            </div>
            <div>
              <p class="text-base font-medium text-slate-dark mb-2">{t('apply.householdLabel')}</p>
              <div class="flex flex-wrap gap-2 mb-3" id="household-bubbles">
                <button type="button" data-person="Partner / Spouse" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.householdPartner')}</button>
                <button type="button" data-person="Children" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.householdChildren')}</button>
                <button type="button" data-person="Flatmates" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.householdFlatmates')}</button>
                <button type="button" data-person="Grandparents" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.householdGrandparents')}</button>
                <button type="button" data-person="Other" class="household-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.householdOther')}</button>
              </div>
              <div id="household-counts" class="space-y-3"></div>
              <input type="hidden" id="household_types" name="household" value={t('apply.householdDefault')} />
              <div id="household-children-ages" class="hidden mt-3">
                <label for="children_ages" class="block text-sm font-medium text-body mb-2">{t('apply.childrenAges')}</label>
                <input type="text" id="children_ages" name="children_ages" placeholder={t('apply.childrenAgesPlaceholder')} class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <div class="mt-3">
                <label for="household_extra" class="block text-sm font-medium text-body mb-2">{t('apply.householdExtra')}</label>
                <input type="text" id="household_extra" name="household_extra" placeholder={t('apply.householdExtraPlaceholder')} class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
              <p class="text-xs text-body mt-1">{t('apply.householdHint')}</p>
            </div>
          </div>
        </div>

        <!-- Pets & Experience -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">{t('apply.petsExperience')}</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="dog_experience" class="block text-sm font-medium text-body mb-2">{t('apply.dogExperienceLabel')}</label>
              <select id="dog_experience" name="dog_experience" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Yes">{t('apply.dogExperienceYes')}</option>
                <option value="No, first time">{t('apply.dogExperienceNo')}</option>
              </select>
              <p class="text-xs text-body mt-1">{t('apply.dogExperienceHint')}</p>
            </div>
            <div id="rescue-row" class="hidden">
              <label for="was_rescue" class="block text-sm font-medium text-body mb-2">{t('apply.wasRescueLabel')}</label>
              <select id="was_rescue" name="was_rescue" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Yes">{t('apply.yes')}</option>
                <option value="No">{t('apply.no')}</option>
              </select>
            </div>
            <div>
              <label for="daily_routine" class="block text-sm font-medium text-body mb-2">{t('apply.dailyRoutineLabel')}</label>
              <select id="daily_routine" name="daily_routine" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Work from home">{t('apply.routineWFH')}</option>
                <option value="Work outside (full-time)">{t('apply.routineFullTime')}</option>
                <option value="Work outside (part-time)">{t('apply.routinePartTime')}</option>
                <option value="Retired">{t('apply.routineRetired')}</option>
                <option value="Student">{t('apply.routineStudent')}</option>
                <option value="Stay-at-home parent">{t('apply.routineStayHome')}</option>
                <option value="Other">{t('apply.routineOther')}</option>
              </select>
            </div>
            <div>
              <label for="has_pets" class="block text-sm font-medium text-body mb-2">{t('apply.hasPetsLabel')}</label>
              <select id="has_pets" name="has_pets" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Yes">{t('apply.yes')}</option>
                <option value="No">{t('apply.no')}</option>
              </select>
            </div>
            <div id="pets-detail" class="hidden space-y-4">
              <div>
                <p class="text-base font-medium text-slate-dark mb-2">{t('apply.whatPets')}</p>
                <div class="flex flex-wrap gap-2" id="pet-bubbles">
                  <button type="button" data-pet="Dogs" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.petDogs')}</button>
                  <button type="button" data-pet="Cats" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.petCats')}</button>
                  <button type="button" data-pet="Rabbits" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.petRabbits')}</button>
                  <button type="button" data-pet="Birds" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.petBirds')}</button>
                  <button type="button" data-pet="Fish" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.petFish')}</button>
                  <button type="button" data-pet="Other" class="pet-bubble px-4 py-2 rounded-full border border-gray-200 text-base text-body hover:border-teal hover:text-teal transition-colors">{t('apply.petOther')}</button>
                </div>
                <input type="hidden" id="pet_types" name="pet_types" />
              </div>
              <div id="pet-counts" class="space-y-3"></div>
              <div>
                <label for="pets_extra" class="block text-sm font-medium text-body mb-2">{t('apply.petsExtraLabel')}</label>
                <input type="text" id="pets_extra" name="pets_extra" placeholder={t('apply.petsExtraPlaceholder')} class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
              </div>
            </div>
          </div>
        </div>

        <!-- Final details -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-teal/10 rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-dark">{t('apply.moreDetails')}</h2>
          </div>
          <div class="space-y-6">
            <div>
              <label for="hours_alone" class="block text-sm font-medium text-body mb-2">{t('apply.hoursAloneLabel')}</label>
              <select id="hours_alone" name="hours_alone" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="0-2 hours">{t('apply.hours02')}</option>
                <option value="2-4 hours">{t('apply.hours24')}</option>
                <option value="4-6 hours">{t('apply.hours46')}</option>
                <option value="6-8 hours">{t('apply.hours68')}</option>
                <option value="8+ hours">{t('apply.hours8plus')}</option>
              </select>
            </div>
            <div>
              <label for="sleep" class="block text-sm font-medium text-body mb-2">{t('apply.sleepLabel')}</label>
              <input type="text" id="sleep" name="sleep" placeholder={t('apply.sleepPlaceholder')} class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent" />
            </div>
            <div>
              <label for="home_check" class="block text-sm font-medium text-body mb-2">{t('apply.homeCheckLabel')}</label>
              <select id="home_check" name="home_check" required class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark bg-white focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent">
                <option value="">{t('apply.selectPlaceholder')}</option>
                <option value="Yes">{t('apply.yes')}</option>
                <option value="No">{t('apply.no')}</option>
              </select>
              <p class="text-xs text-body mt-1">{t('apply.homeCheckHint')}</p>
            </div>
            <div>
              <label for="questions" class="block text-sm font-medium text-body mb-2">{t('apply.questionsLabel')}</label>
              <textarea id="questions" name="questions" rows="3" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent resize-y"></textarea>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-body mb-2">{t('apply.messageLabel')}</label>
              <textarea id="message" name="message" rows="3" placeholder={t('apply.messagePlaceholder')} class="w-full rounded-xl border border-gray-200 px-4 py-3 text-base text-slate-dark focus:outline-none focus:ring-2 focus:ring-teal focus:border-transparent resize-y"></textarea>
            </div>
          </div>
        </div>

        <!-- Success stories -->
        <div class="bg-light-bg rounded-2xl p-6 text-center">
          <p class="text-body mb-2">{t('apply.successStories')}</p>
          <a href={localizedPath('/success-stories', lang)} class="text-teal font-medium hover:underline">{t('apply.seeStories')} &rarr;</a>
        </div>

        <!-- Privacy consent -->
        <div class="flex items-start gap-3 mb-6">
          <input type="checkbox" id="privacy_consent" name="privacy_consent" required class="mt-1 w-4 h-4 rounded border-gray-300 text-teal focus:ring-teal" />
          <label for="privacy_consent" class="text-sm text-body">{t('apply.privacyConsent')} <a href={localizedPath('/privacy', lang)} class="text-teal hover:underline">{t('apply.privacyPolicy')}</a>{t('apply.privacySuffix')}</label>
        </div>

        <!-- Submit -->
        <div class="text-center pt-2">
          <button type="submit" id="submit-btn" class="inline-block px-10 py-3.5 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors text-base shadow-md hover:shadow-lg">{t('apply.submitBtn')}</button>
          <p class="text-xs text-body mt-3">{t('apply.submitHint')}</p>
        </div>

        <!-- FAQ -->
        <div class="bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-gray-100">
          <h2 class="text-xl font-semibold text-slate-dark mb-4">{t('apply.faqTitle')}</h2>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">{t('apply.faq1q')}</summary>
            <p class="pb-4 text-body text-sm">{t('apply.faq1a')}</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">{t('apply.faq2q')}</summary>
            <p class="pb-4 text-body text-sm">{t('apply.faq2a')}</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">{t('apply.faq3q')}</summary>
            <p class="pb-4 text-body text-sm">{t('apply.faq3a')}</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">{t('apply.faq4q')}</summary>
            <p class="pb-4 text-body text-sm">{t('apply.faq4a')}</p>
          </details>
          <details class="border-b border-gray-100">
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">{t('apply.faq5q')}</summary>
            <p class="pb-4 text-body text-sm" set:html={t('apply.faq5a')} />
          </details>
          <details>
            <summary class="py-4 cursor-pointer text-base font-medium text-slate-dark hover:text-teal">{t('apply.faq6q')}</summary>
            <p class="pb-4 text-body text-sm">{t('apply.faq6a')}</p>
          </details>
        </div>

          </div><!-- end right column -->
        </div><!-- end flex row -->
      </div><!-- end form-fields -->
    </form>

    <!-- Success message -->
    <div id="success-msg" class="hidden py-16">
      <div class="bg-white rounded-2xl p-8 md:p-12 shadow-sm border border-gray-100 text-center">
        <div class="text-5xl mb-4">🐾</div>
        <h2 class="text-2xl font-bold text-slate-dark mb-2">{t('apply.successTitle')}</h2>
        <p class="text-lg text-body mb-6" id="success-dog-text">{t('apply.successGeneric')}</p>

        <!-- Dog photos on success screen -->
        <div id="success-photos" class="hidden mb-8">
          <div class="relative rounded-2xl overflow-hidden max-w-md mx-auto">
            <div class="aspect-square relative overflow-hidden" id="success-carousel">
              <div class="flex h-full transition-transform duration-300 ease-in-out" id="success-track"></div>
              <button type="button" id="success-prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8249;</button>
              <button type="button" id="success-next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-10 h-10 flex items-center justify-center shadow text-slate-700 text-xl z-10">&#8250;</button>
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 z-10" id="success-dots"></div>
            </div>
          </div>
        </div>

        <div class="bg-light-bg rounded-xl p-6 mb-8 text-left max-w-md mx-auto">
          <h3 class="font-semibold text-slate-dark mb-3 text-center">{t('apply.whatsNext')}</h3>
          <ol class="space-y-3 text-sm text-body">
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">1</span>
              <span set:html={t('apply.step1')} />
            </li>
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">2</span>
              <span set:html={t('apply.step2')} />
            </li>
            <li class="flex gap-3">
              <span class="w-6 h-6 bg-teal text-white rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold">3</span>
              <span set:html={t('apply.step3')} />
            </li>
          </ol>
        </div>

        <p class="text-body mb-6">{t('apply.cantWait')}</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://wa.me/38765628636" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-green-500 text-white font-semibold rounded-full hover:bg-green-600 transition-colors">{t('apply.whatsappBtn')}</a>
          <a href="https://www.facebook.com/profile.php?id=61590021437450" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-teal text-white font-semibold rounded-full hover:bg-teal/90 transition-colors">{t('apply.facebookBtn')}</a>
        </div>
        <div class="mt-8">
          <a href={localizedPath('/adopt', lang)} class="text-teal font-medium hover:underline">&larr; {t('apply.backToAll')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { CarouselController } from '../utils/carousel';
  import { BubbleSelector } from '../utils/bubble-selector';

  // Load i18n strings for client-side JS
  const i18nEl = document.getElementById('apply-i18n');
  const i18n = i18nEl ? JSON.parse(i18nEl.textContent || '{}') : {};
  const dogInfoEl = document.getElementById('dog-info');
  const dogInfo = dogInfoEl ? JSON.parse(dogInfoEl.textContent || '[]') : [];

  // DOM elements
  const dogBtns = document.querySelectorAll<HTMLButtonElement>('.dog-select-btn');
  const dogInput = document.getElementById('dog_interest') as HTMLInputElement;
  const dogSlugInput = document.getElementById('dog_slug') as HTMLInputElement;
  const dogShowcase = document.getElementById('dog-showcase');
  const dogSelector = document.getElementById('dog-selector');
  const dogSelectedBar = document.getElementById('dog-selected-bar');
  const selectedDogThumb = document.getElementById('selected-dog-thumb') as HTMLImageElement;
  const selectedDogNameText = document.getElementById('selected-dog-name-text');
  const formFields = document.getElementById('form-fields');
  const showcaseName = document.getElementById('showcase-name');
  const showcaseLine = document.getElementById('showcase-line');
  const showcaseLink = document.getElementById('showcase-profile-link') as HTMLAnchorElement;
  const dogError = document.getElementById('dog-select-error');

  // Showcase carousel (reusable controller)
  const showcaseTrack = document.getElementById('showcase-track');
  const showcaseCarousel = showcaseTrack
    ? new CarouselController(showcaseTrack, document.getElementById('showcase-dots'), 4000)
    : null;

  showcaseCarousel?.attachControls(
    document.getElementById('showcase-prev'),
    document.getElementById('showcase-next'),
    document.getElementById('showcase-carousel'),
  );

  // Household bubble selector
  const householdSelector = new BubbleSelector(
    document.querySelectorAll<HTMLButtonElement>('.household-bubble'),
    document.getElementById('household-counts'),
    document.getElementById('household_types') as HTMLInputElement,
    'person',
    i18n.householdDefault,
    (selected) => {
      document.getElementById('household-children-ages')?.classList.toggle('hidden', !selected.has('Children'));
    },
  );

  // Pet bubble selector
  const petSelector = new BubbleSelector(
    document.querySelectorAll<HTMLButtonElement>('.pet-bubble'),
    document.getElementById('pet-counts'),
    document.getElementById('pet_types') as HTMLInputElement,
    'pet',
  );

  // Helper to get photos from template elements
  function getPhotosFromTemplate(slug: string): { src: string; alt: string }[] {
    const template = document.querySelector(`template[data-dog-photos="${slug}"]`);
    if (!template) return [];
    return Array.from(template.content.querySelectorAll('img')).map((img) => ({
      src: img.getAttribute('src') || '',
      alt: img.getAttribute('alt') || '',
    }));
  }

  function selectDog(name: string, slug: string) {
    dogInput.value = name;
    if (dogSlugInput) dogSlugInput.value = slug;
    dogError?.classList.add('hidden');
    dogSelector?.classList.add('hidden');

    // Show selected bar with thumbnail
    const photos = getPhotosFromTemplate(slug);
    if (selectedDogThumb && photos.length > 0 && name !== 'Not sure yet') {
      selectedDogThumb.src = photos[0].src;
      selectedDogThumb.alt = name;
      selectedDogThumb.classList.remove('hidden');
    } else if (selectedDogThumb) {
      selectedDogThumb.classList.add('hidden');
    }
    if (selectedDogNameText) selectedDogNameText.textContent = name;
    dogSelectedBar?.classList.remove('hidden');

    if (name === 'Not sure yet') {
      dogShowcase?.classList.add('hidden');
      formFields?.classList.remove('hidden');
      formFields?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }

    // Load carousel
    if (showcaseCarousel && photos.length > 0) {
      showcaseCarousel.loadImages(photos);
    }

    const info = dogInfo.find((d: any) => d.slug === slug);
    if (showcaseName) showcaseName.textContent = name;
    if (showcaseLine && info) showcaseLine.textContent = info.shortLine;
    if (showcaseLink && info) showcaseLink.href = `${i18n.adoptPrefix}${info.slug}`;

    dogShowcase?.classList.remove('hidden');
    formFields?.classList.remove('hidden');
    dogShowcase?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  dogBtns.forEach((btn) => {
    btn.addEventListener('click', () => selectDog(btn.dataset.dog!, btn.dataset.slug!));
  });

  function resetDogSelection() {
    showcaseCarousel?.stopAutoplay();
    dogShowcase?.classList.add('hidden');
    formFields?.classList.add('hidden');
    dogSelectedBar?.classList.add('hidden');
    dogSelector?.classList.remove('hidden');
    dogInput.value = '';
    dogBtns.forEach((btn) => {
      btn.classList.remove('border-teal', 'ring-2', 'ring-teal');
      btn.classList.add('border-gray-100');
    });
    dogSelector?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.getElementById('change-dog-btn')?.addEventListener('click', resetDogSelection);
  document.getElementById('change-dog-bar-btn')?.addEventListener('click', resetDogSelection);

  // Pre-select from URL param (?dog=slug) or path (/apply/slug)
  const dogParam = new URLSearchParams(window.location.search).get('dog')
    || window.location.pathname.replace(/\/$/, '').split('/').pop();
  if (dogParam && dogParam !== 'apply') {
    const lc = dogParam.toLowerCase();
    const match = dogInfo.find((d: any) => d.name.toLowerCase() === lc || d.slug.toLowerCase() === lc);
    if (match) selectDog(match.name, match.slug);
  }

  // Conditional field visibility
  const gardenSelect = document.getElementById('garden') as HTMLSelectElement;
  const fenceRow = document.getElementById('fence-row');
  gardenSelect?.addEventListener('change', () => {
    const isYes = gardenSelect.value === 'Yes';
    fenceRow?.classList.toggle('hidden', !isYes);
    if (!isYes) (document.getElementById('fence_height') as HTMLSelectElement).value = '';
  });

  const dogExpSelect = document.getElementById('dog_experience') as HTMLSelectElement;
  const rescueRow = document.getElementById('rescue-row');
  dogExpSelect?.addEventListener('change', () => {
    const isYes = dogExpSelect.value === 'Yes';
    rescueRow?.classList.toggle('hidden', !isYes);
    if (!isYes) (document.getElementById('was_rescue') as HTMLSelectElement).value = '';
  });

  const hasPetsSelect = document.getElementById('has_pets') as HTMLSelectElement;
  const petsDetail = document.getElementById('pets-detail');
  hasPetsSelect?.addEventListener('change', () => {
    const isYes = hasPetsSelect.value === 'Yes';
    petsDetail?.classList.toggle('hidden', !isYes);
    if (!isYes) petSelector.clear();
  });

  // Auto-fill dial code from country
  const countryDialCodes: Record<string, string> = {
    'United Kingdom': '+44', 'Germany': '+49', 'Switzerland': '+41',
    'Netherlands': '+31', 'Belgium': '+32', 'France': '+33',
    'Austria': '+43', 'Ireland': '+353', 'Denmark': '+45',
    'Sweden': '+46', 'Norway': '+47', 'Italy': '+39', 'Spain': '+34',
  };
  const countrySelect = document.getElementById('country') as HTMLSelectElement;
  const dialCodeInput = document.getElementById('dial-code') as HTMLInputElement;
  countrySelect?.addEventListener('change', () => {
    const code = countryDialCodes[countrySelect.value] || '';
    dialCodeInput.value = code;
    dialCodeInput.readOnly = countrySelect.value !== 'Other';
    if (countrySelect.value === 'Other') {
      dialCodeInput.classList.remove('bg-gray-50', 'cursor-default');
      dialCodeInput.classList.add('bg-white');
      dialCodeInput.placeholder = '+__';
    } else {
      dialCodeInput.classList.add('bg-gray-50', 'cursor-default');
      dialCodeInput.classList.remove('bg-white');
      dialCodeInput.placeholder = '';
    }
  });

  // Form submission
  const form = document.getElementById('adopt-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form && successMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!dogInput.value) {
        dogError?.classList.remove('hidden');
        dogSelector?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = i18n.sending;

      // Build WhatsApp click-to-chat link
      const dialCode = dialCodeInput?.value || '';
      const phoneRaw = (document.getElementById('phone') as HTMLInputElement)?.value || '';
      const phoneInput = dialCode + ' ' + phoneRaw;
      let cleanPhone = (dialCode + phoneRaw).replace(/[\s\-\(\)\+]/g, '');
      if (dialCode && cleanPhone.startsWith(dialCode.replace('+', '')) && phoneRaw.replace(/[\s\-\(\)]/g, '').startsWith('0')) {
        cleanPhone = dialCode.replace('+', '') + phoneRaw.replace(/[\s\-\(\)]/g, '').slice(1);
      }
      const applicantName = (document.getElementById('name') as HTMLInputElement)?.value || '';
      const selectedDogName = dogInput.value;
      const selectedDogSlug = dogSlugInput?.value || '';
      const waMsg = selectedDogName && selectedDogName !== 'Not sure yet'
        ? i18n.waMessage.replace('{name}', applicantName).replace('{dog}', selectedDogName)
        : i18n.waMessageGeneric.replace('{name}', applicantName);
      const waLink = document.getElementById('whatsapp_link') as HTMLInputElement;
      if (waLink && cleanPhone) waLink.value = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(waMsg)}`;

      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error('Failed');

        // Fire-and-forget confirmation email
        fetch('/api/confirm-application', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: applicantName,
            email: (document.getElementById('email') as HTMLInputElement)?.value || '',
            phone: phoneInput,
            dogName: selectedDogName, dogSlug: selectedDogSlug,
            country: countrySelect?.value || '',
            city: (document.getElementById('city') as HTMLInputElement)?.value || '',
            homeType: (document.getElementById('home_type') as HTMLSelectElement)?.value || '',
            garden: gardenSelect?.value || '',
            fence: (document.getElementById('fence_height') as HTMLSelectElement)?.value || '',
            ownRent: (document.getElementById('own_rent') as HTMLSelectElement)?.value || '',
            household: (document.getElementById('household_types') as HTMLInputElement)?.value || '',
            dogExperience: dogExpSelect?.value || '',
            wasRescue: (document.getElementById('was_rescue') as HTMLSelectElement)?.value || '',
            dailyRoutine: (document.getElementById('daily_routine') as HTMLSelectElement)?.value || '',
            pets: (document.getElementById('pet_types') as HTMLInputElement)?.value || '',
            hoursAlone: (document.getElementById('hours_alone') as HTMLSelectElement)?.value || '',
            sleep: (document.getElementById('sleep') as HTMLInputElement)?.value || '',
            homeCheck: (document.getElementById('home_check') as HTMLSelectElement)?.value || '',
            questions: (document.getElementById('questions') as HTMLTextAreaElement)?.value || '',
            message: (document.getElementById('message') as HTMLTextAreaElement)?.value || '',
            lang: document.documentElement.lang || 'en',
          }),
        }).catch(() => {});

        // Success screen
        if (selectedDogName && selectedDogName !== 'Not sure yet') {
          const successText = document.getElementById('success-dog-text');
          if (successText) successText.textContent = i18n.successDog.replace('{name}', selectedDogName);

          // Success carousel
          const successTrack = document.getElementById('success-track');
          if (successTrack) {
            const successCarousel = new CarouselController(successTrack, document.getElementById('success-dots'));
            successCarousel.attachControls(
              document.getElementById('success-prev'),
              document.getElementById('success-next'),
              null,
            );
            const photos = getPhotosFromTemplate(selectedDogSlug);
            if (photos.length > 0) {
              successCarousel.loadImages(photos);
              document.getElementById('success-photos')?.classList.remove('hidden');
            }
          }
        }
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch {
        submitBtn.disabled = false;
        submitBtn.textContent = i18n.submitBtn;
        alert(i18n.errorAlert);
      }
    });
  }
</script>
