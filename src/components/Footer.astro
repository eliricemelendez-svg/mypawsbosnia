---
import type { Lang } from "../i18n/utils";
import { useTranslations, localizedPath } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-dark text-white/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">{t('footer.quickLinks')}</h3>
        <ul class="space-y-2">
          <li><a href={localizedPath("/", lang)} class="hover:text-teal transition-colors">{t('nav.home')}</a></li>
          <li><a href={localizedPath("/about", lang)} class="hover:text-teal transition-colors">{t('nav.about')}</a></li>
          <li><a href={localizedPath("/adopt", lang)} class="hover:text-teal transition-colors">{t('nav.adopt')}</a></li>
          <li><a href={localizedPath("/past-rescues", lang)} class="hover:text-teal transition-colors">{t('footer.pastRescues')}</a></li>
          <li><a href={localizedPath("/your-impact", lang)} class="hover:text-teal transition-colors">{t('footer.yourImpact')}</a></li>
          <li><a href={localizedPath("/donate", lang)} class="hover:text-teal transition-colors">{t('nav.donate')}</a></li>
          <li><a href={localizedPath("/contact", lang)} class="hover:text-teal transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">{t('footer.connect')}</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="https://www.facebook.com/profile.php?id=61590021437450"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-teal transition-colors"
            >
              Facebook
            </a>
          </li>
          <li>
            <a href="mailto:donate2mypaws@gmail.com" class="hover:text-teal transition-colors">
              donate2mypaws@gmail.com
            </a>
          </li>
        </ul>
        <div class="mt-4">
          <p class="text-sm text-white/60">{t('footer.paypalDonations')}</p>
          <p class="text-sm text-white">donate2mypaws@gmail.com</p>
        </div>
      </div>

      <!-- Location -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">{t('footer.location')}</h3>
        <p>{t('footer.locationText')}</p>
      </div>
    </div>

    <div class="border-t border-white/10 mt-10 pt-6 text-center text-sm text-white/50">
      <p>&copy; {currentYear} {t('footer.rights')}</p>
    </div>
  </div>
</footer>
