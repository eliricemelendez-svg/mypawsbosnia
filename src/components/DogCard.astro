---
import { Image } from "astro:assets";

interface Props {
  slug: string;
  name: string;
  shortLine: string;
  sex: "male" | "female";
  age: "puppy" | "young" | "adult" | "senior";
  size: "small" | "medium" | "large";
  linkPrefix: string;
  adoptedTo?: string;
}

const { slug, name, shortLine, sex, age, size, linkPrefix, adoptedTo } = Astro.props;

const pillColors: Record<string, string> = {
  male: "bg-blue-100 text-blue-700",
  female: "bg-pink-100 text-pink-700",
  puppy: "bg-amber-100 text-amber-700",
  young: "bg-green-100 text-green-700",
  adult: "bg-slate-100 text-slate-700",
  senior: "bg-purple-100 text-purple-700",
  small: "bg-teal/10 text-teal",
  medium: "bg-teal/10 text-teal",
  large: "bg-teal/10 text-teal",
};

// Load lead photo (first alphabetically from the dog's folder)
const allCurrentPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/current-dogs/**/*.{jpeg,jpg,png}",
  { eager: true }
);
const allPastPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/past-rescues/**/*.{jpeg,jpg,png}",
  { eager: true }
);
const allSuccessPhotos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/success-stories/**/*.{jpeg,jpg,png}",
  { eager: true }
);

const allPhotos = { ...allCurrentPhotos, ...allPastPhotos, ...allSuccessPhotos };
const prefixMap: Record<string, string> = {
  "/adopt": `../assets/current-dogs/${slug}/`,
  "/success-stories": `../assets/success-stories/${slug}/`,
};
const prefix = prefixMap[linkPrefix] ?? `../assets/past-rescues/${slug}/`;

const dogPhotos = Object.entries(allPhotos)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b));

const photos = dogPhotos.map(([, mod]) => mod.default);
const leadPhoto = photos[0] ?? null;
---

<a
  href={`${linkPrefix}/${slug}`}
  class="group block bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden"
  data-sex={sex}
  data-age={age}
  data-size={size}
>
  <div class="bg-gray-50 relative overflow-hidden">
    {photos.length > 1 ? (
      <div class="card-carousel relative" data-card-carousel>
        <div class="flex transition-transform duration-300 ease-in-out" data-carousel-track>
          {photos.map((photo, i) => (
            <div class="w-full flex-shrink-0">
              <Image
                src={photo}
                alt={`${name} photo ${i + 1}`}
                width={600}
                class="w-full"
              />
            </div>
          ))}
        </div>
        <button type="button" data-carousel-prev class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-8 h-8 flex items-center justify-center shadow text-slate-700 opacity-0 group-hover:opacity-100 transition-opacity z-10" aria-label="Previous photo" onclick="event.preventDefault(); event.stopPropagation();">&#8249;</button>
        <button type="button" data-carousel-next class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-8 h-8 flex items-center justify-center shadow text-slate-700 opacity-0 group-hover:opacity-100 transition-opacity z-10" aria-label="Next photo" onclick="event.preventDefault(); event.stopPropagation();">&#8250;</button>
        <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 z-10" data-carousel-dots>
          {photos.map((_, i) => (
            <span class={`block w-2 h-2 rounded-full ${i === 0 ? 'bg-white' : 'bg-white/50'} transition-colors`} />
          ))}
        </div>
      </div>
    ) : leadPhoto ? (
      <Image
        src={leadPhoto}
        alt={`${name}, a rescue dog available for adoption from Bosnia`}
        width={600}
        class="w-full"
      />
    ) : (
      <div class="aspect-[4/3] bg-gray-100 flex items-center justify-center text-6xl">
        🐕
      </div>
    )}
  </div>

  <div class="p-5">
    <h3 class="text-lg font-semibold text-slate-dark group-hover:text-teal transition-colors">
      {name}
    </h3>
    <p class="text-sm text-body mt-1">{shortLine}</p>

    {adoptedTo && (
      <p class="text-sm text-teal font-medium mt-2">Adopted to: {adoptedTo}</p>
    )}

    <div class="flex flex-wrap gap-2 mt-3">
      <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${pillColors[sex]}`}>
        {sex}
      </span>
      <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${pillColors[age]}`}>
        {age}
      </span>
      <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${pillColors[size]}`}>
        {size}
      </span>
    </div>
  </div>
</a>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-card-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('[data-carousel-track]') as HTMLElement;
      const dots = carousel.querySelectorAll('[data-carousel-dots] span');
      const prev = carousel.querySelector('[data-carousel-prev]') as HTMLElement;
      const next = carousel.querySelector('[data-carousel-next]') as HTMLElement;
      const count = dots.length;
      let current = 0;

      function goTo(i: number) {
        current = (i + count) % count;
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, idx) => {
          d.className = `block w-2 h-2 rounded-full ${idx === current ? 'bg-white' : 'bg-white/50'} transition-colors`;
        });
      }

      prev?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); goTo(current - 1); });
      next?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); goTo(current + 1); });

      // Touch swipe
      let startX = 0;
      carousel.addEventListener('touchstart', (e: Event) => { startX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
      carousel.addEventListener('touchend', (e: Event) => {
        const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
        if (Math.abs(diff) > 50) { e.preventDefault(); goTo(current + (diff > 0 ? 1 : -1)); }
      });
    });
  });
</script>
