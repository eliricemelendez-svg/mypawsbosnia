---
interface Photo {
  src: string;
  caption: string;
  date: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

{photos.length > 0 ? (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {photos.map((photo) => (
      <div class="relative rounded-2xl overflow-hidden shadow-sm group">
        <img
          src={photo.src}
          alt={photo.caption}
          class="w-full aspect-[4/3] object-cover"
          loading="lazy"
        />
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 to-transparent p-4">
          <p class="text-white text-sm font-medium">{photo.caption}</p>
          <p class="text-white/70 text-xs mt-1">{photo.date}</p>
        </div>
      </div>
    ))}
  </div>
) : (
  <div class="bg-light-bg rounded-2xl p-12 text-center">
    <div class="text-4xl mb-3">📷</div>
    <p class="text-body font-medium">Photos coming soon</p>
    <p class="text-sm text-body/60 mt-1">We will be adding photos here as they become available.</p>
  </div>
)}
