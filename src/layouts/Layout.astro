---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Rescuing and rehoming dogs in Bosnia since 2019", ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://mypawsbosnia.org");
const ogImageURL = ogImage ? new URL(ogImage, Astro.site ?? "https://mypawsbosnia.org").href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="font-sans text-body bg-white min-h-screen flex flex-col">
    <Header />
    <!-- Floating donate button -->
    <button
      class="donate-urgent fixed bottom-6 right-6 z-[60] bg-teal text-white font-semibold px-6 py-3 rounded-full shadow-lg hover:bg-teal/90 hover:shadow-xl transition-all text-sm"
    >
      Donate
    </button>
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      document.querySelectorAll(".donate-urgent").forEach(btn => {
        btn.addEventListener("click", () => {
          const email = "donate2mypaws@gmail.com";
          navigator.clipboard.writeText(email).then(() => {
            alert("Email copied! PayPal will open now. Paste the email to send your donation.\n\nEmail: " + email);
            window.open("https://www.paypal.com/myaccount/transfer/homepage/pay", "_blank");
          }).catch(() => {
            window.open("https://www.paypal.com/myaccount/transfer/homepage/pay", "_blank");
          });
        });
      });
    </script>
  </body>
</html>
