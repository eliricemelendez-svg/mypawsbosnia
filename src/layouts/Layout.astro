---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Rescuing and rehoming dogs in Bosnia since 2019", ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://mypawsbosnia.org");
const ogImageURL = ogImage ? new URL(ogImage, Astro.site ?? "https://mypawsbosnia.org").href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
  </head>
  <body class="font-sans text-body bg-white min-h-screen flex flex-col">
    <!-- Urgent banner — shows on every page, stays on scroll -->
    <div class="bg-red-600 text-white text-center py-2.5 px-4 sticky top-0 z-[60]">
      <p class="text-sm font-semibold">
        🚨 Our dogs are hungry. We have run out of food and need your help now.
        <button class="donate-urgent ml-2 underline font-bold hover:text-red-100">Donate</button>
      </p>
    </div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      document.querySelectorAll(".donate-urgent").forEach(btn => {
        btn.addEventListener("click", () => {
          const email = "donate2mypaws@gmail.com";
          navigator.clipboard.writeText(email).then(() => {
            alert("Email copied! PayPal will open now. Paste the email to send your donation.\n\nEmail: " + email);
            window.open("https://www.paypal.com/myaccount/transfer/homepage/pay", "_blank");
          }).catch(() => {
            window.open("https://www.paypal.com/myaccount/transfer/homepage/pay", "_blank");
          });
        });
      });
    </script>
  </body>
</html>
